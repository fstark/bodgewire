@007D F0 08     ; C07D          beq @skip
@007F 98        ; C07F  @print: tya
@0080 20 03 E0  ; C080          jsr EDPRINT
@0083 A9 01     ; C083          lda #1
@0085 85 32     ; C085          sta NZ
@0087 E8        ; C087  @skip:  inx
@0088 E0 04     ; C088          cpx #4
@008A D0 D1     ; C08A          bne @power
@008C A5 30     ; C08C          lda NUM
@008E 09 30     ; C08E          ora #'0'
@0090 4C 03 E0  ; C090          jmp EDPRINT

@0093 10 E8 64 0A  ; C093  powlo:  .byte <10000, <1000, <100, <10
@0097 27 03 00 00  ; C097  powhi:  .byte >10000, >1000, >100, >10


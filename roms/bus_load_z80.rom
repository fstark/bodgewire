; Bus load ROM for the real Z80 (2716), docs/p5s-z80/Z80_DESIGN.md. Generated by
; roms/make_bus_load_z80_rom.py: do not edit, rerun the script.
; 0x000-0x04A code; 0x100-0x425 the RAM image copied to $4000 (6 HALTs, the page, 8
; HALTs); 0x600-0x7FF the P5a glyphs (address 0x600 + code x 8 + line).
; Lines of 207 T-states; the line across VSYNC 1863; 312 lines a frame.

@000
F3       ; DI (4)
31 00 44 ; LD SP,$4400 (10)
ED 56    ; IM 1 (8)
3E 0E    ; LD A,$0E (7)
ED 47    ; LD I,A: refresh A9, A10 high, the glyphs at $0600 (9)
21 00 01 ; LD HL,image (10)
11 00 40 ; LD DE,$4000 (10)
01 26 03 ; LD BC,806 (10)
ED B0    ; LDIR (21/16)
DB FE    ; frame: IN A,($FE): VSYNC on (11)
06 78    ; LD B,120 (7)
10 FE    ; DJNZ $ (13/8)
1E 00    ; LD E,0: padding (7)
1E 00    ; LD E,0: padding (7)
00       ; NOP: padding (4)
D3 FE    ; OUT ($FE),A: VSYNC off (11)
21 00 C0 ; LD HL,$C000: the first top-border HALT (10)
01 08 26 ; LD BC: B rows, C lines (10)
3E 5D    ; LD A,$5D (7)
CD 41 00 ; CALL tail: the frame's lines (17)
18 E6    ; JR frame (12)
@038
0D       ; DEC C: lines left in the row (4)
C2 45 00 ; JP NZ,same (10)
E1       ; POP HL: the next row (10)
05       ; DEC B (4)
C8       ; RET Z: the frame done, back to frame's JR (11/5)
CB D9    ; SET 3,C: 8 lines (8)
ED 4F    ; tail: LD R,A (9)
FB       ; EI (4)
E9       ; JP (HL) (4)
D1       ; same: POP DE: the pushed PC dropped (10)
C8       ; RET Z: never taken (Z clear), 5 T-states (11/5)
18 F8    ; JR tail (12)


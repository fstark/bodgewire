; Generated by bw asm from bw2001_edit.asm: do not edit. Edit the .asm and run bw asm again.
; ; BW-2001 editor (docs/p5p-bw2001-firmware/BW2001_FIRMWARE.md, "The editor"; design §5): the
; ; PET 2001's $E000 socket (UH3). A full-screen editor on the 40 x 25 screen at $8000: the cursor
; ; goes anywhere, RETURN hands the logical line under it to BASIC (one row, or two joined), the
; ; keyboard read at each retrace (PIA1, the PET 2001's matrix), STOP the break key. It keeps the
; ; P5o editor contract (docs/p5o-tiny-basic/TINY_BASIC.md, "The editor contract").
; ;
; ; Entry points at $E000 (roms/bw2001.inc); the key table KEYTAB at $E700; the checksum at $E7FF.
; ; Zero page $40-$5F.

;         .rom $E000, $800
;         .include "bw2001.inc"
; ; BW-2001 firmware, shared by its three ROMs (docs/p5p-bw2001-firmware/BW2001_FIRMWARE_DESIGN.md
; ; §3): the I/O, the RAM map and the entry points. No code here. Each ROM reaches another only
; ; through these entry points, each a JMP at a fixed address (a test reads each one's opcode).

; ; I/O
; SCREEN   = $8000        ; 40 x 25 screen codes in the 1 KB video RAM
; COLUMNS  = 40
; ROWS     = 25
; PIA1     = $E810        ; +0 PA or DDRA, +1 CRA, +2 PB or DDRB, +3 CRB
; PIA1PA   = PIA1
; PIA1CRA  = PIA1+1
; PIA1PB   = PIA1+2
; PIA1CRB  = PIA1+3

; ; Zero page: $00-$3F BASIC, $40-$5F the editor, $60-$7F the kernel, $80-$FF the player's (USR).
; WAITING  = $40          ; 1 while the editor waits for keys to make a line (the harness signal)
; LINES    = $41          ; lines handed over, modulo 256
; MEMTOP   = $60          ; 2: the top of the program area that reset found
; PTR      = $62          ; 2: the kernel's pointer

; ; Pages 2 and 3.
; LINBUF   = $0200        ; 65: the line from the editor, $00-terminated
; DIRBUF   = $0241        ; 72: the tokenised direct line, as a record
; CSTACK   = $0290        ; 72: the control stack, 8 entries of 9 bytes
; KEYBUF   = $02F0        ; 8: the editor's key ring
; VARS     = $0300        ; 52: A-Z, low byte first
; LINKS    = $0334        ; 25: 1 when the row goes on from the row above
; SAVED    = $0350        ; 7: the monitor's PC (2), SR, AC, XR, YR, SP
; USRRAM   = $03F0        ; 16: the player's ({RAM} is 1008)
; PROGRAM  = $0400        ; the program base

; ; Entry points.
; COLD     = $C000        ; BASIC: power-on NEW, READY, the main loop
; WARM     = $C003        ; BASIC: READY on a fresh line, program and variables kept
; NUMOUT   = $C006        ; BASIC: print A (low), Y (high) as a signed decimal
; EDINIT   = $E000        ; editor: clear the screen, links, keys, flags
; EDPRINT  = $E003        ; editor: print A (P5o "print"); A, X, Y kept
; EDLINE   = $E006        ; editor: P5o "line": LINBUF, X = length
; EDINPUT  = $E009        ; editor: P5o "read a line": carry set on break
; EDBREAK  = $E00C        ; editor: P5o "break?": carry set once a STOP press
; EDIRQ    = $E00F        ; editor: the retrace's work (keys, blink)
; MONITOR  = $F000        ; monitor: USR(61440), C*
; MONBRK   = $F003        ; monitor: B*, from the IRQ handler
; SELFTEST = $F800        ; kernel: the self-test
; RESET    = $F803        ; kernel: the reset vector's target

; CROW    = $42           ; the cursor's row 0-24
; CCOL    = $43           ; and column 0-39
; ROWPTR  = $44           ; 2: SCREEN + 40 * CROW
; UNDER   = $46           ; the screen code under the cursor while it is out
; BLINK   = $47           ; retraces to the next blink
; SHOWN   = $48           ; 1 while the cursor is out (blinking)
; LASTKEY = $49           ; the matrix index the last scan saw, $FF none
; KHEAD   = $4A           ; KEYBUF ring: written at KHEAD by the IRQ
; KTAIL   = $4B           ; read at KTAIL
; BRKFLAG = $4C           ; set by a STOP press
; SROW    = $4D           ; where an input read began ($FF: forgotten by a scroll)
; SCOL    = $4E
; MODE    = $4F           ; 0 a line read, 1 an input read
; PHASE   = $50           ; the blink: 1 reversed
; LSTART  = $51           ; the logical line's first row
; NROWS   = $52           ; its rows, 1 or 2
; POS     = $53           ; the cursor's place in it, 0-79
; SRC     = $54           ; 2: the logical line's first cell
; CNT     = $56
; KNOW    = $57           ; the scan's key, $FF none
; KSHIFT  = $58           ; a SHIFT held in this scan
; KROW    = $59
; KBITS   = $5A
; TMP     = $5B
; BLINKS  = 20            ; retraces a blink phase (1/3 s)
; MAXLINE = 64            ; P5o: an entered line's characters

;         .org $E000
@000 4C 12 E0  ; E000          jmp init
@003 4C 2B E0  ; E003          jmp print
@006 4C 2C E2  ; E006          jmp line
@009 4C 35 E2  ; E009          jmp input
@00C 4C 1D E2  ; E00C          jmp break
@00F 4C 6F E1  ; E00F          jmp irq

; ; --- EDINIT -----------------------------------------------------------------------------------

@012 A9 00     ; E012  init:   lda #0
@014 85 40     ; E014          sta WAITING
@016 85 41     ; E016          sta LINES
@018 85 48     ; E018          sta SHOWN
@01A 85 4C     ; E01A          sta BRKFLAG
@01C 85 4A     ; E01C          sta KHEAD
@01E 85 4B     ; E01E          sta KTAIL
@020 85 4F     ; E020          sta MODE
@022 A9 FF     ; E022          lda #$FF
@024 85 49     ; E024          sta LASTKEY
@026 85 4D     ; E026          sta SROW
@028 4C 1F E1  ; E028          jmp clear

; ; --- EDPRINT: A ($0D, $0C, $20-$5F); A, X, Y kept ---------------------------------------------

@02B 48        ; E02B  print:  pha
@02C 85 5B     ; E02C          sta TMP
@02E 8A        ; E02E          txa
@02F 48        ; E02F          pha
@030 98        ; E030          tya
@031 48        ; E031          pha
@032 A5 5B     ; E032          lda TMP
@034 C9 0D     ; E034          cmp #$0D
@036 D0 0A     ; E036          bne @ff
@038 A9 00     ; E038          lda #0
@03A 85 43     ; E03A          sta CCOL
@03C 20 8E E0  ; E03C          jsr nextrow
@03F 4C 57 E0  ; E03F          jmp @done
@042 C9 0C     ; E042  @ff:    cmp #$0C
@044 D0 06     ; E044          bne @char
@046 20 1F E1  ; E046          jsr clear
@049 4C 57 E0  ; E049          jmp @done
@04C C9 20     ; E04C  @char:  cmp #$20
@04E 90 07     ; E04E          bcc @done
@050 C9 60     ; E050          cmp #$60
@052 B0 03     ; E052          bcs @done
@054 20 5D E0  ; E054          jsr putch
@057 68        ; E057  @done:  pla
@058 A8        ; E058          tay
@059 68        ; E059          pla
@05A AA        ; E05A          tax
@05B 68        ; E05B          pla
@05C 60        ; E05C          rts

; ; Store A ($20-$5F) at the cursor, move right; at the row's end go on into the next row, joined
; ; when this row is a logical line's first, else as a new logical line.
@05D 20 86 E0  ; E05D  putch:  jsr screencode
@060 A4 43     ; E060          ldy CCOL
@062 91 44     ; E062          sta (ROWPTR),y
@064 E6 43     ; E064          inc CCOL
@066 A5 43     ; E066          lda CCOL
@068 C9 28     ; E068          cmp #COLUMNS
@06A D0 19     ; E06A          bne @done
@06C A9 00     ; E06C          lda #0
@06E 85 43     ; E06E          sta CCOL
@070 A6 42     ; E070          ldx CROW
@072 BD 34 03  ; E072          lda LINKS,x
@075 D0 0B     ; E075          bne @newline
@077 20 8E E0  ; E077          jsr nextrow
@07A A6 42     ; E07A          ldx CROW
@07C A9 01     ; E07C          lda #1
@07E 9D 34 03  ; E07E          sta LINKS,x
@081 60        ; E081          rts
; @newline:
@082 20 8E E0  ; E082          jsr nextrow
@085 60        ; E085  @done:  rts

; ; A ($20-$5F) as a screen code: $40-$5F are $00-$1F.
; screencode:
@086 C9 40     ; E086          cmp #$40
@088 90 03     ; E088          bcc @done
@08A 38        ; E08A          sec
@08B E9 40     ; E08B          sbc #$40
@08D 60        ; E08D  @done:  rts

; ; The next row, a logical line of its own (its link cleared); scrolls at the bottom.
; nextrow:
@08E E6 42     ; E08E          inc CROW
@090 A5 42     ; E090          lda CROW
@092 C9 19     ; E092          cmp #ROWS
@094 90 07     ; E094          bcc @in
@096 20 C6 E0  ; E096          jsr scroll
@099 A9 18     ; E099          lda #ROWS-1
@09B 85 42     ; E09B          sta CROW
@09D A6 42     ; E09D  @in:    ldx CROW
@09F A9 00     ; E09F          lda #0
@0A1 9D 34 03  ; E0A1          sta LINKS,x
@0A4 4C B9 E0  ; E0A4          jmp rowaddr

; ; The next row, links kept (cursor down, RETURN); scrolls at the bottom.
; downrow:
@0A7 E6 42     ; E0A7          inc CROW
@0A9 A5 42     ; E0A9          lda CROW
@0AB C9 19     ; E0AB          cmp #ROWS
@0AD 90 07     ; E0AD          bcc @in
@0AF 20 C6 E0  ; E0AF          jsr scroll
@0B2 A9 18     ; E0B2          lda #ROWS-1
@0B4 85 42     ; E0B4          sta CROW
@0B6 4C B9 E0  ; E0B6  @in:    jmp rowaddr

; ; ROWPTR for CROW.
; rowaddr:
@0B9 A6 42     ; E0B9          ldx CROW
@0BB BD 33 E4  ; E0BB          lda rowlo,x
@0BE 85 44     ; E0BE          sta ROWPTR
@0C0 BD 4C E4  ; E0C0          lda rowhi,x
@0C3 85 45     ; E0C3          sta ROWPTR+1
@0C5 60        ; E0C5          rts

; ; Rows 1-24 up to 0-23, row 24 blank, the links with them. Interrupts stay on (about 8 ms). Each
; ; page is copied in its own loop, so no row is overwritten before it is read.
@0C6 A2 00     ; E0C6  scroll: ldx #0
@0C8 BD 28 80  ; E0C8  @p0:    lda SCREEN+$028,x
@0CB 9D 00 80  ; E0CB          sta SCREEN+$000,x
@0CE E8        ; E0CE          inx
@0CF D0 F7     ; E0CF          bne @p0
@0D1 BD 28 81  ; E0D1  @p1:    lda SCREEN+$128,x
@0D4 9D 00 81  ; E0D4          sta SCREEN+$100,x
@0D7 E8        ; E0D7          inx
@0D8 D0 F7     ; E0D8          bne @p1
@0DA BD 28 82  ; E0DA  @p2:    lda SCREEN+$228,x
@0DD 9D 00 82  ; E0DD          sta SCREEN+$200,x
@0E0 E8        ; E0E0          inx
@0E1 D0 F7     ; E0E1          bne @p2
@0E3 BD 28 83  ; E0E3  @p3:    lda SCREEN+$328,x
@0E6 9D 00 83  ; E0E6          sta SCREEN+$300,x
@0E9 E8        ; E0E9          inx
@0EA E0 C0     ; E0EA          cpx #$C0
@0EC D0 F5     ; E0EC          bne @p3
@0EE A9 20     ; E0EE          lda #$20
@0F0 A2 27     ; E0F0          ldx #COLUMNS-1
@0F2 9D C0 83  ; E0F2  @blank: sta SCREEN+40*(ROWS-1),x
@0F5 CA        ; E0F5          dex
@0F6 10 FA     ; E0F6          bpl @blank
@0F8 A2 00     ; E0F8          ldx #0
@0FA BD 35 03  ; E0FA  @links: lda LINKS+1,x
@0FD 9D 34 03  ; E0FD          sta LINKS,x
@100 E8        ; E100          inx
@101 E0 18     ; E101          cpx #ROWS-1
@103 D0 F5     ; E103          bne @links
@105 A9 00     ; E105          lda #0
@107 8D 4C 03  ; E107          sta LINKS+ROWS-1
@10A 8D 34 03  ; E10A          sta LINKS
@10D A5 4D     ; E10D          lda SROW
@10F C9 FF     ; E10F          cmp #$FF
@111 F0 0B     ; E111          beq @done
@113 C9 00     ; E113          cmp #0
@115 D0 05     ; E115          bne @up
@117 A9 FF     ; E117          lda #$FF
@119 85 4D     ; E119          sta SROW
@11B 60        ; E11B          rts
@11C C6 4D     ; E11C  @up:    dec SROW
@11E 60        ; E11E  @done:  rts

; ; Blank screen, no links, the cursor top left.
@11F A9 20     ; E11F  clear:  lda #$20
@121 A2 00     ; E121          ldx #0
@123 9D 00 80  ; E123  @fill:  sta SCREEN+$000,x
@126 9D 00 81  ; E126          sta SCREEN+$100,x
@129 9D 00 82  ; E129          sta SCREEN+$200,x
@12C 9D 00 83  ; E12C          sta SCREEN+$300,x
@12F E8        ; E12F          inx
@130 D0 F1     ; E130          bne @fill
@132 A9 00     ; E132          lda #0
@134 A2 18     ; E134          ldx #ROWS-1
@136 9D 34 03  ; E136  @links: sta LINKS,x
@139 CA        ; E139          dex
@13A 10 FA     ; E13A          bpl @links
@13C A9 00     ; E13C  home:   lda #0
@13E 85 42     ; E13E          sta CROW
@140 85 43     ; E140          sta CCOL
@142 4C B9 E0  ; E142          jmp rowaddr

; ; --- The cursor -------------------------------------------------------------------------------

; ; Out, reversed at once, blinking in the IRQ. Each is one short sei-cli.
; showcur:
@145 78        ; E145          sei
@146 A4 43     ; E146          ldy CCOL
@148 B1 44     ; E148          lda (ROWPTR),y
@14A 29 7F     ; E14A          and #$7F
@14C 85 46     ; E14C          sta UNDER
@14E 09 80     ; E14E          ora #$80
@150 91 44     ; E150          sta (ROWPTR),y
@152 A9 01     ; E152          lda #1
@154 85 48     ; E154          sta SHOWN
@156 85 50     ; E156          sta PHASE
@158 A9 14     ; E158          lda #BLINKS
@15A 85 47     ; E15A          sta BLINK
@15C 58        ; E15C          cli
@15D 60        ; E15D          rts

; hidecur:
@15E 78        ; E15E          sei
@15F A5 48     ; E15F          lda SHOWN
@161 F0 0A     ; E161          beq @done
@163 A4 43     ; E163          ldy CCOL
@165 A5 46     ; E165          lda UNDER
@167 91 44     ; E167          sta (ROWPTR),y
@169 A9 00     ; E169          lda #0
@16B 85 48     ; E16B          sta SHOWN
@16D 58        ; E16D  @done:  cli
@16E 60        ; E16E          rts

; ; --- EDIRQ: the key scan and the blink, at each retrace -----------------------------------------

@16F A9 FF     ; E16F  irq:    lda #$FF
@171 85 57     ; E171          sta KNOW
@173 A9 00     ; E173          lda #0
@175 85 58     ; E175          sta KSHIFT
@177 85 59     ; E177          sta KROW
@179 A5 59     ; E179  @row:   lda KROW
@17B 8D 10 E8  ; E17B          sta PIA1PA
@17E AD 12 E8  ; E17E          lda PIA1PB      ; the first read also clears the retrace flag
@181 49 FF     ; E181          eor #$FF
@183 85 5A     ; E183          sta KBITS
@185 A5 59     ; E185          lda KROW
@187 0A        ; E187          asl
@188 0A        ; E188          asl
@189 0A        ; E189          asl
@18A AA        ; E18A          tax             ; X: the matrix index, row * 8 + column
@18B 46 5A     ; E18B  @bit:   lsr KBITS
@18D 90 1C     ; E18D          bcc @next
@18F BD 00 E7  ; E18F          lda KEYTAB,x
@192 F0 0B     ; E192          beq @shift
@194 A5 57     ; E194          lda KNOW
@196 C9 FF     ; E196          cmp #$FF
@198 D0 11     ; E198          bne @next       ; the first key found counts
@19A 86 57     ; E19A          stx KNOW
@19C 4C AB E1  ; E19C          jmp @next
@19F E0 40     ; E19F  @shift: cpx #8*8+0
@1A1 F0 04     ; E1A1          beq @isshift
@1A3 E0 45     ; E1A3          cpx #8*8+5
@1A5 D0 04     ; E1A5          bne @next
; @isshift:
@1A7 A9 01     ; E1A7          lda #1
@1A9 85 58     ; E1A9          sta KSHIFT
@1AB E8        ; E1AB  @next:  inx
@1AC 8A        ; E1AC          txa
@1AD 29 07     ; E1AD          and #7
@1AF D0 DA     ; E1AF          bne @bit
@1B1 E6 59     ; E1B1          inc KROW
@1B3 A5 59     ; E1B3          lda KROW
@1B5 C9 0A     ; E1B5          cmp #10
@1B7 D0 C0     ; E1B7          bne @row
@1B9 A9 0F     ; E1B9          lda #$0F        ; no row selected between scans
@1BB 8D 10 E8  ; E1BB          sta PIA1PA

@1BE A5 57     ; E1BE          lda KNOW
@1C0 C5 49     ; E1C0          cmp LASTKEY
@1C2 F0 3A     ; E1C2          beq @blink
@1C4 85 49     ; E1C4          sta LASTKEY
@1C6 C9 FF     ; E1C6          cmp #$FF
@1C8 F0 34     ; E1C8          beq @blink
@1CA AA        ; E1CA          tax
@1CB BD 00 E7  ; E1CB          lda KEYTAB,x
@1CE C9 03     ; E1CE          cmp #$03
@1D0 D0 07     ; E1D0          bne @notstop
@1D2 A9 01     ; E1D2          lda #1
@1D4 85 4C     ; E1D4          sta BRKFLAG
@1D6 4C FE E1  ; E1D6          jmp @blink
; @notstop:
@1D9 A4 58     ; E1D9          ldy KSHIFT
@1DB F0 12     ; E1DB          beq @queue
@1DD C9 11     ; E1DD          cmp #$11        ; CRSR down, right, HOME, DEL: shifted up, left, CLR, INST
@1DF F0 0C     ; E1DF          beq @shifted
@1E1 C9 1D     ; E1E1          cmp #$1D
@1E3 F0 08     ; E1E3          beq @shifted
@1E5 C9 13     ; E1E5          cmp #$13
@1E7 F0 04     ; E1E7          beq @shifted
@1E9 C9 14     ; E1E9          cmp #$14
@1EB D0 02     ; E1EB          bne @queue
; @shifted:
@1ED 09 80     ; E1ED          ora #$80
@1EF A6 4A     ; E1EF  @queue: ldx KHEAD
@1F1 9D F0 02  ; E1F1          sta KEYBUF,x
@1F4 E8        ; E1F4          inx
@1F5 8A        ; E1F5          txa
@1F6 29 07     ; E1F6          and #7
@1F8 C5 4B     ; E1F8          cmp KTAIL
@1FA F0 02     ; E1FA          beq @blink      ; full: dropped
@1FC 85 4A     ; E1FC          sta KHEAD

@1FE A5 48     ; E1FE  @blink: lda SHOWN
@200 F0 1A     ; E200          beq @done
@202 C6 47     ; E202          dec BLINK
@204 D0 16     ; E204          bne @done
@206 A9 14     ; E206          lda #BLINKS
@208 85 47     ; E208          sta BLINK
@20A A5 50     ; E20A          lda PHASE
@20C 49 01     ; E20C          eor #1
@20E 85 50     ; E20E          sta PHASE
@210 A5 46     ; E210          lda UNDER
@212 A4 50     ; E212          ldy PHASE
@214 F0 02     ; E214          beq @put
@216 09 80     ; E216          ora #$80
@218 A4 43     ; E218  @put:   ldy CCOL
@21A 91 44     ; E21A          sta (ROWPTR),y
@21C 60        ; E21C  @done:  rts

; ; --- EDBREAK ----------------------------------------------------------------------------------

@21D 78        ; E21D  break:  sei
@21E A5 4C     ; E21E          lda BRKFLAG
@220 F0 07     ; E220          beq @no
@222 A9 00     ; E222          lda #0
@224 85 4C     ; E224          sta BRKFLAG
@226 58        ; E226          cli
@227 38        ; E227          sec
@228 60        ; E228          rts
@229 58        ; E229  @no:    cli
@22A 18        ; E22A          clc
@22B 60        ; E22B          rts

; ; --- EDLINE, EDINPUT --------------------------------------------------------------------------

@22C A9 00     ; E22C  line:   lda #0
@22E 85 4F     ; E22E          sta MODE
@230 85 4C     ; E230          sta BRKFLAG
@232 4C 39 E2  ; E232          jmp read
@235 A9 01     ; E235  input:  lda #1
@237 85 4F     ; E237          sta MODE
@239 A5 4A     ; E239  read:   lda KHEAD       ; keys typed before the read are dropped
@23B 85 4B     ; E23B          sta KTAIL
@23D A5 42     ; E23D          lda CROW
@23F 85 4D     ; E23F          sta SROW
@241 A5 43     ; E241          lda CCOL
@243 85 4E     ; E243          sta SCOL
@245 A9 01     ; E245          lda #1
@247 85 40     ; E247          sta WAITING
@249 20 45 E1  ; E249          jsr showcur
@24C A5 4F     ; E24C  @wait:  lda MODE
@24E D0 07     ; E24E          bne @input
@250 A9 00     ; E250          lda #0          ; at a line read, STOP is discarded
@252 85 4C     ; E252          sta BRKFLAG
@254 4C 66 E2  ; E254          jmp @key
@257 A5 4C     ; E257  @input: lda BRKFLAG
@259 F0 0B     ; E259          beq @key
@25B A9 00     ; E25B          lda #0
@25D 85 4C     ; E25D          sta BRKFLAG
@25F 85 40     ; E25F          sta WAITING
@261 20 5E E1  ; E261          jsr hidecur
@264 38        ; E264          sec
@265 60        ; E265          rts
@266 A5 4B     ; E266  @key:   lda KTAIL
@268 C5 4A     ; E268          cmp KHEAD
@26A F0 E0     ; E26A          beq @wait
@26C AA        ; E26C          tax
@26D BD F0 02  ; E26D          lda KEYBUF,x
@270 48        ; E270          pha
@271 E8        ; E271          inx
@272 8A        ; E272          txa
@273 29 07     ; E273          and #7
@275 85 4B     ; E275          sta KTAIL
@277 20 5E E1  ; E277          jsr hidecur
@27A 68        ; E27A          pla
@27B C9 0D     ; E27B          cmp #$0D
@27D F0 09     ; E27D          beq @return
@27F 20 CA E2  ; E27F          jsr dokey
@282 20 45 E1  ; E282          jsr showcur
@285 4C 4C E2  ; E285          jmp @wait
; @return:
@288 4C B9 E3  ; E288          jmp enter

; ; LSTART, NROWS, POS and SRC for the cursor's logical line.
; logical:
@28B A6 42     ; E28B          ldx CROW
@28D BD 34 03  ; E28D  @up:    lda LINKS,x
@290 F0 03     ; E290          beq @first
@292 CA        ; E292          dex
@293 D0 F8     ; E293          bne @up         ; row 0 never goes on from above
@295 86 51     ; E295  @first: stx LSTART
@297 A9 01     ; E297          lda #1
@299 85 52     ; E299          sta NROWS
@29B E8        ; E29B          inx
@29C E0 19     ; E29C          cpx #ROWS
@29E B0 09     ; E29E          bcs @pos
@2A0 BD 34 03  ; E2A0          lda LINKS,x
@2A3 F0 04     ; E2A3          beq @pos
@2A5 A9 02     ; E2A5          lda #2
@2A7 85 52     ; E2A7          sta NROWS
@2A9 A5 42     ; E2A9  @pos:   lda CROW
@2AB C5 51     ; E2AB          cmp LSTART
@2AD F0 0A     ; E2AD          beq @row0
@2AF A9 28     ; E2AF          lda #COLUMNS
@2B1 18        ; E2B1          clc
@2B2 65 43     ; E2B2          adc CCOL
@2B4 85 53     ; E2B4          sta POS
@2B6 4C BD E2  ; E2B6          jmp @src
@2B9 A5 43     ; E2B9  @row0:  lda CCOL
@2BB 85 53     ; E2BB          sta POS
@2BD A6 51     ; E2BD  @src:   ldx LSTART
@2BF BD 33 E4  ; E2BF          lda rowlo,x
@2C2 85 54     ; E2C2          sta SRC
@2C4 BD 4C E4  ; E2C4          lda rowhi,x
@2C7 85 55     ; E2C7          sta SRC+1
@2C9 60        ; E2C9          rts

; ; A key while reading: printable, the cursor keys, HOME, CLR, DEL, INST; others do nothing.
@2CA C9 20     ; E2CA  dokey:  cmp #$20
@2CC 90 07     ; E2CC          bcc @control
@2CE C9 60     ; E2CE          cmp #$60
@2D0 B0 03     ; E2D0          bcs @control
@2D2 4C 34 E3  ; E2D2          jmp typed
; @control:
@2D5 C9 1D     ; E2D5          cmp #$1D
@2D7 F0 2C     ; E2D7          beq right
@2D9 C9 9D     ; E2D9          cmp #$9D
@2DB F0 38     ; E2DB          beq left
@2DD C9 11     ; E2DD          cmp #$11
@2DF D0 03     ; E2DF          bne @n1
@2E1 4C A7 E0  ; E2E1          jmp downrow
@2E4 C9 91     ; E2E4  @n1:    cmp #$91
@2E6 F0 42     ; E2E6          beq up
@2E8 C9 13     ; E2E8          cmp #$13
@2EA D0 03     ; E2EA          bne @n2
@2EC 4C 3C E1  ; E2EC          jmp home
@2EF C9 93     ; E2EF  @n2:    cmp #$93
@2F1 D0 03     ; E2F1          bne @n3
@2F3 4C 1F E1  ; E2F3          jmp clear
@2F6 C9 14     ; E2F6  @n3:    cmp #$14
@2F8 D0 03     ; E2F8          bne @n4
@2FA 4C 68 E3  ; E2FA          jmp delete
@2FD C9 94     ; E2FD  @n4:    cmp #$94
@2FF D0 03     ; E2FF          bne @n5
@301 4C 8D E3  ; E301          jmp insert
@304 60        ; E304  @n5:    rts

@305 E6 43     ; E305  right:  inc CCOL
@307 A5 43     ; E307          lda CCOL
@309 C9 28     ; E309          cmp #COLUMNS
@30B D0 07     ; E30B          bne @done
@30D A9 00     ; E30D          lda #0
@30F 85 43     ; E30F          sta CCOL
@311 4C A7 E0  ; E311          jmp downrow
@314 60        ; E314  @done:  rts

@315 A5 43     ; E315  left:   lda CCOL
@317 F0 03     ; E317          beq @wrap
@319 C6 43     ; E319          dec CCOL
@31B 60        ; E31B          rts
@31C A5 42     ; E31C  @wrap:  lda CROW
@31E F0 09     ; E31E          beq @done
@320 C6 42     ; E320          dec CROW
@322 A9 27     ; E322          lda #COLUMNS-1
@324 85 43     ; E324          sta CCOL
@326 4C B9 E0  ; E326          jmp rowaddr
@329 60        ; E329  @done:  rts

@32A A5 42     ; E32A  up:     lda CROW
@32C F0 05     ; E32C          beq @done
@32E C6 42     ; E32E          dec CROW
@330 4C B9 E0  ; E330          jmp rowaddr
@333 60        ; E333  @done:  rts

; ; A printable key: refused at place 64 of its logical line or later. A wrap from the line's
; ; first row goes into the second, joining it (scrolling at the bottom); the 64 limit keeps a
; ; second row from wrapping.
@334 48        ; E334  typed:  pha
@335 20 8B E2  ; E335          jsr logical
@338 68        ; E338          pla
@339 A6 53     ; E339          ldx POS
@33B E0 40     ; E33B          cpx #MAXLINE
@33D B0 28     ; E33D          bcs @done
@33F 20 86 E0  ; E33F          jsr screencode
@342 A4 43     ; E342          ldy CCOL
@344 91 44     ; E344          sta (ROWPTR),y
@346 E6 43     ; E346          inc CCOL
@348 A5 43     ; E348          lda CCOL
@34A C9 28     ; E34A          cmp #COLUMNS
@34C D0 19     ; E34C          bne @done
@34E A9 00     ; E34E          lda #0
@350 85 43     ; E350          sta CCOL
@352 A5 52     ; E352          lda NROWS
@354 C9 02     ; E354          cmp #2
@356 D0 05     ; E356          bne @join
@358 E6 42     ; E358          inc CROW        ; the second row is already joined
@35A 4C B9 E0  ; E35A          jmp rowaddr
@35D 20 A7 E0  ; E35D  @join:  jsr downrow
@360 A6 42     ; E360          ldx CROW
@362 A9 01     ; E362          lda #1
@364 9D 34 03  ; E364          sta LINKS,x
@367 60        ; E367  @done:  rts

; ; DEL: the cell left of the cursor goes, the rest of the logical line moves left. At the line's
; ; start it does nothing.
@368 20 8B E2  ; E368  delete: jsr logical
@36B A5 53     ; E36B          lda POS
@36D F0 1D     ; E36D          beq @done
@36F 20 15 E3  ; E36F          jsr left
@372 C6 53     ; E372          dec POS
@374 20 A9 E3  ; E374          jsr length      ; CNT = the line's cells
@377 A4 53     ; E377          ldy POS
@379 C8        ; E379  @move:  iny
@37A C4 56     ; E37A          cpy CNT
@37C B0 09     ; E37C          bcs @last
@37E B1 54     ; E37E          lda (SRC),y
@380 88        ; E380          dey
@381 91 54     ; E381          sta (SRC),y
@383 C8        ; E383          iny
@384 4C 79 E3  ; E384          jmp @move
@387 88        ; E387  @last:  dey
@388 A9 20     ; E388          lda #$20
@38A 91 54     ; E38A          sta (SRC),y
@38C 60        ; E38C  @done:  rts

; ; INST: a space at the cursor, the rest moves right, the last cell lost.
@38D 20 8B E2  ; E38D  insert: jsr logical
@390 20 A9 E3  ; E390          jsr length
@393 A4 56     ; E393          ldy CNT
@395 88        ; E395          dey
@396 C4 53     ; E396  @move:  cpy POS
@398 F0 0A     ; E398          beq @space
@39A 88        ; E39A          dey
@39B B1 54     ; E39B          lda (SRC),y
@39D C8        ; E39D          iny
@39E 91 54     ; E39E          sta (SRC),y
@3A0 88        ; E3A0          dey
@3A1 4C 96 E3  ; E3A1          jmp @move
@3A4 A9 20     ; E3A4  @space: lda #$20
@3A6 91 54     ; E3A6          sta (SRC),y
@3A8 60        ; E3A8          rts

@3A9 A5 52     ; E3A9  length: lda NROWS
@3AB C9 02     ; E3AB          cmp #2
@3AD F0 05     ; E3AD          beq @two
@3AF A9 28     ; E3AF          lda #COLUMNS
@3B1 85 56     ; E3B1          sta CNT
@3B3 60        ; E3B3          rts
@3B4 A9 50     ; E3B4  @two:   lda #2*COLUMNS
@3B6 85 56     ; E3B6          sta CNT
@3B8 60        ; E3B8          rts

; ; RETURN: the logical line (from the input read's start, if the cursor is still on its line),
; ; cut at 64, trailing spaces trimmed, into LINBUF; the cursor to the row after it.
@3B9 20 8B E2  ; E3B9  enter:  jsr logical
@3BC 20 A9 E3  ; E3BC          jsr length
@3BF A0 00     ; E3BF          ldy #0          ; the first cell taken
@3C1 A5 4F     ; E3C1          lda MODE
@3C3 F0 18     ; E3C3          beq @copy
@3C5 A5 4D     ; E3C5          lda SROW
@3C7 C5 51     ; E3C7          cmp LSTART
@3C9 90 12     ; E3C9          bcc @copy
@3CB 38        ; E3CB          sec
@3CC E5 51     ; E3CC          sbc LSTART
@3CE C5 52     ; E3CE          cmp NROWS
@3D0 B0 0B     ; E3D0          bcs @copy
@3D2 AA        ; E3D2          tax
@3D3 A5 4E     ; E3D3          lda SCOL
@3D5 E0 00     ; E3D5          cpx #0
@3D7 F0 03     ; E3D7          beq @from
@3D9 18        ; E3D9          clc
@3DA 69 28     ; E3DA          adc #COLUMNS
@3DC A8        ; E3DC  @from:  tay
@3DD A2 00     ; E3DD  @copy:  ldx #0
@3DF C4 56     ; E3DF  @next:  cpy CNT
@3E1 B0 1F     ; E3E1          bcs @cut
@3E3 E0 40     ; E3E3          cpx #MAXLINE
@3E5 B0 1B     ; E3E5          bcs @cut
@3E7 B1 54     ; E3E7          lda (SRC),y
@3E9 29 7F     ; E3E9          and #$7F
@3EB C9 40     ; E3EB          cmp #$40
@3ED 90 05     ; E3ED          bcc @low
@3EF A9 20     ; E3EF          lda #$20        ; a graphic: nothing BASIC wrote
@3F1 4C FA E3  ; E3F1          jmp @put
@3F4 C9 20     ; E3F4  @low:   cmp #$20
@3F6 B0 02     ; E3F6          bcs @put
@3F8 09 40     ; E3F8          ora #$40
@3FA 9D 00 02  ; E3FA  @put:   sta LINBUF,x
@3FD C8        ; E3FD          iny
@3FE E8        ; E3FE          inx
@3FF 4C DF E3  ; E3FF          jmp @next
@402 E0 00     ; E402  @cut:   cpx #0
@404 F0 0B     ; E404          beq @end
@406 BD FF 01  ; E406          lda LINBUF-1,x
@409 C9 20     ; E409          cmp #$20
@40B D0 04     ; E40B          bne @end
@40D CA        ; E40D          dex
@40E 4C 02 E4  ; E40E          jmp @cut
@411 A9 00     ; E411  @end:   lda #0
@413 9D 00 02  ; E413          sta LINBUF,x
@416 86 56     ; E416          stx CNT
@418 A5 51     ; E418          lda LSTART
@41A 18        ; E41A          clc
@41B 65 52     ; E41B          adc NROWS
@41D 38        ; E41D          sec
@41E E9 01     ; E41E          sbc #1
@420 85 42     ; E420          sta CROW
@422 A9 00     ; E422          lda #0
@424 85 43     ; E424          sta CCOL
@426 20 A7 E0  ; E426          jsr downrow
@429 A9 00     ; E429          lda #0
@42B 85 40     ; E42B          sta WAITING
@42D E6 41     ; E42D          inc LINES
@42F A6 56     ; E42F          ldx CNT
@431 18        ; E431          clc
@432 60        ; E432          rts


; Generated by bw asm from bw80_test.asm: do not edit. Edit the .asm and run bw asm again.
; ; BW-80 test ROM (2332, IC2): docs/p5v-bw80-video/BW80_VIDEO.md, BW80_VIDEO_DESIGN.md §6.2. Run
; ; in place of the ZX80 ROM through --roms (a directory with IC2.rom linked to this file's .rom).
; ; A page of every character, normal and inverse, made the ZX80's way.
; ;
; ; $0000 a jump to the setup; $0038 the line interrupt (IM 1); $0050 the setup and the frame
; ; loop; $0E00-$0FFF the ZX80's character set (from roms/zx80_ic2.bin). RAM: the display file at $4000, the stack below $4400.
; ;
; ; The display file is a HALT, then 24 rows of 32 character codes and a HALT each. A row runs at
; ; its echo (A15 high, $C000 up): each code (bit 6 clear) is fetched and forced to a NOP while the
; ; data latch keeps it for the glyph fetch in the refresh, I:R giving the character set's page;
; ; the HALT runs as itself. INT_N is on A6: R, loaded before each line, drops A6 in the refresh at
; ; the line's end; the interrupt's acknowledge starts HSYNC. This driver follows the ZX80 ROM's
; ; (Wearmouth's listing: MASK-INT at $0038, DISP-2 at $01AD, KEYBOARD's VSYNC at $013F-$0197)
; ; instruction for instruction where the timing depends on it: the R values, the instructions
; ; between LD R,A and JP (HL), and the interrupt routine, whose M1s clock the HSYNC flip-flops.
; ; Its own code is the setup and the VSYNC's delay. Code cell c (0-767, row by row): c & $3F,
; ; inverse ($80) when c & $40, so rows 2-3, 6-7 ... are inverse.

;         .cpu z80
;         .rom $0000, $1000

; DFILE = $4000           ; the display file in RAM
; ECHO = $8000            ; A15 high: the display file's echo, its codes forced to NOPs
; STACK = $4400           ; top of the 1K RAM
; ROWS = 24
; COLUMNS = 32
; NEWLINE = $76           ; HALT
; TOP = 56                ; blank lines above the page (the ZX80's UK margin, KB-3)
; BOTTOM = TOP - 1        ; blank lines below it (the ZX80 decrements its margin)
; R_TOP = $EC             ; R before the top margin (the ZX80's, after its OUT)
; R_LINE = $DD            ; R before every later line (DISP-2)
; R_BOTTOM = $F3          ; R before the bottom margin
; VSYNC_TURNS = 97        ; DJNZ turns: IN to OUT about 1270 T-states, the ZX80's 1262

;         .org $0000
@000 F3        ; 0000          DI                      ; (4)
@001 C3 50 00  ; 0001          JP setup                ; (10)

;         .org $0050
@050 31 00 44  ; 0050  setup:  LD SP,STACK             ; (10)
@053 3E 0E     ; 0053          LD A,$0E                ; the character set's page, on A8-A15 in each refresh (7)
@055 ED 47     ; 0055          LD I,A                  ; (9)
@057 ED 56     ; 0057          IM 1                    ; (8)
@059 21 00 40  ; 0059          LD HL,DFILE             ; (10)
@05C 36 76     ; 005C          LD (HL),NEWLINE         ; the lone HALT of the margins (10)
@05E 23        ; 005E          INC HL                  ; (6)
@05F 0E 00     ; 005F          LD C,0                  ; code cell (7)
@061 16 18     ; 0061          LD D,ROWS               ; (7)
@063 06 20     ; 0063  row:    LD B,COLUMNS            ; (7)
@065 79        ; 0065  @cell:  LD A,C                  ; (4)
@066 E6 40     ; 0066          AND $40                 ; (7)
@068 87        ; 0068          ADD A,A                 ; bit 6 to bit 7: inverse (4)
@069 5F        ; 0069          LD E,A                  ; (4)
@06A 79        ; 006A          LD A,C                  ; (4)
@06B E6 3F     ; 006B          AND $3F                 ; (7)
@06D B3        ; 006D          OR E                    ; (4)
@06E 77        ; 006E          LD (HL),A               ; (7)
@06F 23        ; 006F          INC HL                  ; (6)
@070 0C        ; 0070          INC C                   ; (4)
@071 10 F2     ; 0071          DJNZ @cell              ; (13/8)
@073 36 76     ; 0073          LD (HL),NEWLINE         ; (10)
@075 23        ; 0075          INC HL                  ; (6)
@076 15        ; 0076          DEC D                   ; (4)
@077 20 EA     ; 0077          JR NZ,row               ; (12/7)
@079 DB FE     ; 0079  frame:  IN A,($FE)              ; KBD_N: the VSYNC latch on (11)
@07B 06 61     ; 007B          LD B,VSYNC_TURNS        ; (7)
@07D 10 FE     ; 007D          DJNZ *                  ; (13/8)
@07F D3 FF     ; 007F          OUT ($FF),A             ; any OUT: the VSYNC latch off (11)
@081 3E EC     ; 0081          LD A,R_TOP              ; (7)
@083 06 19     ; 0083          LD B,ROWS + 1           ; the margin's HALT and the rows (7)
@085 21 00 C0  ; 0085          LD HL,DFILE | ECHO      ; (10)
@088 0E 38     ; 0088          LD C,TOP                ; (7)
@08A CD 98 00  ; 008A          CALL display            ; the top margin and the page (17)
@08D 3E F3     ; 008D          LD A,R_BOTTOM           ; (7)
@08F 04        ; 008F          INC B                   ; one row: the last HALT (4)
@090 2B        ; 0090          DEC HL                  ; the last row's HALT (6)
@091 0E 37     ; 0091          LD C,BOTTOM             ; (7)
@093 CD 98 00  ; 0093          CALL display            ; the bottom margin (17)
@096 18 E1     ; 0096          JR frame                ; (12)

@098 ED 4F     ; 0098  display: LD R,A                 ; R wraps A6 low at the line's end (9)
@09A 3E DD     ; 009A          LD A,R_LINE             ; R for the lines after this one (7)
@09C FB        ; 009C          EI                      ; (4)
@09D E9        ; 009D          JP (HL)                 ; the row, in the echo (4)

; ; IM 1: the line's end. The pushed address is the byte after the HALT just run: the next row.
;         .org $0038
@038 0D        ; 0038          DEC C                   ; lines left of this row (4)
@039 C2 45 00  ; 0039          JP NZ,again             ; (10)
@03C E1        ; 003C          POP HL                  ; the next row (10)
@03D 05        ; 003D          DEC B                   ; rows left (4)
@03E C8        ; 003E          RET Z                   ; all done: back from display (11/5)
@03F CB D9     ; 003F          SET 3,C                 ; 8 lines a row (8)
@041 ED 4F     ; 0041  next:   LD R,A                  ; (9)
@043 FB        ; 0043          EI                      ; (4)
@044 E9        ; 0044          JP (HL)                 ; (4)
@045 D1        ; 0045  again:  POP DE                  ; the same row again: drop the pushed address (10)
@046 C8        ; 0046          RET Z                   ; never taken: Z is clear here, a delay as the ZX80's (5)
@047 18 F8     ; 0047          JR next                 ; (12)

;         .org $0E00
@E00 00 00 00 00 00 00 00 00 00 14 14 00 00 00 00 00  ; 0E00          .incbin "zx80_ic2.bin", $0E00, $0200
@E10 F0 F0 F0 F0 F0 F0 F0 F0 00 00 00 00 FF FF FF FF
@E20 F0 F0 F0 F0 00 00 00 00 0F 0F 0F 0F 00 00 00 00
@E30 00 00 00 00 F0 F0 F0 F0 00 00 00 00 0F 0F 0F 0F
@E40 0F 0F 0F 0F F0 F0 F0 F0 AA 55 AA 55 AA 55 AA 55
@E50 00 00 00 00 AA 55 AA 55 AA 55 AA 55 00 00 00 00
@E60 00 1E 21 78 20 20 7F 00 00 08 3E 48 3E 09 3E 08
@E70 00 00 00 08 00 00 08 00 00 3E 41 06 08 00 08 00
@E80 00 04 08 08 08 08 04 00 00 10 08 08 08 08 10 00
@E90 00 00 00 00 3E 00 00 00 00 00 08 08 3E 08 08 00
@EA0 00 00 2A 1C 08 1C 2A 00 00 00 02 04 08 10 20 00
@EB0 00 00 00 3E 00 3E 00 00 00 00 10 08 04 08 10 00
@EC0 00 00 04 08 10 08 04 00 00 00 08 00 00 08 08 10
@ED0 00 00 00 00 00 08 08 10 00 00 00 00 00 0C 0C 00
@EE0 00 1C 22 41 41 22 1C 00 00 0C 14 04 04 04 1E 00
@EF0 00 3E 41 01 3E 40 7F 00 00 3E 41 06 01 41 3E 00

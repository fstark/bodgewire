; Generated by bw asm from bw2001_kernel.asm: do not edit. Edit the .asm and run bw asm again.
; ; BW-2001 kernel (docs/p5p-bw2001-firmware/BW2001_FIRMWARE.md; design §4): the PET 2001's
; ; $F000 sockets. UH4 ($F000-$F7FF) holds the monitor; UH7 ($F800-$FFFF) the reset, the
; ; interrupts, the self-test and the vectors, so the self-test runs even when UH4, UH3 or BASIC
; ; is dead. Memory, I/O and the entry points: roms/bw2001.inc.
; ;
; ; Reset: PIA1 set (rows out, DIAG in); DIAG (PA7) low runs the self-test before any RAM is used.
; ; Else the RAM is sized from $0400 ($55 then $AA a byte, up to $2000), the editor started, the
; ; retrace interrupt on, the banner printed, and BASIC's COLD entered.

;         .rom $F000, $1000
;         .include "bw2001.inc"
; ; BW-2001 firmware, shared by its three ROMs (docs/p5p-bw2001-firmware/BW2001_FIRMWARE_DESIGN.md
; ; §3): the I/O, the RAM map and the entry points. No code here. Each ROM reaches another only
; ; through these entry points, each a JMP at a fixed address (a test reads each one's opcode).

; ; I/O
; SCREEN   = $8000        ; 40 x 25 screen codes in the 1 KB video RAM
; COLUMNS  = 40
; ROWS     = 25
; PIA1     = $E810        ; +0 PA or DDRA, +1 CRA, +2 PB or DDRB, +3 CRB
; PIA1PA   = PIA1
; PIA1CRA  = PIA1+1
; PIA1PB   = PIA1+2
; PIA1CRB  = PIA1+3

; ; Zero page: $00-$3F BASIC, $40-$5F the editor, $60-$7F the kernel, $80-$FF the player's (USR).
; WAITING  = $40          ; 1 while the editor waits for keys to make a line (the harness signal)
; LINES    = $41          ; lines handed over, modulo 256
; MEMTOP   = $60          ; 2: the top of the program area that reset found
; PTR      = $62          ; 2: the kernel's pointer

; ; Pages 2 and 3.
; LINBUF   = $0200        ; 65: the line from the editor, $00-terminated
; DIRBUF   = $0241        ; 72: the tokenised direct line, as a record
; CSTACK   = $0290        ; 72: the control stack, 8 entries of 9 bytes
; KEYBUF   = $02F0        ; 8: the editor's key ring
; VARS     = $0300        ; 52: A-Z, low byte first
; LINKS    = $0334        ; 25: 1 when the row goes on from the row above
; SAVED    = $0350        ; 7: the monitor's PC (2), SR, AC, XR, YR, SP
; USRRAM   = $03F0        ; 16: the player's ({RAM} is 1008)
; PROGRAM  = $0400        ; the program base

; ; Entry points.
; COLD     = $C000        ; BASIC: power-on NEW, READY, the main loop
; WARM     = $C003        ; BASIC: READY on a fresh line, program and variables kept
; NUMOUT   = $C006        ; BASIC: print A (low), Y (high) as a signed decimal
; EDINIT   = $E000        ; editor: clear the screen, links, keys, flags
; EDPRINT  = $E003        ; editor: print A (P5o "print"); A, X, Y kept
; EDLINE   = $E006        ; editor: P5o "line": LINBUF, X = length
; EDINPUT  = $E009        ; editor: P5o "read a line": carry set on break
; EDBREAK  = $E00C        ; editor: P5o "break?": carry set once a STOP press
; EDIRQ    = $E00F        ; editor: the retrace's work (keys, blink)
; MONITOR  = $F000        ; monitor: USR(61440), C*
; MONBRK   = $F003        ; monitor: B*, from the IRQ handler
; SELFTEST = $F800        ; kernel: the self-test
; RESET    = $F803        ; kernel: the reset vector's target

; ; --- UH4: the monitor ---------------------------------------------------------------------------

;         .org $F000
@000 4C 06 F0  ; F000          jmp monitor
@003 4C 07 F0  ; F003          jmp monbrk

; monitor:
@006 60        ; F006          rts
@007 4C 03 C0  ; F007  monbrk: jmp WARM

;         .org $F7FF
@7FF 01        ; F7FF          .checksum $F000, $800

; ; --- UH7: reset, interrupts, the self-test -------------------------------------------------------

;         .org $F800
@800 4C F4 F8  ; F800          jmp selftest
@803 4C 06 F8  ; F803          jmp reset

@806 78        ; F806  reset:  sei
@807 D8        ; F807          cld
@808 A2 FF     ; F808          ldx #$FF
@80A 9A        ; F80A          txs
@80B A9 00     ; F80B          lda #0          ; PIA1 port A: PA0-PA3 the keyboard row out, PA4-PA7 in (PA7 DIAG)
@80D 8D 11 E8  ; F80D          sta PIA1CRA
@810 A9 0F     ; F810          lda #$0F
@812 8D 10 E8  ; F812          sta PIA1PA
@815 A9 04     ; F815          lda #$04
@817 8D 11 E8  ; F817          sta PIA1CRA
@81A A9 0F     ; F81A          lda #$0F
@81C 8D 10 E8  ; F81C          sta PIA1PA      ; no row selected
@81F A9 00     ; F81F          lda #0          ; port B: the columns in; CB1 on its falling edge, interrupt off
@821 8D 13 E8  ; F821          sta PIA1CRB
@824 8D 12 E8  ; F824          sta PIA1PB
@827 A9 04     ; F827          lda #$04
@829 8D 13 E8  ; F829          sta PIA1CRB
@82C AD 10 E8  ; F82C          lda PIA1PA
@82F 30 03     ; F82F          bmi @basic
@831 4C F4 F8  ; F831          jmp selftest    ; DIAG low: no RAM touched yet

@834 A9 00     ; F834  @basic: lda #0
@836 A2 7F     ; F836          ldx #$7F
@838 95 00     ; F838  @zp:    sta $00,x
@83A CA        ; F83A          dex
@83B 10 FB     ; F83B          bpl @zp
@83D A2 00     ; F83D          ldx #0
@83F 9D 00 02  ; F83F  @pages: sta $0200,x
@842 9D 00 03  ; F842          sta $0300,x
@845 E8        ; F845          inx
@846 D0 F7     ; F846          bne @pages

@848 A9 00     ; F848          lda #<PROGRAM   ; size the RAM
@84A 85 62     ; F84A          sta PTR
@84C A9 04     ; F84C          lda #>PROGRAM
@84E 85 63     ; F84E          sta PTR+1
@850 A0 00     ; F850          ldy #0
@852 A9 55     ; F852  @size:  lda #$55
@854 91 62     ; F854          sta (PTR),y
@856 D1 62     ; F856          cmp (PTR),y
@858 D0 14     ; F858          bne @top
@85A A9 AA     ; F85A          lda #$AA
@85C 91 62     ; F85C          sta (PTR),y
@85E D1 62     ; F85E          cmp (PTR),y
@860 D0 0C     ; F860          bne @top
@862 E6 62     ; F862          inc PTR
@864 D0 EC     ; F864          bne @size
@866 E6 63     ; F866          inc PTR+1
@868 A5 63     ; F868          lda PTR+1
@86A C9 20     ; F86A          cmp #$20
@86C D0 E4     ; F86C          bne @size
@86E A5 62     ; F86E  @top:   lda PTR
@870 85 60     ; F870          sta MEMTOP
@872 A5 63     ; F872          lda PTR+1
@874 85 61     ; F874          sta MEMTOP+1

@876 20 00 E0  ; F876          jsr EDINIT
@879 A9 05     ; F879          lda #$05        ; the retrace interrupt on
@87B 8D 13 E8  ; F87B          sta PIA1CRB
@87E 58        ; F87E          cli

@87F A2 00     ; F87F          ldx #0
@881 BD AB F8  ; F881  @title: lda banner,x
@884 F0 06     ; F884          beq @free
@886 20 03 E0  ; F886          jsr EDPRINT
@889 E8        ; F889          inx
@88A D0 F5     ; F88A          bne @title
@88C 38        ; F88C  @free:  sec             ; MEMTOP - PROGRAM - 2: the bytes free
@88D A5 60     ; F88D          lda MEMTOP
@88F E9 02     ; F88F          sbc #<(PROGRAM+2)
@891 48        ; F891          pha
@892 A5 61     ; F892          lda MEMTOP+1
@894 E9 04     ; F894          sbc #>(PROGRAM+2)
@896 A8        ; F896          tay
@897 68        ; F897          pla
@898 20 06 C0  ; F898          jsr NUMOUT
@89B A2 00     ; F89B          ldx #0
@89D BD C8 F8  ; F89D  @bytes: lda freetext,x
@8A0 F0 06     ; F8A0          beq @cold
@8A2 20 03 E0  ; F8A2          jsr EDPRINT
@8A5 E8        ; F8A5          inx
@8A6 D0 F5     ; F8A6          bne @bytes
@8A8 4C 00 C0  ; F8A8  @cold:  jmp COLD

@8AB 2A 2A 2A 20 42 57 2D 32 30 30 31 20 54 49 4E 59  ; F8AB  banner: .byte "*** BW-2001 TINY BASIC ***", $0D, $0D, 0
@8BB 20 42 41 53 49 43 20 2A 2A 2A 0D 0D 00
; freetext:
@8C8 20 42 59 54 45 53 20 46 52 45 45 0D 0D 00  ; F8C8          .byte " BYTES FREE", $0D, $0D, 0

; ; IRQ: a BRK goes to the monitor with this handler's three bytes on the stack; the retrace (PIA1
; ; CRB bit 7) runs the editor's scan.
@8D6 48        ; F8D6  irq:    pha
@8D7 8A        ; F8D7          txa
@8D8 48        ; F8D8          pha
@8D9 98        ; F8D9          tya
@8DA 48        ; F8DA          pha
@8DB BA        ; F8DB          tsx
@8DC BD 04 01  ; F8DC          lda $0104,x     ; the P the 6502 pushed
@8DF 29 10     ; F8DF          and #$10
@8E1 F0 03     ; F8E1          beq @retrace
@8E3 4C 03 F0  ; F8E3          jmp MONBRK
; @retrace:
@8E6 AD 13 E8  ; F8E6          lda PIA1CRB
@8E9 10 03     ; F8E9          bpl @done
@8EB 20 0F E0  ; F8EB          jsr EDIRQ
@8EE 68        ; F8EE  @done:  pla
@8EF A8        ; F8EF          tay
@8F0 68        ; F8F0          pla
@8F1 AA        ; F8F1          tax
@8F2 68        ; F8F2          pla
@8F3 40        ; F8F3  nmi:    rti

; selftest:
@8F4 4C F4 F8  ; F8F4          jmp selftest

;         .org $FFF9
@FF9 DE        ; FFF9          .checksum $F800, $800
@FFA F3 F8 06 F8 D6 F8  ; FFFA          .word nmi, reset, irq

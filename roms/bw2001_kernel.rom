@B2A A5 01     ; FB2A          lda PTR0+1
@B2C 8D BE 80  ; FB2C          sta SCREEN+HEXRAM+SCRATCH+2
@B2F A0 00     ; FB2F  rlabel: ldy #0
@B31 B9 6B FD  ; FB31  @l:     lda rambadtext,y
@B34 F0 08     ; FB34          beq @go
@B36 29 3F     ; FB36          and #$3F
@B38 99 A0 80  ; FB38          sta ROW4,y
@B3B C8        ; FB3B          iny
@B3C D0 F3     ; FB3C          bne @l
@B3E A2 A8     ; FB3E  @go:    ldx #HEXRAM
@B40 9A        ; FB40          txs
@B41 4C 44 FB  ; FB41          jmp fail

; ; A failure's row: S its digits' offset in page $80, the bits, low and high bytes waiting in
; ; the cells SCRATCH beyond. The digits written, the cells blanked, and here it stays.
@B44 BA        ; FB44  fail:   tsx
@B45 BD 16 80  ; FB45          lda SCREEN+SCRATCH+2,x
@B48 4A        ; FB48          lsr
@B49 4A        ; FB49          lsr
@B4A 4A        ; FB4A          lsr
@B4B 4A        ; FB4B          lsr
@B4C C9 0A     ; FB4C          cmp #10
@B4E 90 02     ; FB4E          bcc @h1
@B50 69 06     ; FB50          adc #6
@B52 69 30     ; FB52  @h1:    adc #'0'
@B54 29 3F     ; FB54          and #$3F
@B56 9D 00 80  ; FB56          sta SCREEN,x
@B59 BD 16 80  ; FB59          lda SCREEN+SCRATCH+2,x
@B5C 29 0F     ; FB5C          and #$0F
@B5E C9 0A     ; FB5E          cmp #10
@B60 90 02     ; FB60          bcc @h2
@B62 69 06     ; FB62          adc #6
@B64 69 30     ; FB64  @h2:    adc #'0'
@B66 29 3F     ; FB66          and #$3F
@B68 9D 01 80  ; FB68          sta SCREEN+1,x
@B6B BD 15 80  ; FB6B          lda SCREEN+SCRATCH+1,x
@B6E 4A        ; FB6E          lsr
@B6F 4A        ; FB6F          lsr
@B70 4A        ; FB70          lsr
@B71 4A        ; FB71          lsr
@B72 C9 0A     ; FB72          cmp #10
@B74 90 02     ; FB74          bcc @h3
@B76 69 06     ; FB76          adc #6
@B78 69 30     ; FB78  @h3:    adc #'0'
@B7A 29 3F     ; FB7A          and #$3F
@B7C 9D 02 80  ; FB7C          sta SCREEN+2,x
@B7F BD 15 80  ; FB7F          lda SCREEN+SCRATCH+1,x
@B82 29 0F     ; FB82          and #$0F
@B84 C9 0A     ; FB84          cmp #10
@B86 90 02     ; FB86          bcc @h4
@B88 69 06     ; FB88          adc #6
@B8A 69 30     ; FB8A  @h4:    adc #'0'
@B8C 29 3F     ; FB8C          and #$3F
@B8E 9D 03 80  ; FB8E          sta SCREEN+3,x
@B91 BD 14 80  ; FB91          lda SCREEN+SCRATCH,x
@B94 4A        ; FB94          lsr
@B95 4A        ; FB95          lsr
@B96 4A        ; FB96          lsr
@B97 4A        ; FB97          lsr
@B98 C9 0A     ; FB98          cmp #10
@B9A 90 02     ; FB9A          bcc @h5
@B9C 69 06     ; FB9C          adc #6
@B9E 69 30     ; FB9E  @h5:    adc #'0'
@BA0 29 3F     ; FBA0          and #$3F
@BA2 9D 05 80  ; FBA2          sta SCREEN+5,x
@BA5 BD 14 80  ; FBA5          lda SCREEN+SCRATCH,x
@BA8 29 0F     ; FBA8          and #$0F
@BAA C9 0A     ; FBAA          cmp #10
@BAC 90 02     ; FBAC          bcc @h6
@BAE 69 06     ; FBAE          adc #6
@BB0 69 30     ; FBB0  @h6:    adc #'0'
@BB2 29 3F     ; FBB2          and #$3F
@BB4 9D 06 80  ; FBB4          sta SCREEN+6,x
@BB7 A9 20     ; FBB7          lda #$20
@BB9 9D 14 80  ; FBB9          sta SCREEN+SCRATCH,x
@BBC 9D 15 80  ; FBBC          sta SCREEN+SCRATCH+1,x
@BBF 9D 16 80  ; FBBF          sta SCREEN+SCRATCH+2,x
@BC2 4C C2 FB  ; FBC2  @hang:  jmp @hang

; ; The RAM is good: the stack and JSR from here.
; rampassed:
@BC5 A2 FF     ; FBC5          ldx #$FF
@BC7 9A        ; FBC7          txs
@BC8 A9 A0     ; FBC8          lda #<ROW4
@BCA 85 02     ; FBCA          sta ROWP
@BCC A9 80     ; FBCC          lda #>ROW4
@BCE 85 03     ; FBCE          sta ROWP+1
@BD0 A2 64     ; FBD0          ldx #<ramoktext
@BD2 A0 FD     ; FBD2          ldy #>ramoktext
@BD4 20 D3 FC  ; FBD4          jsr putstr
@BD7 A2 00     ; FBD7          ldx #0
@BD9 86 06     ; FBD9  @chip:  stx CHIP
@BDB BD 10 FD  ; FBDB          lda romrowlo,x  ; ROWP = row 5 + CHIP
@BDE 85 02     ; FBDE          sta ROWP
@BE0 BD 15 FD  ; FBE0          lda romrowhi,x
@BE3 85 03     ; FBE3          sta ROWP+1
@BE5 A9 00     ; FBE5          lda #0
@BE7 85 00     ; FBE7          sta PTR0
@BE9 85 04     ; FBE9          sta SUM
@BEB BD 0B FD  ; FBEB          lda rompages,x
@BEE 85 01     ; FBEE          sta PTR0+1
@BF0 A2 08     ; FBF0          ldx #8          ; 2048 bytes
@BF2 A0 00     ; FBF2  @page:  ldy #0
@BF4 18        ; FBF4  @byte:  clc
@BF5 A5 04     ; FBF5          lda SUM
@BF7 71 00     ; FBF7          adc (PTR0),y
@BF9 85 04     ; FBF9          sta SUM
@BFB C8        ; FBFB          iny
@BFC D0 F6     ; FBFC          bne @byte
@BFE E6 01     ; FBFE          inc PTR0+1
@C00 CA        ; FC00          dex
@C01 D0 EF     ; FC01          bne @page
@C03 A2 74     ; FC03          ldx #<romtext
@C05 A0 FD     ; FC05          ldy #>romtext
@C07 20 D3 FC  ; FC07          jsr putstr
@C0A A6 06     ; FC0A          ldx CHIP
@C0C BD 0B FD  ; FC0C          lda rompages,x
@C0F 20 F5 FC  ; FC0F          jsr puthex
@C12 A9 00     ; FC12          lda #0
@C14 20 F5 FC  ; FC14          jsr puthex
@C17 A5 04     ; FC17          lda SUM
@C19 D0 0A     ; FC19          bne @bad
@C1B A2 79     ; FC1B          ldx #<oktext
@C1D A0 FD     ; FC1D          ldy #>oktext
@C1F 20 D3 FC  ; FC1F          jsr putstr
@C22 4C 31 FC  ; FC22          jmp @next
@C25 A2 7D     ; FC25  @bad:   ldx #<badtext
@C27 A0 FD     ; FC27          ldy #>badtext
@C29 20 D3 FC  ; FC29          jsr putstr
@C2C A5 04     ; FC2C          lda SUM
@C2E 20 F5 FC  ; FC2E          jsr puthex
@C31 A6 06     ; FC31  @next:  ldx CHIP
@C33 E8        ; FC33          inx
@C34 E0 05     ; FC34          cpx #ROMCHIPS
@C36 D0 A1     ; FC36          bne @chip

; ; The keyboard: the first held key in scan order, its row, column and legend, forever.
@C38 A9 B8     ; FC38  keys:   lda #<ROW11
@C3A 85 02     ; FC3A          sta ROWP
@C3C A9 81     ; FC3C          lda #>ROW11
@C3E 85 03     ; FC3E          sta ROWP+1
@C40 A9 FF     ; FC40          lda #$FF
@C42 85 05     ; FC42          sta KEYIX
@C44 A2 00     ; FC44          ldx #0
@C46 8E 10 E8  ; FC46  @row:   stx PIA1PA
@C49 AD 12 E8  ; FC49          lda PIA1PB
@C4C A0 00     ; FC4C          ldy #0
@C4E 4A        ; FC4E  @bit:   lsr
@C4F B0 12     ; FC4F          bcs @up
@C51 48        ; FC51          pha
@C52 A5 05     ; FC52          lda KEYIX
@C54 C9 FF     ; FC54          cmp #$FF
@C56 D0 0A     ; FC56          bne @have
@C58 8A        ; FC58          txa
@C59 0A        ; FC59          asl
@C5A 0A        ; FC5A          asl
@C5B 0A        ; FC5B          asl
@C5C 84 04     ; FC5C          sty SUM
@C5E 05 04     ; FC5E          ora SUM
@C60 85 05     ; FC60          sta KEYIX
@C62 68        ; FC62  @have:  pla
@C63 C8        ; FC63  @up:    iny
@C64 C0 08     ; FC64          cpy #8
@C66 D0 E6     ; FC66          bne @bit
@C68 E8        ; FC68          inx
@C69 E0 0A     ; FC69          cpx #10
@C6B D0 D9     ; FC6B          bne @row
@C6D A9 0F     ; FC6D          lda #$0F
@C6F 8D 10 E8  ; FC6F          sta PIA1PA
@C72 A2 83     ; FC72          ldx #<keytext
@C74 A0 FD     ; FC74          ldy #>keytext
@C76 20 D3 FC  ; FC76          jsr putstr
@C79 A5 05     ; FC79          lda KEYIX
@C7B C9 FF     ; FC7B          cmp #$FF
@C7D F0 43     ; FC7D          beq @blank
@C7F 4A        ; FC7F          lsr
@C80 4A        ; FC80          lsr
@C81 4A        ; FC81          lsr
@C82 09 30     ; FC82          ora #'0'
@C84 20 E4 FC  ; FC84          jsr putch
@C87 A5 05     ; FC87          lda KEYIX
@C89 29 07     ; FC89          and #7
@C8B 09 30     ; FC8B          ora #'0'
@C8D 20 E4 FC  ; FC8D          jsr putch
@C90 A9 20     ; FC90          lda #' '
@C92 20 E4 FC  ; FC92          jsr putch
@C95 A6 05     ; FC95          ldx KEYIX
@C97 BD 88 FD  ; FC97          lda legends,x
@C9A 30 06     ; FC9A          bmi @name
@C9C 20 E4 FC  ; FC9C          jsr putch
@C9F 4C C2 FC  ; FC9F          jmp @blank
@CA2 29 7F     ; FCA2  @name:  and #$7F
@CA4 AA        ; FCA4          tax
@CA5 A0 00     ; FCA5          ldy #0
@CA7 E0 00     ; FCA7  @find:  cpx #0
@CA9 F0 0C     ; FCA9          beq @print
@CAB B9 D8 FD  ; FCAB  @skip:  lda names,y
@CAE C8        ; FCAE          iny
@CAF C9 00     ; FCAF          cmp #0
@CB1 D0 F8     ; FCB1          bne @skip
@CB3 CA        ; FCB3          dex
@CB4 4C A7 FC  ; FCB4          jmp @find
@CB7 B9 D8 FD  ; FCB7  @print: lda names,y
@CBA F0 06     ; FCBA          beq @blank
@CBC 20 E4 FC  ; FCBC          jsr putch
@CBF C8        ; FCBF          iny
@CC0 D0 F5     ; FCC0          bne @print
@CC2 A6 02     ; FCC2  @blank: ldx ROWP        ; the rest of the row blank: row 11 lies in page $81 ($81B8-$81DF)
@CC4 A9 20     ; FCC4          lda #$20
@CC6 E0 CC     ; FCC6  @b:     cpx #<ROW11+20
@CC8 F0 06     ; FCC8          beq @again
@CCA 9D 00 81  ; FCCA          sta $8100,x
@CCD E8        ; FCCD          inx
@CCE D0 F6     ; FCCE          bne @b
@CD0 4C 38 FC  ; FCD0  @again: jmp keys

; ; The text at X (low), Y (high) at ROWP, ROWP moving on.
@CD3 86 00     ; FCD3  putstr: stx PTR0
@CD5 84 01     ; FCD5          sty PTR0+1
@CD7 A0 00     ; FCD7          ldy #0
@CD9 B1 00     ; FCD9  @loop:  lda (PTR0),y
@CDB F0 06     ; FCDB          beq @done
@CDD 20 E4 FC  ; FCDD          jsr putch
@CE0 C8        ; FCE0          iny
@CE1 D0 F6     ; FCE1          bne @loop
@CE3 60        ; FCE3  @done:  rts

; ; A at ROWP as a screen code, ROWP + 1; X, Y kept.
@CE4 84 07     ; FCE4  putch:  sty PUTY
@CE6 A0 00     ; FCE6          ldy #0
@CE8 29 3F     ; FCE8          and #$3F
@CEA 91 02     ; FCEA          sta (ROWP),y
@CEC E6 02     ; FCEC          inc ROWP
@CEE D0 02     ; FCEE          bne @done
@CF0 E6 03     ; FCF0          inc ROWP+1
@CF2 A4 07     ; FCF2  @done:  ldy PUTY
@CF4 60        ; FCF4          rts

@CF5 48        ; FCF5  puthex: pha
@CF6 4A        ; FCF6          lsr
@CF7 4A        ; FCF7          lsr
@CF8 4A        ; FCF8          lsr
@CF9 4A        ; FCF9          lsr
@CFA 20 00 FD  ; FCFA          jsr @nib
@CFD 68        ; FCFD          pla
@CFE 29 0F     ; FCFE          and #$0F
@D00 C9 0A     ; FD00  @nib:   cmp #10
@D02 90 02     ; FD02          bcc @d
@D04 69 06     ; FD04          adc #6
@D06 69 30     ; FD06  @d:     adc #'0'
@D08 4C E4 FC  ; FD08          jmp putch

; ROMCHIPS = 5
; rompages:
@D0B C0 C8 E0 F0 F8  ; FD0B          .byte $C0, $C8, $E0, $F0, $F8
; romrowlo:
@D10 C8 F0 18 40 68  ; FD10          .byte <(SCREEN+5*40), <(SCREEN+6*40), <(SCREEN+7*40), <(SCREEN+8*40), <(SCREEN+9*40)
; romrowhi:
@D15 80 80 81 81 81  ; FD15          .byte >(SCREEN+5*40), >(SCREEN+6*40), >(SCREEN+7*40), >(SCREEN+8*40), >(SCREEN+9*40)

; titletext:
@D1A 42 57 2D 32 30 30 31 20 53 45 4C 46 2D 54 45 53  ; FD1A          .byte "BW-2001 SELF-TEST", 0
@D2A 54 00
; zpoktext:
@D2C 5A 45 52 4F 20 50 41 47 45 20 4F 4B 00  ; FD2C          .byte "ZERO PAGE OK", 0
; zpbadtext:
@D39 5A 45 52 4F 20 50 41 47 45 20 42 41 44 20 00  ; FD39          .byte "ZERO PAGE BAD ", 0
; vidoktext:
@D48 56 49 44 45 4F 20 52 41 4D 20 4F 4B 00  ; FD48          .byte "VIDEO RAM OK", 0
; vidbadtext:
@D55 56 49 44 45 4F 20 52 41 4D 20 42 41 44 20 00  ; FD55          .byte "VIDEO RAM BAD ", 0
; ramoktext:
@D64 52 41 4D 20 4F 4B 00  ; FD64          .byte "RAM OK", 0
; rambadtext:
@D6B 52 41 4D 20 42 41 44 20 00  ; FD6B          .byte "RAM BAD ", 0
; romtext:
@D74 52 4F 4D 20 00  ; FD74          .byte "ROM ", 0
@D79 20 4F 4B 00  ; FD79  oktext: .byte " OK", 0
; badtext:
@D7D 20 42 41 44 20 00  ; FD7D          .byte " BAD ", 0
; keytext:
@D83 4B 45 59 20 00  ; FD83          .byte "KEY ", 0

; ; Each matrix place's legend (spec "The PET it runs on"), row 0 PB0 first: a character, or
; ; $80 + a name's index in NAMES, or 0 unused.
; legends:
@D88 21 23 25 26 28 5F 88 87  ; FD88          .byte '!', '#', '%', '&', '(', '_', $80+8, $80+7
@D90 22 24 27 5C 29 00 86 85  ; FD90          .byte '"', '$', $27, $5C, ')', 0, $80+6, $80+5
@D98 51 45 54 55 4F 5E 37 39  ; FD98          .byte 'Q', 'E', 'T', 'U', 'O', '^', '7', '9'
@DA0 57 52 59 49 50 00 38 2F  ; FDA0          .byte 'W', 'R', 'Y', 'I', 'P', 0, '8', '/'
@DA8 41 44 47 4A 4C 00 34 36  ; FDA8          .byte 'A', 'D', 'G', 'J', 'L', 0, '4', '6'
@DB0 53 46 48 4B 3A 00 35 2A  ; FDB0          .byte 'S', 'F', 'H', 'K', ':', 0, '5', '*'
@DB8 5A 43 42 4D 3B 81 31 33  ; FDB8          .byte 'Z', 'C', 'B', 'M', ';', $80+1, '1', '3'
@DC0 58 56 4E 2C 3F 00 32 2B  ; FDC0          .byte 'X', 'V', 'N', ',', '?', 0, '2', '+'
@DC8 83 40 5D 00 3E 84 30 2D  ; FDC8          .byte $80+3, '@', ']', 0, '>', $80+4, '0', '-'
@DD0 89 5B 80 3C 82 00 2E 3D  ; FDD0          .byte $80+9, '[', $80+0, '<', $80+2, 0, '.', '='
@DD8 53 50 41 43 45 00 52 45 54 55 52 4E 00 53 54 4F  ; FDD8  names:  .byte "SPACE", 0, "RETURN", 0, "STOP", 0, "SHIFT L", 0, "SHIFT R", 0
@DE8 50 00 53 48 49 46 54 20 4C 00 53 48 49 46 54 20
@DF8 52 00
@DFA 44 45 4C 00 43 52 53 52 20 44 4E 00 43 52 53 52  ; FDFA          .byte "DEL", 0, "CRSR DN", 0, "CRSR RT", 0, "HOME", 0, "RVS", 0
@E0A 20 52 54 00 48 4F 4D 45 00 52 56 53 00

;         .org $FFF9
@FF9 4E        ; FFF9          .checksum $F800, $800
@FFA F8 F8 06 F8 DB F8  ; FFFA          .word nmi, reset, irq

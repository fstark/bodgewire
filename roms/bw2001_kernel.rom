; Generated by bw asm from bw2001_kernel.asm: do not edit. Edit the .asm and run bw asm again.
; ; BW-2001 kernel (docs/p5p-bw2001-firmware/BW2001_FIRMWARE.md; design §4): the PET 2001's
; ; $F000 sockets. UH4 ($F000-$F7FF) holds the monitor; UH7 ($F800-$FFFF) the reset, the
; ; interrupts, the self-test and the vectors, so the self-test runs even when UH4, UH3 or BASIC
; ; is dead. Memory, I/O and the entry points: roms/bw2001.inc.
; ;
; ; Reset: PIA1 set (rows out, DIAG in); DIAG (PA7) low runs the self-test before any RAM is used.
; ; Else the RAM is sized from $0400 ($55 then $AA a byte, up to $2000), the editor started, the
; ; retrace interrupt on, the banner printed, and BASIC's COLD entered.

;         .rom $F000, $1000
;         .include "bw2001.inc"
; ; BW-2001 firmware, shared by its three ROMs (docs/p5p-bw2001-firmware/BW2001_FIRMWARE_DESIGN.md
; ; §3): the I/O, the RAM map and the entry points. No code here. Each ROM reaches another only
; ; through these entry points, each a JMP at a fixed address (a test reads each one's opcode).

; ; I/O
; SCREEN   = $8000        ; 40 x 25 screen codes in the 1 KB video RAM
; COLUMNS  = 40
; ROWS     = 25
; PIA1     = $E810        ; +0 PA or DDRA, +1 CRA, +2 PB or DDRB, +3 CRB
; PIA1PA   = PIA1
; PIA1CRA  = PIA1+1
; PIA1PB   = PIA1+2
; PIA1CRB  = PIA1+3
; VIA      = $E840        ; +0 port B: PB5 low while the beam is outside the text (the retrace)
; VIAPCR   = VIA+$C       ; CA2 (GRAPHIC): low, the character ROM's first half

; ; Zero page: $00-$3F BASIC, $40-$5F the editor, $60-$7F the kernel, $80-$FF the player's (USR).
; WAITING  = $40          ; 1 while the editor waits for keys to make a line (the harness signal)
; LINES    = $41          ; lines handed over, modulo 256
; CCOL     = $43          ; the editor's cursor column (the monitor reads it for a fresh row)
; MEMTOP   = $60          ; 2: the top of the program area that reset found
; PTR      = $62          ; 2: the kernel's pointer

; ; Pages 2 and 3.
; LINBUF   = $0200        ; 65: the line from the editor, $00-terminated
; DIRBUF   = $0241        ; 72: the tokenised direct line, as a record
; CSTACK   = $0290        ; 72: the control stack, 8 entries of 9 bytes
; KEYBUF   = $02F0        ; 8: the editor's key ring
; VARS     = $0300        ; 52: A-Z, low byte first
; LINKS    = $0334        ; 25: 1 when the row goes on from the row above
; SAVED    = $0350        ; 7: the monitor's PC (2), SR, AC, XR, YR, SP
; USRRAM   = $03F0        ; 16: the player's ({RAM} is 1008)
; PROGRAM  = $0400        ; the program base

; ; Entry points.
; COLD     = $C000        ; BASIC: power-on NEW, READY, the main loop
; WARM     = $C003        ; BASIC: READY on a fresh line, program and variables kept
; NUMOUT   = $C006        ; BASIC: print A (low), Y (high) as a signed decimal
; EDINIT   = $E000        ; editor: clear the screen, links, keys, flags
; EDPRINT  = $E003        ; editor: print A (P5o "print"); A, X, Y kept
; EDLINE   = $E006        ; editor: P5o "line": LINBUF, X = length
; EDINPUT  = $E009        ; editor: P5o "read a line": carry set on break
; EDBREAK  = $E00C        ; editor: P5o "break?": carry set once a STOP press
; EDIRQ    = $E00F        ; editor: the retrace's work (keys, blink)
; MONITOR  = $F000        ; monitor: USR(61440), C*
; MONBRK   = $F003        ; monitor: B*, from the IRQ handler
; SELFTEST = $F800        ; kernel: the self-test
; RESET    = $F803        ; kernel: the reset vector's target

; ; --- UH4: the monitor (spec "The monitor"; design §4.3) --------------------------------------
; ;
; ; TIM's commands: .M aaaa bbbb, .: aaaa bb..., .R, .; pppp ss aa xx yy ss, .G [aaaa], .X, and .T
; ; for the self-test. Entered by USR(61440) (C*) or a BRK (B*, from the IRQ handler). It runs on
; ; the stack below the saved SP, so .G goes back to the caller's frames; only .X and .T reset S.

; MADDR   = $64           ; 2: an address parsed or dumped
; MEND    = $66           ; 2: .M's end
; MBYTE   = $68           ; HEX2's value
; MX      = $69           ; the place in LINBUF
; MREGS   = $6A           ; 7: a .; line's fields before they are kept
; MTMP    = $71           ; scratch

;         .org $F000
@000 4C 06 F0  ; F000          jmp monitor
@003 4C 2A F0  ; F003          jmp monbrk

; ; USR(61440): JSR'd from BASIC. The saved PC is the return address + 1, the SP after it.
; monitor:
@006 08        ; F006          php
@007 8D 53 03  ; F007          sta SAVED+3
@00A 8E 54 03  ; F00A          stx SAVED+4
@00D 8C 55 03  ; F00D          sty SAVED+5
@010 68        ; F010          pla
@011 8D 52 03  ; F011          sta SAVED+2
@014 68        ; F014          pla
@015 18        ; F015          clc
@016 69 01     ; F016          adc #1
@018 8D 50 03  ; F018          sta SAVED
@01B 68        ; F01B          pla
@01C 69 00     ; F01C          adc #0
@01E 8D 51 03  ; F01E          sta SAVED+1
@021 BA        ; F021          tsx
@022 8E 56 03  ; F022          stx SAVED+6
@025 A9 43     ; F025          lda #'C'
@027 4C 49 F0  ; F027          jmp mentry

; ; A BRK: the IRQ handler's Y, X, A, then the 6502's P and PC (the BRK + 2).
@02A 68        ; F02A  monbrk: pla
@02B 8D 55 03  ; F02B          sta SAVED+5
@02E 68        ; F02E          pla
@02F 8D 54 03  ; F02F          sta SAVED+4
@032 68        ; F032          pla
@033 8D 53 03  ; F033          sta SAVED+3
@036 68        ; F036          pla
@037 8D 52 03  ; F037          sta SAVED+2
@03A 68        ; F03A          pla
@03B 8D 50 03  ; F03B          sta SAVED
@03E 68        ; F03E          pla
@03F 8D 51 03  ; F03F          sta SAVED+1
@042 BA        ; F042          tsx
@043 8E 56 03  ; F043          stx SAVED+6
@046 D8        ; F046          cld
@047 A9 42     ; F047          lda #'B'
@049 58        ; F049  mentry: cli             ; the editor's keys come from the retrace interrupt
@04A 48        ; F04A          pha
@04B A5 43     ; F04B          lda CCOL
@04D F0 05     ; F04D          beq @fresh
@04F A9 0D     ; F04F          lda #$0D
@051 20 03 E0  ; F051          jsr EDPRINT
@054 68        ; F054  @fresh: pla
@055 20 03 E0  ; F055          jsr EDPRINT
@058 A9 2A     ; F058          lda #'*'
@05A 20 03 E0  ; F05A          jsr EDPRINT
@05D A9 0D     ; F05D          lda #$0D
@05F 20 03 E0  ; F05F          jsr EDPRINT
@062 20 BB F1  ; F062          jsr regs
@065 A9 2E     ; F065  mloop:  lda #'.'
@067 20 03 E0  ; F067          jsr EDPRINT
@06A 20 06 E0  ; F06A          jsr EDLINE
@06D A2 00     ; F06D          ldx #0
@06F 86 69     ; F06F          stx MX
@071 20 11 F2  ; F071          jsr mspace
@074 BD 00 02  ; F074          lda LINBUF,x
@077 C9 2E     ; F077          cmp #'.'
@079 D0 01     ; F079          bne @cmd
@07B E8        ; F07B          inx
@07C BD 00 02  ; F07C  @cmd:   lda LINBUF,x
@07F F0 E4     ; F07F          beq mloop       ; an empty command
@081 E8        ; F081          inx
@082 86 69     ; F082          stx MX
@084 C9 4D     ; F084          cmp #'M'
@086 F0 3A     ; F086          beq mdump
@088 C9 3A     ; F088          cmp #':'
@08A D0 03     ; F08A          bne @n1
@08C 4C 2F F1  ; F08C          jmp mstore
@08F C9 52     ; F08F  @n1:    cmp #'R'
@091 D0 06     ; F091          bne @n2
@093 20 BB F1  ; F093          jsr regs
@096 4C 65 F0  ; F096          jmp mloop
@099 C9 3B     ; F099  @n2:    cmp #';'
@09B D0 03     ; F09B          bne @n3
@09D 4C 53 F1  ; F09D          jmp msetregs
@0A0 C9 47     ; F0A0  @n3:    cmp #'G'
@0A2 D0 03     ; F0A2          bne @n4
@0A4 4C 86 F1  ; F0A4          jmp mgo
@0A7 C9 58     ; F0A7  @n4:    cmp #'X'
@0A9 D0 03     ; F0A9          bne @n5
@0AB 4C 03 C0  ; F0AB          jmp WARM
@0AE C9 54     ; F0AE  @n5:    cmp #'T'
@0B0 D0 03     ; F0B0          bne mbad
@0B2 4C 00 F8  ; F0B2          jmp SELFTEST
@0B5 A9 3F     ; F0B5  mbad:   lda #'?'
@0B7 20 03 E0  ; F0B7          jsr EDPRINT
@0BA A9 0D     ; F0BA          lda #$0D
@0BC 20 03 E0  ; F0BC          jsr EDPRINT
@0BF 4C 65 F0  ; F0BF          jmp mloop

; ; .M aaaa bbbb: rows of 8 from aaaa & $FFF8 while the row's start is not past bbbb; STOP ends.
@0C2 20 20 F2  ; F0C2  mdump:  jsr hex4
@0C5 B0 EE     ; F0C5          bcs mbad
@0C7 A5 64     ; F0C7          lda MADDR
@0C9 29 F8     ; F0C9          and #$F8
@0CB 85 62     ; F0CB          sta PTR
@0CD A5 65     ; F0CD          lda MADDR+1
@0CF 85 63     ; F0CF          sta PTR+1
@0D1 20 20 F2  ; F0D1          jsr hex4
@0D4 B0 56     ; F0D4          bcs @bad
@0D6 A5 64     ; F0D6          lda MADDR
@0D8 85 66     ; F0D8          sta MEND
@0DA A5 65     ; F0DA          lda MADDR+1
@0DC 85 67     ; F0DC          sta MEND+1
@0DE A5 66     ; F0DE  @row:   lda MEND        ; PTR > MEND: done
@0E0 C5 62     ; F0E0          cmp PTR
@0E2 A5 67     ; F0E2          lda MEND+1
@0E4 E5 63     ; F0E4          sbc PTR+1
@0E6 90 41     ; F0E6          bcc @done
@0E8 20 0C E0  ; F0E8          jsr EDBREAK
@0EB B0 3C     ; F0EB          bcs @done
@0ED A9 2E     ; F0ED          lda #'.'
@0EF 20 03 E0  ; F0EF          jsr EDPRINT
@0F2 A9 3A     ; F0F2          lda #':'
@0F4 20 03 E0  ; F0F4          jsr EDPRINT
@0F7 A9 20     ; F0F7          lda #' '
@0F9 20 03 E0  ; F0F9          jsr EDPRINT
@0FC A5 63     ; F0FC          lda PTR+1
@0FE 20 77 F2  ; F0FE          jsr hexout
@101 A5 62     ; F101          lda PTR
@103 20 77 F2  ; F103          jsr hexout
@106 A0 00     ; F106          ldy #0
@108 A9 20     ; F108  @byte:  lda #' '
@10A 20 03 E0  ; F10A          jsr EDPRINT
@10D B1 62     ; F10D          lda (PTR),y
@10F 20 77 F2  ; F10F          jsr hexout
@112 C8        ; F112          iny
@113 C0 08     ; F113          cpy #8
@115 D0 F1     ; F115          bne @byte
@117 A9 0D     ; F117          lda #$0D
@119 20 03 E0  ; F119          jsr EDPRINT
@11C 18        ; F11C          clc
@11D A5 62     ; F11D          lda PTR
@11F 69 08     ; F11F          adc #8
@121 85 62     ; F121          sta PTR
@123 90 B9     ; F123          bcc @row
@125 E6 63     ; F125          inc PTR+1
@127 D0 B5     ; F127          bne @row        ; past $FFFF: done
@129 4C 65 F0  ; F129  @done:  jmp mloop
@12C 4C B5 F0  ; F12C  @bad:   jmp mbad

; ; .: aaaa bb ...: up to 8 bytes, each written as it is read; it stops at the first that is not
; ; one (the rest of an edited dump row).
@12F 20 20 F2  ; F12F  mstore: jsr hex4
@132 B0 1C     ; F132          bcs @bad
@134 20 32 F2  ; F134          jsr hex2
@137 B0 17     ; F137          bcs @bad
@139 A0 00     ; F139          ldy #0
@13B A5 68     ; F13B  @byte:  lda MBYTE
@13D 91 64     ; F13D          sta (MADDR),y
@13F C8        ; F13F          iny
@140 C0 08     ; F140          cpy #8
@142 F0 09     ; F142          beq @done
@144 84 66     ; F144          sty MEND
@146 20 32 F2  ; F146          jsr hex2
@149 A4 66     ; F149          ldy MEND
@14B 90 EE     ; F14B          bcc @byte
@14D 4C 65 F0  ; F14D  @done:  jmp mloop
@150 4C B5 F0  ; F150  @bad:   jmp mbad

; ; .; pppp ss aa xx yy ss: all six fields, then kept.
; msetregs:
@153 20 20 F2  ; F153          jsr hex4
@156 B0 2B     ; F156          bcs @bad
@158 A5 64     ; F158          lda MADDR
@15A 85 6A     ; F15A          sta MREGS
@15C A5 65     ; F15C          lda MADDR+1
@15E 85 6B     ; F15E          sta MREGS+1
@160 A0 02     ; F160          ldy #2
@162 84 66     ; F162  @field: sty MEND
@164 20 32 F2  ; F164          jsr hex2
@167 B0 1A     ; F167          bcs @bad
@169 A4 66     ; F169          ldy MEND
@16B A5 68     ; F16B          lda MBYTE
@16D 99 6A 00  ; F16D          sta MREGS,y
@170 C8        ; F170          iny
@171 C0 07     ; F171          cpy #7
@173 D0 ED     ; F173          bne @field
@175 A0 06     ; F175          ldy #6
@177 B9 6A 00  ; F177  @keep:  lda MREGS,y
@17A 99 50 03  ; F17A          sta SAVED,y
@17D 88        ; F17D          dey
@17E 10 F7     ; F17E          bpl @keep
@180 4C 65 F0  ; F180          jmp mloop
@183 4C B5 F0  ; F183  @bad:   jmp mbad

; ; .G [aaaa]: the saved registers and SP, then RTI to the PC.
@186 20 11 F2  ; F186  mgo:    jsr mspace
@189 BD 00 02  ; F189          lda LINBUF,x
@18C F0 0F     ; F18C          beq @go
@18E 20 20 F2  ; F18E          jsr hex4
@191 B0 25     ; F191          bcs @bad
@193 A5 64     ; F193          lda MADDR
@195 8D 50 03  ; F195          sta SAVED
@198 A5 65     ; F198          lda MADDR+1
@19A 8D 51 03  ; F19A          sta SAVED+1
@19D 78        ; F19D  @go:    sei
@19E AE 56 03  ; F19E          ldx SAVED+6
@1A1 9A        ; F1A1          txs
@1A2 AD 51 03  ; F1A2          lda SAVED+1
@1A5 48        ; F1A5          pha
@1A6 AD 50 03  ; F1A6          lda SAVED
@1A9 48        ; F1A9          pha
@1AA AD 52 03  ; F1AA          lda SAVED+2
@1AD 48        ; F1AD          pha
@1AE AC 55 03  ; F1AE          ldy SAVED+5
@1B1 AE 54 03  ; F1B1          ldx SAVED+4
@1B4 AD 53 03  ; F1B4          lda SAVED+3
@1B7 40        ; F1B7          rti
@1B8 4C B5 F0  ; F1B8  @bad:   jmp mbad

; ; The header and the .; row.
@1BB A2 00     ; F1BB  regs:   ldx #0
@1BD BD FA F1  ; F1BD  @head:  lda regtext,x
@1C0 F0 06     ; F1C0          beq @row
@1C2 20 03 E0  ; F1C2          jsr EDPRINT
@1C5 E8        ; F1C5          inx
@1C6 D0 F5     ; F1C6          bne @head
@1C8 A9 2E     ; F1C8  @row:   lda #'.'
@1CA 20 03 E0  ; F1CA          jsr EDPRINT
@1CD A9 3B     ; F1CD          lda #';'
@1CF 20 03 E0  ; F1CF          jsr EDPRINT
@1D2 A9 20     ; F1D2          lda #' '
@1D4 20 03 E0  ; F1D4          jsr EDPRINT
@1D7 AD 51 03  ; F1D7          lda SAVED+1
@1DA 20 77 F2  ; F1DA          jsr hexout
@1DD AD 50 03  ; F1DD          lda SAVED
@1E0 20 77 F2  ; F1E0          jsr hexout
@1E3 A2 02     ; F1E3          ldx #2
@1E5 A9 20     ; F1E5  @reg:   lda #' '
@1E7 20 03 E0  ; F1E7          jsr EDPRINT
@1EA BD 50 03  ; F1EA          lda SAVED,x
@1ED 20 77 F2  ; F1ED          jsr hexout
@1F0 E8        ; F1F0          inx
@1F1 E0 07     ; F1F1          cpx #7
@1F3 D0 F0     ; F1F3          bne @reg
@1F5 A9 0D     ; F1F5          lda #$0D
@1F7 4C 03 E0  ; F1F7          jmp EDPRINT

; regtext:
@1FA 20 20 20 50 43 20 20 53 52 20 41 43 20 58 52 20  ; F1FA          .byte "   PC  SR AC XR YR SP", $0D, 0
@20A 59 52 20 53 50 0D 00

; ; Spaces in LINBUF from MX skipped; X = MX.
@211 A6 69     ; F211  mspace: ldx MX
@213 BD 00 02  ; F213  @loop:  lda LINBUF,x
@216 C9 20     ; F216          cmp #' '
@218 D0 03     ; F218          bne @done
@21A E8        ; F21A          inx
@21B D0 F6     ; F21B          bne @loop
@21D 86 69     ; F21D  @done:  stx MX
@21F 60        ; F21F          rts

; ; Exactly 4 hex digits after spaces into MADDR (high first): carry set if not.
@220 20 32 F2  ; F220  hex4:   jsr hex2
@223 B0 0C     ; F223          bcs @bad
@225 A5 68     ; F225          lda MBYTE
@227 85 65     ; F227          sta MADDR+1
@229 20 3D F2  ; F229          jsr digits      ; the low byte follows with no space
@22C B0 03     ; F22C          bcs @bad
@22E 85 64     ; F22E          sta MADDR
@230 18        ; F230          clc
@231 60        ; F231  @bad:   rts

; ; Exactly 2 hex digits after spaces into MBYTE: carry set if not.
@232 20 11 F2  ; F232  hex2:   jsr mspace
@235 20 3D F2  ; F235          jsr digits
@238 B0 02     ; F238          bcs @bad
@23A 85 68     ; F23A          sta MBYTE
@23C 60        ; F23C  @bad:   rts

; ; Two hex digits at MX into A, MX past them; carry set if not.
@23D A6 69     ; F23D  digits: ldx MX
@23F BD 00 02  ; F23F          lda LINBUF,x
@242 20 5D F2  ; F242          jsr nibble
@245 B0 15     ; F245          bcs @bad
@247 0A        ; F247          asl
@248 0A        ; F248          asl
@249 0A        ; F249          asl
@24A 0A        ; F24A          asl
@24B 85 71     ; F24B          sta MTMP
@24D E8        ; F24D          inx
@24E BD 00 02  ; F24E          lda LINBUF,x
@251 20 5D F2  ; F251          jsr nibble
@254 B0 06     ; F254          bcs @bad
@256 05 71     ; F256          ora MTMP
@258 E8        ; F258          inx
@259 86 69     ; F259          stx MX
@25B 18        ; F25B          clc
@25C 60        ; F25C  @bad:   rts

@25D C9 30     ; F25D  nibble: cmp #'0'
@25F 90 14     ; F25F          bcc @bad
@261 C9 3A     ; F261          cmp #'9'+1
@263 90 0C     ; F263          bcc @digit
@265 C9 41     ; F265          cmp #'A'
@267 90 0C     ; F267          bcc @bad
@269 C9 47     ; F269          cmp #'F'+1
@26B B0 08     ; F26B          bcs @bad
@26D E9 36     ; F26D          sbc #'A'-10-1   ; carry clear here
@26F 18        ; F26F          clc
@270 60        ; F270          rts
@271 29 0F     ; F271  @digit: and #$0F
@273 18        ; F273          clc
@274 60        ; F274          rts
@275 38        ; F275  @bad:   sec
@276 60        ; F276          rts

; ; A as two hex digits.
@277 48        ; F277  hexout: pha
@278 4A        ; F278          lsr
@279 4A        ; F279          lsr
@27A 4A        ; F27A          lsr
@27B 4A        ; F27B          lsr
@27C 20 82 F2  ; F27C          jsr @nib
@27F 68        ; F27F          pla
@280 29 0F     ; F280          and #$0F
@282 C9 0A     ; F282  @nib:   cmp #10
@284 90 05     ; F284          bcc @d
@286 69 36     ; F286          adc #'A'-10-1   ; carry set here
@288 4C 03 E0  ; F288          jmp EDPRINT
@28B 09 30     ; F28B  @d:     ora #'0'
@28D 4C 03 E0  ; F28D          jmp EDPRINT

;         .org $F7FF
@7FF 29        ; F7FF          .checksum $F000, $800

; ; --- UH7: reset, interrupts, the self-test -------------------------------------------------------

;         .org $F800
@800 4C F9 F8  ; F800          jmp selftest
@803 4C 06 F8  ; F803          jmp reset

@806 78        ; F806  reset:  sei
@807 D8        ; F807          cld
@808 A2 FF     ; F808          ldx #$FF
@80A 9A        ; F80A          txs
@80B A9 0C     ; F80B          lda #$0C        ; VIA CA2 low: the character ROM's first half (upper case), as BASIC 1
@80D 8D 4C E8  ; F80D          sta VIAPCR
@810 A9 00     ; F810          lda #0          ; PIA1 port A: PA0-PA3 the keyboard row out, PA4-PA7 in (PA7 DIAG)
@812 8D 11 E8  ; F812          sta PIA1CRA
@815 A9 0F     ; F815          lda #$0F
@817 8D 10 E8  ; F817          sta PIA1PA
@81A A9 04     ; F81A          lda #$04
@81C 8D 11 E8  ; F81C          sta PIA1CRA
@81F A9 0F     ; F81F          lda #$0F
@821 8D 10 E8  ; F821          sta PIA1PA      ; no row selected
@824 A9 00     ; F824          lda #0          ; port B: the columns in; CB1 on its falling edge, interrupt off
@826 8D 13 E8  ; F826          sta PIA1CRB
@829 8D 12 E8  ; F829          sta PIA1PB
@82C A9 04     ; F82C          lda #$04
@82E 8D 13 E8  ; F82E          sta PIA1CRB
@831 AD 10 E8  ; F831          lda PIA1PA
@834 30 03     ; F834          bmi @basic
@836 4C F9 F8  ; F836          jmp selftest    ; DIAG low: no RAM touched yet

@839 A9 00     ; F839  @basic: lda #0
@83B A2 7F     ; F83B          ldx #$7F
@83D 95 00     ; F83D  @zp:    sta $00,x
@83F CA        ; F83F          dex
@840 10 FB     ; F840          bpl @zp
@842 A2 00     ; F842          ldx #0
@844 9D 00 02  ; F844  @pages: sta $0200,x
@847 9D 00 03  ; F847          sta $0300,x
@84A E8        ; F84A          inx
@84B D0 F7     ; F84B          bne @pages

@84D A9 00     ; F84D          lda #<PROGRAM   ; size the RAM
@84F 85 62     ; F84F          sta PTR
@851 A9 04     ; F851          lda #>PROGRAM
@853 85 63     ; F853          sta PTR+1
@855 A0 00     ; F855          ldy #0
@857 A9 55     ; F857  @size:  lda #$55
@859 91 62     ; F859          sta (PTR),y
@85B D1 62     ; F85B          cmp (PTR),y
@85D D0 14     ; F85D          bne @top
@85F A9 AA     ; F85F          lda #$AA
@861 91 62     ; F861          sta (PTR),y
@863 D1 62     ; F863          cmp (PTR),y
@865 D0 0C     ; F865          bne @top
@867 E6 62     ; F867          inc PTR
@869 D0 EC     ; F869          bne @size
@86B E6 63     ; F86B          inc PTR+1
@86D A5 63     ; F86D          lda PTR+1
@86F C9 20     ; F86F          cmp #$20
@871 D0 E4     ; F871          bne @size
@873 A5 62     ; F873  @top:   lda PTR
@875 85 60     ; F875          sta MEMTOP
@877 A5 63     ; F877          lda PTR+1
@879 85 61     ; F879          sta MEMTOP+1

@87B 20 00 E0  ; F87B          jsr EDINIT
@87E A9 05     ; F87E          lda #$05        ; the retrace interrupt on
@880 8D 13 E8  ; F880          sta PIA1CRB
@883 58        ; F883          cli

@884 A2 00     ; F884          ldx #0
@886 BD B0 F8  ; F886  @title: lda banner,x
@889 F0 06     ; F889          beq @free
@88B 20 03 E0  ; F88B          jsr EDPRINT
@88E E8        ; F88E          inx
@88F D0 F5     ; F88F          bne @title
@891 38        ; F891  @free:  sec             ; MEMTOP - PROGRAM - 2: the bytes free
@892 A5 60     ; F892          lda MEMTOP
@894 E9 02     ; F894          sbc #<(PROGRAM+2)
@896 48        ; F896          pha
@897 A5 61     ; F897          lda MEMTOP+1
@899 E9 04     ; F899          sbc #>(PROGRAM+2)
@89B A8        ; F89B          tay
@89C 68        ; F89C          pla
@89D 20 06 C0  ; F89D          jsr NUMOUT
@8A0 A2 00     ; F8A0          ldx #0
@8A2 BD CD F8  ; F8A2  @bytes: lda freetext,x
@8A5 F0 06     ; F8A5          beq @cold
@8A7 20 03 E0  ; F8A7          jsr EDPRINT
@8AA E8        ; F8AA          inx
@8AB D0 F5     ; F8AB          bne @bytes
@8AD 4C 00 C0  ; F8AD  @cold:  jmp COLD

@8B0 2A 2A 2A 20 42 57 2D 32 30 30 31 20 54 49 4E 59  ; F8B0  banner: .byte "*** BW-2001 TINY BASIC ***", $0D, $0D, 0
@8C0 20 42 41 53 49 43 20 2A 2A 2A 0D 0D 00
; freetext:
@8CD 20 42 59 54 45 53 20 46 52 45 45 0D 0D 00  ; F8CD          .byte " BYTES FREE", $0D, $0D, 0

; ; IRQ: a BRK goes to the monitor with this handler's three bytes on the stack; the retrace (PIA1
; ; CRB bit 7) runs the editor's scan.
@8DB 48        ; F8DB  irq:    pha
@8DC 8A        ; F8DC          txa
@8DD 48        ; F8DD          pha
@8DE 98        ; F8DE          tya
@8DF 48        ; F8DF          pha
@8E0 BA        ; F8E0          tsx
@8E1 BD 04 01  ; F8E1          lda $0104,x     ; the P the 6502 pushed
@8E4 29 10     ; F8E4          and #$10
@8E6 F0 03     ; F8E6          beq @retrace
@8E8 4C 03 F0  ; F8E8          jmp MONBRK
; @retrace:
@8EB AD 13 E8  ; F8EB          lda PIA1CRB
@8EE 10 03     ; F8EE          bpl @done
@8F0 20 0F E0  ; F8F0          jsr EDIRQ
@8F3 68        ; F8F3  @done:  pla
@8F4 A8        ; F8F4          tay
@8F5 68        ; F8F5          pla
@8F6 AA        ; F8F6          tax
@8F7 68        ; F8F7          pla
@8F8 40        ; F8F8  nmi:    rti

; ; --- The self-test (spec "The self-test"; design §4.4) -------------------------------------------
; ;
; ; Interrupts off. Page 0 is tested with no RAM at all; then $00-$01 (PTR0) are the only RAM used
; ; until the whole RAM has passed: no stack, no JSR. Rows are written at fixed screen addresses,
; ; as screen codes (AND $3F maps $20-$5F). A RAM or video RAM failure stops on its row with the
; ; address and the bad bits; the three values wait in screen cells and the row in S (FAIL).
; ; After the RAM, the ROM sums and the key echo use the stack.

; PTR0    = $00           ; 2: the test's pointer
; ROWP    = $02           ; 2: after the RAM: a row's address
; SUM     = $04
; KEYIX   = $05
; CHIP    = $06
; PUTY    = $07           ; putch keeps Y here

; ROW2    = SCREEN+2*40   ; ZERO PAGE
; ROW3    = SCREEN+3*40   ; VIDEO RAM
; ROW4    = SCREEN+4*40   ; RAM
; ROW11   = SCREEN+11*40  ; KEY
; HEXZP   = ROW2+14-SCREEN ; where each failure's hex digits begin, as an offset in page $80
; HEXVID  = ROW3+14-SCREEN
; HEXRAM  = ROW4+8-SCREEN
; SCRATCH = $14           ; the three values wait here, after the digits: bits, low, high

; selftest:
@8F9 78        ; F8F9          sei
@8FA D8        ; F8FA          cld
@8FB A9 20     ; F8FB          lda #$20        ; a blank screen
@8FD A2 00     ; F8FD          ldx #0
@8FF 9D 00 80  ; F8FF  @clear: sta SCREEN+$000,x
@902 9D 00 81  ; F902          sta SCREEN+$100,x
@905 9D 00 82  ; F905          sta SCREEN+$200,x
@908 9D 00 83  ; F908          sta SCREEN+$300,x
@90B E8        ; F90B          inx
@90C D0 F1     ; F90C          bne @clear
@90E A2 00     ; F90E          ldx #0
@910 BD 1A FD  ; F910  @title: lda titletext,x
@913 F0 08     ; F913          beq @zp
@915 29 3F     ; F915          and #$3F
@917 9D 00 80  ; F917          sta SCREEN,x
@91A E8        ; F91A          inx
@91B D0 F3     ; F91B          bne @title

; ; Page 0, by zero page,X: no RAM used.
@91D A2 00     ; F91D  @zp:    ldx #0
@91F 8A        ; F91F  @zw1:   txa
@920 49 A5     ; F920          eor #$A5
@922 95 00     ; F922          sta $00,x
@924 E8        ; F924          inx
@925 D0 F8     ; F925          bne @zw1
@927 8A        ; F927  @zc1:   txa
@928 49 A5     ; F928          eor #$A5
@92A 55 00     ; F92A          eor $00,x
@92C D0 18     ; F92C          bne zpfail
@92E E8        ; F92E          inx
@92F D0 F6     ; F92F          bne @zc1
@931 8A        ; F931  @zw2:   txa
@932 49 5A     ; F932          eor #$5A
@934 95 00     ; F934          sta $00,x
@936 E8        ; F936          inx
@937 D0 F8     ; F937          bne @zw2
@939 8A        ; F939  @zc2:   txa
@93A 49 5A     ; F93A          eor #$5A
@93C 55 00     ; F93C          eor $00,x
@93E D0 06     ; F93E          bne zpfail
@940 E8        ; F940          inx
@941 D0 F6     ; F941          bne @zc2
@943 4C 66 F9  ; F943          jmp video

@946 8D 72 80  ; F946  zpfail: sta SCREEN+HEXZP+SCRATCH
@949 8E 73 80  ; F949          stx SCREEN+HEXZP+SCRATCH+1
@94C A9 00     ; F94C          lda #0
@94E 8D 74 80  ; F94E          sta SCREEN+HEXZP+SCRATCH+2
@951 A0 00     ; F951          ldy #0
@953 B9 39 FD  ; F953  @label: lda zpbadtext,y
@956 F0 08     ; F956          beq @go
@958 29 3F     ; F958          and #$3F
@95A 99 50 80  ; F95A          sta ROW2,y
@95D C8        ; F95D          iny
@95E D0 F3     ; F95E          bne @label
@960 A2 5E     ; F960  @go:    ldx #HEXZP
@962 9A        ; F962          txs
@963 4C 44 FB  ; F963          jmp fail

; ; The video RAM, $8000-$83FF: the whole range written, then compared, twice.
@966 A2 00     ; F966  video:  ldx #0
@968 BD 2C FD  ; F968  @zpok:  lda zpoktext,x
@96B F0 08     ; F96B          beq @pass1
@96D 29 3F     ; F96D          and #$3F
@96F 9D 50 80  ; F96F          sta ROW2,x
@972 E8        ; F972          inx
@973 D0 F3     ; F973          bne @zpok
@975 A9 00     ; F975  @pass1: lda #0
@977 85 00     ; F977          sta PTR0
@979 A9 80     ; F979          lda #>SCREEN
@97B 85 01     ; F97B          sta PTR0+1
@97D A0 00     ; F97D  @vw1:   ldy #0
@97F 98        ; F97F  @vw1b:  tya
@980 45 01     ; F980          eor PTR0+1
@982 49 A5     ; F982          eor #$A5
@984 91 00     ; F984          sta (PTR0),y
@986 C8        ; F986          iny
@987 D0 F6     ; F987          bne @vw1b
@989 E6 01     ; F989          inc PTR0+1
@98B A5 01     ; F98B          lda PTR0+1
@98D C9 84     ; F98D          cmp #>SCREEN+4
@98F D0 EC     ; F98F          bne @vw1
@991 A9 80     ; F991          lda #>SCREEN
@993 85 01     ; F993          sta PTR0+1
@995 A0 00     ; F995  @vc1:   ldy #0
@997 98        ; F997  @vc1b:  tya
@998 45 01     ; F998          eor PTR0+1
@99A 49 A5     ; F99A          eor #$A5
@99C 51 00     ; F99C          eor (PTR0),y
@99E D0 40     ; F99E          bne vfail
@9A0 C8        ; F9A0          iny
@9A1 D0 F4     ; F9A1          bne @vc1b
@9A3 E6 01     ; F9A3          inc PTR0+1
@9A5 A5 01     ; F9A5          lda PTR0+1
@9A7 C9 84     ; F9A7          cmp #>SCREEN+4
@9A9 D0 EA     ; F9A9          bne @vc1
@9AB A9 80     ; F9AB          lda #>SCREEN
@9AD 85 01     ; F9AD          sta PTR0+1
@9AF A0 00     ; F9AF  @vw2:   ldy #0
@9B1 98        ; F9B1  @vw2b:  tya
@9B2 45 01     ; F9B2          eor PTR0+1
@9B4 49 5A     ; F9B4          eor #$5A
@9B6 91 00     ; F9B6          sta (PTR0),y
@9B8 C8        ; F9B8          iny
@9B9 D0 F6     ; F9B9          bne @vw2b
@9BB E6 01     ; F9BB          inc PTR0+1
@9BD A5 01     ; F9BD          lda PTR0+1
@9BF C9 84     ; F9BF          cmp #>SCREEN+4
@9C1 D0 EC     ; F9C1          bne @vw2
@9C3 A9 80     ; F9C3          lda #>SCREEN
@9C5 85 01     ; F9C5          sta PTR0+1
@9C7 A0 00     ; F9C7  @vc2:   ldy #0
@9C9 98        ; F9C9  @vc2b:  tya
@9CA 45 01     ; F9CA          eor PTR0+1
@9CC 49 5A     ; F9CC          eor #$5A
@9CE 51 00     ; F9CE          eor (PTR0),y
@9D0 D0 0E     ; F9D0          bne vfail
@9D2 C8        ; F9D2          iny
@9D3 D0 F4     ; F9D3          bne @vc2b
@9D5 E6 01     ; F9D5          inc PTR0+1
@9D7 A5 01     ; F9D7          lda PTR0+1
@9D9 C9 84     ; F9D9          cmp #>SCREEN+4
@9DB D0 EA     ; F9DB          bne @vc2
@9DD 4C 37 FA  ; F9DD          jmp vpassed

; ; The bad bits in A, the address PTR0+1:Y. The screen is cleared first (the bits wait in $00,
; ; the low byte in X), then the rows written again.
@9E0 85 00     ; F9E0  vfail:  sta PTR0
@9E2 98        ; F9E2          tya
@9E3 AA        ; F9E3          tax
@9E4 A9 20     ; F9E4          lda #$20
@9E6 A0 00     ; F9E6          ldy #0
@9E8 99 00 80  ; F9E8  @clear: sta SCREEN+$000,y
@9EB 99 00 81  ; F9EB          sta SCREEN+$100,y
@9EE 99 00 82  ; F9EE          sta SCREEN+$200,y
@9F1 99 00 83  ; F9F1          sta SCREEN+$300,y
@9F4 C8        ; F9F4          iny
@9F5 D0 F1     ; F9F5          bne @clear
@9F7 A5 00     ; F9F7          lda PTR0
@9F9 8D 9A 80  ; F9F9          sta SCREEN+HEXVID+SCRATCH
@9FC 8E 9B 80  ; F9FC          stx SCREEN+HEXVID+SCRATCH+1
@9FF A5 01     ; F9FF          lda PTR0+1
@A01 8D 9C 80  ; FA01          sta SCREEN+HEXVID+SCRATCH+2
@A04 A0 00     ; FA04          ldy #0
@A06 B9 1A FD  ; FA06  @title: lda titletext,y
@A09 F0 08     ; FA09          beq @zpok
@A0B 29 3F     ; FA0B          and #$3F
@A0D 99 00 80  ; FA0D          sta SCREEN,y
@A10 C8        ; FA10          iny
@A11 D0 F3     ; FA11          bne @title
@A13 A0 00     ; FA13  @zpok:  ldy #0
@A15 B9 2C FD  ; FA15  @zp:    lda zpoktext,y
@A18 F0 08     ; FA18          beq @label
@A1A 29 3F     ; FA1A          and #$3F
@A1C 99 50 80  ; FA1C          sta ROW2,y
@A1F C8        ; FA1F          iny
@A20 D0 F3     ; FA20          bne @zp
@A22 A0 00     ; FA22  @label: ldy #0
@A24 B9 55 FD  ; FA24  @l:     lda vidbadtext,y
@A27 F0 08     ; FA27          beq @go
@A29 29 3F     ; FA29          and #$3F
@A2B 99 78 80  ; FA2B          sta ROW3,y
@A2E C8        ; FA2E          iny
@A2F D0 F3     ; FA2F          bne @l
@A31 A2 86     ; FA31  @go:    ldx #HEXVID
@A33 9A        ; FA33          txs
@A34 4C 44 FB  ; FA34          jmp fail

; vpassed:
@A37 A9 20     ; FA37          lda #$20
@A39 A2 00     ; FA39          ldx #0
@A3B 9D 00 80  ; FA3B  @clear: sta SCREEN+$000,x
@A3E 9D 00 81  ; FA3E          sta SCREEN+$100,x
@A41 9D 00 82  ; FA41          sta SCREEN+$200,x
@A44 9D 00 83  ; FA44          sta SCREEN+$300,x
@A47 E8        ; FA47          inx
@A48 D0 F1     ; FA48          bne @clear
@A4A BD 1A FD  ; FA4A  @title: lda titletext,x
@A4D F0 08     ; FA4D          beq @zp
@A4F 29 3F     ; FA4F          and #$3F
@A51 9D 00 80  ; FA51          sta SCREEN,x
@A54 E8        ; FA54          inx
@A55 D0 F3     ; FA55          bne @title
@A57 A2 00     ; FA57  @zp:    ldx #0
@A59 BD 2C FD  ; FA59  @zpok:  lda zpoktext,x
@A5C F0 08     ; FA5C          beq @vid
@A5E 29 3F     ; FA5E          and #$3F
@A60 9D 50 80  ; FA60          sta ROW2,x
@A63 E8        ; FA63          inx
@A64 D0 F3     ; FA64          bne @zpok
@A66 A2 00     ; FA66  @vid:   ldx #0
@A68 BD 48 FD  ; FA68  @vidok: lda vidoktext,x
@A6B F0 08     ; FA6B          beq ram
@A6D 29 3F     ; FA6D          and #$3F
@A6F 9D 78 80  ; FA6F          sta ROW3,x
@A72 E8        ; FA72          inx
@A73 D0 F3     ; FA73          bne @vidok

; ; The RAM, $0002-$1FFF: written whole (page 0 by zero page,X), then compared whole, twice.
@A75 A2 02     ; FA75  ram:    ldx #2
@A77 8A        ; FA77  @w0a:   txa
@A78 49 A5     ; FA78          eor #$A5
@A7A 95 00     ; FA7A          sta $00,x
@A7C E8        ; FA7C          inx
@A7D D0 F8     ; FA7D          bne @w0a
@A7F 86 00     ; FA7F          stx PTR0
@A81 A9 01     ; FA81          lda #1
@A83 85 01     ; FA83          sta PTR0+1
@A85 A0 00     ; FA85  @wpa:   ldy #0
@A87 98        ; FA87  @wba:   tya
@A88 45 01     ; FA88          eor PTR0+1
@A8A 49 A5     ; FA8A          eor #$A5
@A8C 91 00     ; FA8C          sta (PTR0),y
@A8E C8        ; FA8E          iny
@A8F D0 F6     ; FA8F          bne @wba
@A91 E6 01     ; FA91          inc PTR0+1
@A93 A5 01     ; FA93          lda PTR0+1
@A95 C9 20     ; FA95          cmp #$20
@A97 D0 EC     ; FA97          bne @wpa
@A99 A2 02     ; FA99          ldx #2
@A9B 8A        ; FA9B  @c0a:   txa
@A9C 49 A5     ; FA9C          eor #$A5
@A9E 55 00     ; FA9E          eor $00,x
@AA0 F0 03     ; FAA0          beq @c0an
@AA2 4C 16 FB  ; FAA2          jmp rfail0
@AA5 E8        ; FAA5  @c0an:  inx
@AA6 D0 F3     ; FAA6          bne @c0a
@AA8 A9 01     ; FAA8          lda #1
@AAA 85 01     ; FAAA          sta PTR0+1
@AAC A0 00     ; FAAC  @cpa:   ldy #0
@AAE 98        ; FAAE  @cba:   tya
@AAF 45 01     ; FAAF          eor PTR0+1
@AB1 49 A5     ; FAB1          eor #$A5
@AB3 51 00     ; FAB3          eor (PTR0),y
@AB5 F0 03     ; FAB5          beq @cban
@AB7 4C 24 FB  ; FAB7          jmp rfail
@ABA C8        ; FABA  @cban:  iny
@ABB D0 F1     ; FABB          bne @cba
@ABD E6 01     ; FABD          inc PTR0+1
@ABF A5 01     ; FABF          lda PTR0+1
@AC1 C9 20     ; FAC1          cmp #$20
@AC3 D0 E7     ; FAC3          bne @cpa

@AC5 A2 02     ; FAC5          ldx #2
@AC7 8A        ; FAC7  @w0b:   txa
@AC8 49 5A     ; FAC8          eor #$5A
@ACA 95 00     ; FACA          sta $00,x
@ACC E8        ; FACC          inx
@ACD D0 F8     ; FACD          bne @w0b
@ACF A9 01     ; FACF          lda #1
@AD1 85 01     ; FAD1          sta PTR0+1
@AD3 A0 00     ; FAD3  @wpb:   ldy #0
@AD5 98        ; FAD5  @wbb:   tya
@AD6 45 01     ; FAD6          eor PTR0+1
@AD8 49 5A     ; FAD8          eor #$5A
@ADA 91 00     ; FADA          sta (PTR0),y
@ADC C8        ; FADC          iny
@ADD D0 F6     ; FADD          bne @wbb
@ADF E6 01     ; FADF          inc PTR0+1
@AE1 A5 01     ; FAE1          lda PTR0+1
@AE3 C9 20     ; FAE3          cmp #$20
@AE5 D0 EC     ; FAE5          bne @wpb
@AE7 A2 02     ; FAE7          ldx #2
@AE9 8A        ; FAE9  @c0b:   txa
@AEA 49 5A     ; FAEA          eor #$5A
@AEC 55 00     ; FAEC          eor $00,x
@AEE F0 03     ; FAEE          beq @c0bn
@AF0 4C 16 FB  ; FAF0          jmp rfail0
@AF3 E8        ; FAF3  @c0bn:  inx
@AF4 D0 F3     ; FAF4          bne @c0b
@AF6 A9 01     ; FAF6          lda #1
@AF8 85 01     ; FAF8          sta PTR0+1
@AFA A0 00     ; FAFA  @cpb:   ldy #0
@AFC 98        ; FAFC  @cbb:   tya
@AFD 45 01     ; FAFD          eor PTR0+1
@AFF 49 5A     ; FAFF          eor #$5A
@B01 51 00     ; FB01          eor (PTR0),y
@B03 F0 03     ; FB03          beq @cbbn
@B05 4C 24 FB  ; FB05          jmp rfail
@B08 C8        ; FB08  @cbbn:  iny
@B09 D0 F1     ; FB09          bne @cbb
@B0B E6 01     ; FB0B          inc PTR0+1
@B0D A5 01     ; FB0D          lda PTR0+1
@B0F C9 20     ; FB0F          cmp #$20
@B11 D0 E7     ; FB11          bne @cpb
@B13 4C C5 FB  ; FB13          jmp rampassed

@B16 8D BC 80  ; FB16  rfail0: sta SCREEN+HEXRAM+SCRATCH
@B19 8E BD 80  ; FB19          stx SCREEN+HEXRAM+SCRATCH+1
@B1C A9 00     ; FB1C          lda #0
@B1E 8D BE 80  ; FB1E          sta SCREEN+HEXRAM+SCRATCH+2
@B21 4C 2F FB  ; FB21          jmp rlabel
@B24 8D BC 80  ; FB24  rfail:  sta SCREEN+HEXRAM+SCRATCH

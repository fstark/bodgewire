@B36 C8        ; FB36          iny
@B37 D0 F3     ; FB37          bne @l
@B39 A2 A8     ; FB39  @go:    ldx #HEXRAM
@B3B 9A        ; FB3B          txs
@B3C 4C 3F FB  ; FB3C          jmp fail

; ; A failure's row: S its digits' offset in page $80, the bits, low and high bytes waiting in
; ; the cells SCRATCH beyond. The digits written, the cells blanked, and here it stays.
@B3F BA        ; FB3F  fail:   tsx
@B40 BD 16 80  ; FB40          lda SCREEN+SCRATCH+2,x
@B43 4A        ; FB43          lsr
@B44 4A        ; FB44          lsr
@B45 4A        ; FB45          lsr
@B46 4A        ; FB46          lsr

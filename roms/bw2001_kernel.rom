@B4B 69 06     ; FB4B          adc #6
@B4D 69 30     ; FB4D  @h1:    adc #'0'
@B4F 29 3F     ; FB4F          and #$3F
@B51 9D 00 80  ; FB51          sta SCREEN,x
@B54 BD 16 80  ; FB54          lda SCREEN+SCRATCH+2,x
@B57 29 0F     ; FB57          and #$0F
@B59 C9 0A     ; FB59          cmp #10
@B5B 90 02     ; FB5B          bcc @h2
@B5D 69 06     ; FB5D          adc #6
@B5F 69 30     ; FB5F  @h2:    adc #'0'
@B61 29 3F     ; FB61          and #$3F
@B63 9D 01 80  ; FB63          sta SCREEN+1,x
@B66 BD 15 80  ; FB66          lda SCREEN+SCRATCH+1,x
@B69 4A        ; FB69          lsr
@B6A 4A        ; FB6A          lsr
@B6B 4A        ; FB6B          lsr
@B6C 4A        ; FB6C          lsr
@B6D C9 0A     ; FB6D          cmp #10
@B6F 90 02     ; FB6F          bcc @h3
@B71 69 06     ; FB71          adc #6
@B73 69 30     ; FB73  @h3:    adc #'0'
@B75 29 3F     ; FB75          and #$3F
@B77 9D 02 80  ; FB77          sta SCREEN+2,x
@B7A BD 15 80  ; FB7A          lda SCREEN+SCRATCH+1,x
@B7D 29 0F     ; FB7D          and #$0F
@B7F C9 0A     ; FB7F          cmp #10
@B81 90 02     ; FB81          bcc @h4
@B83 69 06     ; FB83          adc #6
@B85 69 30     ; FB85  @h4:    adc #'0'
@B87 29 3F     ; FB87          and #$3F
@B89 9D 03 80  ; FB89          sta SCREEN+3,x
@B8C BD 14 80  ; FB8C          lda SCREEN+SCRATCH,x
@B8F 4A        ; FB8F          lsr
@B90 4A        ; FB90          lsr
@B91 4A        ; FB91          lsr
@B92 4A        ; FB92          lsr
@B93 C9 0A     ; FB93          cmp #10
@B95 90 02     ; FB95          bcc @h5
@B97 69 06     ; FB97          adc #6
@B99 69 30     ; FB99  @h5:    adc #'0'
@B9B 29 3F     ; FB9B          and #$3F
@B9D 9D 05 80  ; FB9D          sta SCREEN+5,x
@BA0 BD 14 80  ; FBA0          lda SCREEN+SCRATCH,x
@BA3 29 0F     ; FBA3          and #$0F
@BA5 C9 0A     ; FBA5          cmp #10
@BA7 90 02     ; FBA7          bcc @h6
@BA9 69 06     ; FBA9          adc #6
@BAB 69 30     ; FBAB  @h6:    adc #'0'
@BAD 29 3F     ; FBAD          and #$3F
@BAF 9D 06 80  ; FBAF          sta SCREEN+6,x
@BB2 A9 20     ; FBB2          lda #$20
@BB4 9D 14 80  ; FBB4          sta SCREEN+SCRATCH,x
@BB7 9D 15 80  ; FBB7          sta SCREEN+SCRATCH+1,x
@BBA 9D 16 80  ; FBBA          sta SCREEN+SCRATCH+2,x
@BBD 4C BD FB  ; FBBD  @hang:  jmp @hang

; ; The RAM is good: the stack and JSR from here.
; rampassed:
@BC0 A2 FF     ; FBC0          ldx #$FF
@BC2 9A        ; FBC2          txs
@BC3 A9 A0     ; FBC3          lda #<ROW4
@BC5 85 02     ; FBC5          sta ROWP
@BC7 A9 80     ; FBC7          lda #>ROW4
@BC9 85 03     ; FBC9          sta ROWP+1
@BCB A2 5F     ; FBCB          ldx #<ramoktext
@BCD A0 FD     ; FBCD          ldy #>ramoktext
@BCF 20 CE FC  ; FBCF          jsr putstr
@BD2 A2 00     ; FBD2          ldx #0
@BD4 86 06     ; FBD4  @chip:  stx CHIP
@BD6 BD 0B FD  ; FBD6          lda romrowlo,x  ; ROWP = row 5 + CHIP
@BD9 85 02     ; FBD9          sta ROWP
@BDB BD 10 FD  ; FBDB          lda romrowhi,x
@BDE 85 03     ; FBDE          sta ROWP+1
@BE0 A9 00     ; FBE0          lda #0
@BE2 85 00     ; FBE2          sta PTR0
@BE4 85 04     ; FBE4          sta SUM
@BE6 BD 06 FD  ; FBE6          lda rompages,x
@BE9 85 01     ; FBE9          sta PTR0+1
@BEB A2 08     ; FBEB          ldx #8          ; 2048 bytes
@BED A0 00     ; FBED  @page:  ldy #0
@BEF 18        ; FBEF  @byte:  clc
@BF0 A5 04     ; FBF0          lda SUM
@BF2 71 00     ; FBF2          adc (PTR0),y
@BF4 85 04     ; FBF4          sta SUM
@BF6 C8        ; FBF6          iny
@BF7 D0 F6     ; FBF7          bne @byte
@BF9 E6 01     ; FBF9          inc PTR0+1
@BFB CA        ; FBFB          dex
@BFC D0 EF     ; FBFC          bne @page
@BFE A2 6F     ; FBFE          ldx #<romtext
@C00 A0 FD     ; FC00          ldy #>romtext
@C02 20 CE FC  ; FC02          jsr putstr
@C05 A6 06     ; FC05          ldx CHIP
@C07 BD 06 FD  ; FC07          lda rompages,x
@C0A 20 F0 FC  ; FC0A          jsr puthex
@C0D A9 00     ; FC0D          lda #0
@C0F 20 F0 FC  ; FC0F          jsr puthex
@C12 A5 04     ; FC12          lda SUM
@C14 D0 0A     ; FC14          bne @bad
@C16 A2 74     ; FC16          ldx #<oktext
@C18 A0 FD     ; FC18          ldy #>oktext
@C1A 20 CE FC  ; FC1A          jsr putstr
@C1D 4C 2C FC  ; FC1D          jmp @next
@C20 A2 78     ; FC20  @bad:   ldx #<badtext
@C22 A0 FD     ; FC22          ldy #>badtext
@C24 20 CE FC  ; FC24          jsr putstr
@C27 A5 04     ; FC27          lda SUM
@C29 20 F0 FC  ; FC29          jsr puthex
@C2C A6 06     ; FC2C  @next:  ldx CHIP
@C2E E8        ; FC2E          inx
@C2F E0 05     ; FC2F          cpx #ROMCHIPS
@C31 D0 A1     ; FC31          bne @chip

; ; The keyboard: the first held key in scan order, its row, column and legend, forever.
@C33 A9 B8     ; FC33  keys:   lda #<ROW11
@C35 85 02     ; FC35          sta ROWP
@C37 A9 81     ; FC37          lda #>ROW11
@C39 85 03     ; FC39          sta ROWP+1
@C3B A9 FF     ; FC3B          lda #$FF
@C3D 85 05     ; FC3D          sta KEYIX
@C3F A2 00     ; FC3F          ldx #0
@C41 8E 10 E8  ; FC41  @row:   stx PIA1PA
@C44 AD 12 E8  ; FC44          lda PIA1PB
@C47 A0 00     ; FC47          ldy #0
@C49 4A        ; FC49  @bit:   lsr
@C4A B0 12     ; FC4A          bcs @up
@C4C 48        ; FC4C          pha
@C4D A5 05     ; FC4D          lda KEYIX
@C4F C9 FF     ; FC4F          cmp #$FF
@C51 D0 0A     ; FC51          bne @have
@C53 8A        ; FC53          txa
@C54 0A        ; FC54          asl
@C55 0A        ; FC55          asl
@C56 0A        ; FC56          asl
@C57 84 04     ; FC57          sty SUM
@C59 05 04     ; FC59          ora SUM
@C5B 85 05     ; FC5B          sta KEYIX
@C5D 68        ; FC5D  @have:  pla
@C5E C8        ; FC5E  @up:    iny
@C5F C0 08     ; FC5F          cpy #8
@C61 D0 E6     ; FC61          bne @bit
@C63 E8        ; FC63          inx
@C64 E0 0A     ; FC64          cpx #10
@C66 D0 D9     ; FC66          bne @row
@C68 A9 0F     ; FC68          lda #$0F
@C6A 8D 10 E8  ; FC6A          sta PIA1PA
@C6D A2 7E     ; FC6D          ldx #<keytext
@C6F A0 FD     ; FC6F          ldy #>keytext
@C71 20 CE FC  ; FC71          jsr putstr
@C74 A5 05     ; FC74          lda KEYIX
@C76 C9 FF     ; FC76          cmp #$FF
@C78 F0 43     ; FC78          beq @blank
@C7A 4A        ; FC7A          lsr
@C7B 4A        ; FC7B          lsr
@C7C 4A        ; FC7C          lsr
@C7D 09 30     ; FC7D          ora #'0'
@C7F 20 DF FC  ; FC7F          jsr putch
@C82 A5 05     ; FC82          lda KEYIX
@C84 29 07     ; FC84          and #7
@C86 09 30     ; FC86          ora #'0'
@C88 20 DF FC  ; FC88          jsr putch
@C8B A9 20     ; FC8B          lda #' '
@C8D 20 DF FC  ; FC8D          jsr putch
@C90 A6 05     ; FC90          ldx KEYIX
@C92 BD 83 FD  ; FC92          lda legends,x
@C95 30 06     ; FC95          bmi @name
@C97 20 DF FC  ; FC97          jsr putch
@C9A 4C BD FC  ; FC9A          jmp @blank
@C9D 29 7F     ; FC9D  @name:  and #$7F
@C9F AA        ; FC9F          tax
@CA0 A0 00     ; FCA0          ldy #0
@CA2 E0 00     ; FCA2  @find:  cpx #0
@CA4 F0 0C     ; FCA4          beq @print
@CA6 B9 D3 FD  ; FCA6  @skip:  lda names,y
@CA9 C8        ; FCA9          iny
@CAA C9 00     ; FCAA          cmp #0
@CAC D0 F8     ; FCAC          bne @skip
@CAE CA        ; FCAE          dex
@CAF 4C A2 FC  ; FCAF          jmp @find
@CB2 B9 D3 FD  ; FCB2  @print: lda names,y
@CB5 F0 06     ; FCB5          beq @blank
@CB7 20 DF FC  ; FCB7          jsr putch
@CBA C8        ; FCBA          iny
@CBB D0 F5     ; FCBB          bne @print
@CBD A6 02     ; FCBD  @blank: ldx ROWP        ; the rest of the row blank: row 11 lies in page $81 ($81B8-$81DF)
@CBF A9 20     ; FCBF          lda #$20
@CC1 E0 CC     ; FCC1  @b:     cpx #<ROW11+20
@CC3 F0 06     ; FCC3          beq @again
@CC5 9D 00 81  ; FCC5          sta $8100,x
@CC8 E8        ; FCC8          inx
@CC9 D0 F6     ; FCC9          bne @b
@CCB 4C 33 FC  ; FCCB  @again: jmp keys

; ; The text at X (low), Y (high) at ROWP, ROWP moving on.
@CCE 86 00     ; FCCE  putstr: stx PTR0
@CD0 84 01     ; FCD0          sty PTR0+1
@CD2 A0 00     ; FCD2          ldy #0
@CD4 B1 00     ; FCD4  @loop:  lda (PTR0),y
@CD6 F0 06     ; FCD6          beq @done
@CD8 20 DF FC  ; FCD8          jsr putch
@CDB C8        ; FCDB          iny
@CDC D0 F6     ; FCDC          bne @loop
@CDE 60        ; FCDE  @done:  rts

; ; A at ROWP as a screen code, ROWP + 1; X, Y kept.
@CDF 84 07     ; FCDF  putch:  sty PUTY
@CE1 A0 00     ; FCE1          ldy #0
@CE3 29 3F     ; FCE3          and #$3F
@CE5 91 02     ; FCE5          sta (ROWP),y
@CE7 E6 02     ; FCE7          inc ROWP
@CE9 D0 02     ; FCE9          bne @done
@CEB E6 03     ; FCEB          inc ROWP+1
@CED A4 07     ; FCED  @done:  ldy PUTY
@CEF 60        ; FCEF          rts

@CF0 48        ; FCF0  puthex: pha
@CF1 4A        ; FCF1          lsr
@CF2 4A        ; FCF2          lsr
@CF3 4A        ; FCF3          lsr
@CF4 4A        ; FCF4          lsr
@CF5 20 FB FC  ; FCF5          jsr @nib
@CF8 68        ; FCF8          pla
@CF9 29 0F     ; FCF9          and #$0F
@CFB C9 0A     ; FCFB  @nib:   cmp #10
@CFD 90 02     ; FCFD          bcc @d
@CFF 69 06     ; FCFF          adc #6
@D01 69 30     ; FD01  @d:     adc #'0'
@D03 4C DF FC  ; FD03          jmp putch

; ROMCHIPS = 5
; rompages:
@D06 C0 C8 E0 F0 F8  ; FD06          .byte $C0, $C8, $E0, $F0, $F8
; romrowlo:
@D0B C8 F0 18 40 68  ; FD0B          .byte <(SCREEN+5*40), <(SCREEN+6*40), <(SCREEN+7*40), <(SCREEN+8*40), <(SCREEN+9*40)
; romrowhi:
@D10 80 80 81 81 81  ; FD10          .byte >(SCREEN+5*40), >(SCREEN+6*40), >(SCREEN+7*40), >(SCREEN+8*40), >(SCREEN+9*40)

; titletext:
@D15 42 57 2D 32 30 30 31 20 53 45 4C 46 2D 54 45 53  ; FD15          .byte "BW-2001 SELF-TEST", 0
@D25 54 00
; zpoktext:
@D27 5A 45 52 4F 20 50 41 47 45 20 4F 4B 00  ; FD27          .byte "ZERO PAGE OK", 0
; zpbadtext:
@D34 5A 45 52 4F 20 50 41 47 45 20 42 41 44 20 00  ; FD34          .byte "ZERO PAGE BAD ", 0
; vidoktext:
@D43 56 49 44 45 4F 20 52 41 4D 20 4F 4B 00  ; FD43          .byte "VIDEO RAM OK", 0
; vidbadtext:
@D50 56 49 44 45 4F 20 52 41 4D 20 42 41 44 20 00  ; FD50          .byte "VIDEO RAM BAD ", 0
; ramoktext:
@D5F 52 41 4D 20 4F 4B 00  ; FD5F          .byte "RAM OK", 0
; rambadtext:
@D66 52 41 4D 20 42 41 44 20 00  ; FD66          .byte "RAM BAD ", 0
; romtext:
@D6F 52 4F 4D 20 00  ; FD6F          .byte "ROM ", 0
@D74 20 4F 4B 00  ; FD74  oktext: .byte " OK", 0
; badtext:
@D78 20 42 41 44 20 00  ; FD78          .byte " BAD ", 0
; keytext:
@D7E 4B 45 59 20 00  ; FD7E          .byte "KEY ", 0

; ; Each matrix place's legend (spec "The PET it runs on"), row 0 PB0 first: a character, or
; ; $80 + a name's index in NAMES, or 0 unused.
; legends:
@D83 21 23 25 26 28 5F 88 87  ; FD83          .byte '!', '#', '%', '&', '(', '_', $80+8, $80+7
@D8B 22 24 27 5C 29 00 86 85  ; FD8B          .byte '"', '$', $27, $5C, ')', 0, $80+6, $80+5
@D93 51 45 54 55 4F 5E 37 39  ; FD93          .byte 'Q', 'E', 'T', 'U', 'O', '^', '7', '9'
@D9B 57 52 59 49 50 00 38 2F  ; FD9B          .byte 'W', 'R', 'Y', 'I', 'P', 0, '8', '/'
@DA3 41 44 47 4A 4C 00 34 36  ; FDA3          .byte 'A', 'D', 'G', 'J', 'L', 0, '4', '6'
@DAB 53 46 48 4B 3A 00 35 2A  ; FDAB          .byte 'S', 'F', 'H', 'K', ':', 0, '5', '*'
@DB3 5A 43 42 4D 3B 81 31 33  ; FDB3          .byte 'Z', 'C', 'B', 'M', ';', $80+1, '1', '3'
@DBB 58 56 4E 2C 3F 00 32 2B  ; FDBB          .byte 'X', 'V', 'N', ',', '?', 0, '2', '+'
@DC3 83 40 5D 00 3E 84 30 2D  ; FDC3          .byte $80+3, '@', ']', 0, '>', $80+4, '0', '-'
@DCB 89 5B 80 3C 82 00 2E 3D  ; FDCB          .byte $80+9, '[', $80+0, '<', $80+2, 0, '.', '='
@DD3 53 50 41 43 45 00 52 45 54 55 52 4E 00 53 54 4F  ; FDD3  names:  .byte "SPACE", 0, "RETURN", 0, "STOP", 0, "SHIFT L", 0, "SHIFT R", 0
@DE3 50 00 53 48 49 46 54 20 4C 00 53 48 49 46 54 20
@DF3 52 00
@DF5 44 45 4C 00 43 52 53 52 20 44 4E 00 43 52 53 52  ; FDF5          .byte "DEL", 0, "CRSR DN", 0, "CRSR RT", 0, "HOME", 0, "RVS", 0
@E05 20 52 54 00 48 4F 4D 45 00 52 56 53 00

;         .org $FFF9
@FF9 F6        ; FFF9          .checksum $F800, $800
@FFA F3 F8 06 F8 D6 F8  ; FFFA          .word nmi, reset, irq

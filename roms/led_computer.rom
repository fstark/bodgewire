; Generated by bw asm from led_computer.asm: do not edit. Edit the .asm and run bw asm again.
; ; 110 LED computer (docs/machines/110-led-computer/LED_COMPUTER.md): a light bouncing along
; ; 8 LEDs. Memory map: RAM $0000-$03FF (mirrored to $1FFF), the LED latch at $8000 (any write in
; ; $8000-$9FFF), this ROM at $F800-$FFFF (mirrored from $E000).

;         .rom $F800, $800

; LEDS    = $8000         ; U7, the 74LS273
; light   = $00           ; the lit LED: one bit set
; dir     = $01           ; 0: moving left (towards D8), 1: moving right
; STEPS   = 97            ; delay: 97 x 1286 cycles, about 125 ms at 1 MHz

;         .org $F800
@000 A2 FF     ; F800  reset:  ldx #$FF
@002 9A        ; F802          txs             ; stack from $01FF down
@003 D8        ; F803          cld
@004 A9 01     ; F804          lda #$01
@006 85 00     ; F806          sta light
@008 A9 00     ; F808          lda #0
@00A 85 01     ; F80A          sta dir
@00C A5 00     ; F80C  loop:   lda light
@00E 8D 00 80  ; F80E          sta LEDS
@011 20 32 F8  ; F811          jsr delay
@014 A5 01     ; F814          lda dir
@016 D0 0D     ; F816          bne @right
@018 06 00     ; F818          asl light
@01A A5 00     ; F81A          lda light
@01C C9 80     ; F81C          cmp #$80
@01E D0 EC     ; F81E          bne loop
@020 E6 01     ; F820          inc dir
@022 4C 0C F8  ; F822          jmp loop
@025 46 00     ; F825  @right: lsr light
@027 A5 00     ; F827          lda light
@029 C9 01     ; F829          cmp #$01
@02B D0 DF     ; F82B          bne loop
@02D C6 01     ; F82D          dec dir
@02F 4C 0C F8  ; F82F          jmp loop

@032 A0 61     ; F832  delay:  ldy #STEPS
@034 A2 00     ; F834  @outer: ldx #0
@036 CA        ; F836  @inner: dex
@037 D0 FD     ; F837          bne @inner      ; 256 x 5 - 1 cycles
@039 88        ; F839          dey
@03A D0 F8     ; F83A          bne @outer
@03C 60        ; F83C          rts

@03D 40        ; F83D  irq:    rti             ; IRQ_N and NMI_N are never pulled low

;         .org $FFFA
@7FA 3D F8 00 F8 3D F8  ; FFFA          .word irq, reset, irq   ; NMI, RESET, IRQ/BRK

; Generated by bw asm from bw1_bench.asm: do not edit. Edit the .asm and run bw asm again.
; ; BW-1 bench (tests/data/bw1_bench.bwn, docs/p5j-bw1-chips/BW1_CHIPS_DESIGN.md §7): the 6530-002's
; ; ROM at $1C00-$1FFF (mirrored to $FC00: A13-A15 undecoded). Tests the 6102s ($0000-$03FF) and the
; ; 6530's RAM ($17C0-$17FF), shows the result on port A ($55: both good, $01: a 6102 bit, $02: a
; ; 6530 RAM bit), then counts timer interrupts on PB0-PB4 and copies PA7 (a button) to PB5.

;         .rom $1C00, $400

; PAD     = $1740         ; port A data
; PADD    = $1741         ; port A direction
; PBD     = $1742         ; port B data
; PBDD    = $1743         ; port B direction
; TIMER8  = $174D         ; timer write: A2 = 1, A3 = 1 (interrupt on PB7), A1 A0 = 01 (÷8)
; RIOTRAM = $17C0         ; the 6530's 64 bytes
; COUNT   = $00           ; interrupts counted, once the RAM tests are done
; TICKS   = 100           ; 100 x 8 = 800 cycles between interrupts

;         .org $1C00
@000 78        ; 1C00  reset:  sei
@001 D8        ; 1C01          cld
@002 A2 FF     ; 1C02          ldx #$FF
@004 9A        ; 1C04          txs
@005 A9 7F     ; 1C05          lda #$7F
@007 8D 41 17  ; 1C07          sta PADD        ; PA0-PA6 outputs, PA7 an input (the button)
@00A A9 3F     ; 1C0A          lda #$3F
@00C 8D 43 17  ; 1C0C          sta PBDD        ; PB0-PB5 outputs, PB7 an input (the interrupt)
@00F A9 00     ; 1C0F          lda #0
@011 8D 40 17  ; 1C11          sta PAD
@014 8D 42 17  ; 1C14          sta PBD

; ; The 6102s: four patterns, written then compared. No RAM is used meanwhile.
@017 A2 00     ; 1C17          ldx #0
@019 8A        ; 1C19  @write: txa
@01A 95 00     ; 1C1A          sta $0000,x
@01C 49 FF     ; 1C1C          eor #$FF
@01E 9D 00 01  ; 1C1E          sta $0100,x
@021 8A        ; 1C21          txa
@022 49 55     ; 1C22          eor #$55
@024 9D 00 02  ; 1C24          sta $0200,x
@027 8A        ; 1C27          txa
@028 49 AA     ; 1C28          eor #$AA
@02A 9D 00 03  ; 1C2A          sta $0300,x
@02D E8        ; 1C2D          inx
@02E D0 E9     ; 1C2E          bne @write
@030 8A        ; 1C30  @check: txa
@031 D5 00     ; 1C31          cmp $0000,x
@033 D0 52     ; 1C33          bne bad6102
@035 49 FF     ; 1C35          eor #$FF
@037 DD 00 01  ; 1C37          cmp $0100,x
@03A D0 4B     ; 1C3A          bne bad6102
@03C 8A        ; 1C3C          txa
@03D 49 55     ; 1C3D          eor #$55
@03F DD 00 02  ; 1C3F          cmp $0200,x
@042 D0 43     ; 1C42          bne bad6102
@044 8A        ; 1C44          txa
@045 49 AA     ; 1C45          eor #$AA
@047 DD 00 03  ; 1C47          cmp $0300,x
@04A D0 3B     ; 1C4A          bne bad6102
@04C E8        ; 1C4C          inx
@04D D0 E1     ; 1C4D          bne @check

; ; The 6530's RAM.
@04F A2 3F     ; 1C4F          ldx #$3F
@051 8A        ; 1C51  @riotw: txa
@052 49 A5     ; 1C52          eor #$A5
@054 9D C0 17  ; 1C54          sta RIOTRAM,x
@057 CA        ; 1C57          dex
@058 10 F7     ; 1C58          bpl @riotw
@05A A2 3F     ; 1C5A          ldx #$3F
@05C 8A        ; 1C5C  @riotc: txa
@05D 49 A5     ; 1C5D          eor #$A5
@05F DD C0 17  ; 1C5F          cmp RIOTRAM,x
@062 D0 2B     ; 1C62          bne bad6530
@064 CA        ; 1C64          dex
@065 10 F5     ; 1C65          bpl @riotc

@067 A9 55     ; 1C67          lda #$55
@069 8D 40 17  ; 1C69          sta PAD
@06C A9 00     ; 1C6C          lda #0
@06E 85 00     ; 1C6E          sta COUNT
@070 A9 64     ; 1C70          lda #TICKS
@072 8D 4D 17  ; 1C72          sta TIMER8
@075 58        ; 1C75          cli
@076 A5 00     ; 1C76  loop:   lda COUNT
@078 29 1F     ; 1C78          and #$1F
@07A 2C 40 17  ; 1C7A          bit PAD         ; N: PA7, the button (pulled up: 1 while not pressed)
@07D 10 02     ; 1C7D          bpl @low
@07F 09 20     ; 1C7F          ora #$20
@081 8D 42 17  ; 1C81  @low:   sta PBD
@084 4C 76 1C  ; 1C84          jmp loop

; bad6102:
@087 A9 01     ; 1C87          lda #$01
@089 8D 40 17  ; 1C89          sta PAD
@08C 4C 8C 1C  ; 1C8C          jmp *
; bad6530:
@08F A9 02     ; 1C8F          lda #$02
@091 8D 40 17  ; 1C91          sta PAD
@094 4C 94 1C  ; 1C94          jmp *

@097 48        ; 1C97  irq:    pha
@098 A9 64     ; 1C98          lda #TICKS
@09A 8D 4D 17  ; 1C9A          sta TIMER8      ; again from now; clears the flag, PB7 back high
@09D E6 00     ; 1C9D          inc COUNT
@09F 68        ; 1C9F          pla
@0A0 40        ; 1CA0          rti
@0A1 40        ; 1CA1  nmi:    rti

;         .org $1FFA
@3FA A1 1C 00 1C 97 1C  ; 1FFA          .word nmi, reset, irq   ; NMI, RESET, IRQ/BRK

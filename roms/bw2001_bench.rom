; Generated by bw asm from bw2001_bench.asm: do not edit. Edit the .asm and run bw asm again.
; ; BW-2001 bench (tests/data/bw2001_bench.bwn, docs/p5n-bw2001-chips/BW2001_CHIPS_DESIGN.md §7): the
; ; ROM in UH7 at $F800-$FFFF. Tests the RAM ($0000-$1FFF) and the video RAM ($8000-$83FF) with
; ; X ^ page ^ $A5, shows the result on PIA2's port B ($55: good, $01: a RAM bit, $02: a video RAM
; ; bit), sets up the VIA (T1 free-running on PB7, its interrupt; the shift register in mode 4 on
; ; CB1 and CB2) and PIA1 (the retrace interrupt on CB1, the keyboard rows), then answers the
; ; interrupts: at each retrace it reads keyboard rows 3 (to PIA2's port A) and 8 (column 0 to
; ; PIA2's CA2), as the PET does, and counts on the VIA's port A.

;         .rom $F800, $800

; PIA1    = $E810         ; +0 PA or DDRA, +1 CRA, +2 PB or DDRB, +3 CRB
; PIA2    = $E820
; VIA     = $E840         ; +0 ORB +1 ORA +2 DDRB +3 DDRA +4 T1L +5 T1H +8 T2L +A SR +B ACR +D IFR +E IER
; PTR     = $00           ; page pointer (page 0 is tested first)
; JIFFY   = $02           ; retraces counted
; HALF    = 998           ; T1: N + 2 = 1000 cycles a half period, PB7 a 2 ms square wave

;         .org $F800
@000 78        ; F800  reset:  sei
@001 D8        ; F801          cld
@002 A2 FF     ; F802          ldx #$FF
@004 9A        ; F804          txs
@005 A9 00     ; F805          lda #0          ; PIA2: port B the result, port A the row-3 keys, CA2 manual
@007 8D 23 E8  ; F807          sta PIA2+3
@00A 8D 21 E8  ; F80A          sta PIA2+1
@00D A9 FF     ; F80D          lda #$FF
@00F 8D 22 E8  ; F80F          sta PIA2+2
@012 8D 20 E8  ; F812          sta PIA2
@015 A9 04     ; F815          lda #$04
@017 8D 23 E8  ; F817          sta PIA2+3
@01A A9 3C     ; F81A          lda #$3C
@01C 8D 21 E8  ; F81C          sta PIA2+1
@01F A9 00     ; F81F          lda #0
@021 8D 22 E8  ; F821          sta PIA2+2

; ; Page 0, by abs,X: no RAM used meanwhile.
@024 A2 00     ; F824          ldx #0
@026 8A        ; F826  @w0:    txa
@027 49 A5     ; F827          eor #$A5
@029 95 00     ; F829          sta $0000,x
@02B E8        ; F82B          inx
@02C D0 F8     ; F82C          bne @w0
@02E 8A        ; F82E  @c0:    txa
@02F 49 A5     ; F82F          eor #$A5
@031 D5 00     ; F831          cmp $0000,x
@033 F0 03     ; F833          beq @ok0
@035 4C E1 F8  ; F835          jmp badram
@038 E8        ; F838  @ok0:   inx
@039 D0 F3     ; F839          bne @c0

; ; Pages $01-$1F, through PTR.
@03B A9 00     ; F83B          lda #0
@03D 85 00     ; F83D          sta PTR
@03F A9 01     ; F83F          lda #$01
@041 85 01     ; F841          sta PTR+1
@043 A0 00     ; F843  @page:  ldy #0
@045 98        ; F845  @w:     tya
@046 45 01     ; F846          eor PTR+1
@048 49 A5     ; F848          eor #$A5
@04A 91 00     ; F84A          sta (PTR),y
@04C C8        ; F84C          iny
@04D D0 F6     ; F84D          bne @w
@04F 98        ; F84F  @c:     tya
@050 45 01     ; F850          eor PTR+1
@052 49 A5     ; F852          eor #$A5
@054 D1 00     ; F854          cmp (PTR),y
@056 F0 03     ; F856          beq @ok
@058 4C E1 F8  ; F858          jmp badram
@05B C8        ; F85B  @ok:    iny
@05C D0 F1     ; F85C          bne @c
@05E E6 01     ; F85E          inc PTR+1
@060 A5 01     ; F860          lda PTR+1
@062 C9 20     ; F862          cmp #$20
@064 D0 DD     ; F864          bne @page

; ; The video RAM, pages $80-$83.
@066 A9 80     ; F866          lda #$80
@068 85 01     ; F868          sta PTR+1
@06A A0 00     ; F86A  @vpage: ldy #0
@06C 98        ; F86C  @vw:    tya
@06D 45 01     ; F86D          eor PTR+1
@06F 49 A5     ; F86F          eor #$A5
@071 91 00     ; F871          sta (PTR),y
@073 C8        ; F873          iny
@074 D0 F6     ; F874          bne @vw
@076 98        ; F876  @vc:    tya
@077 45 01     ; F877          eor PTR+1
@079 49 A5     ; F879          eor #$A5
@07B D1 00     ; F87B          cmp (PTR),y
@07D F0 03     ; F87D          beq @vok
@07F 4C E9 F8  ; F87F          jmp badvideo
@082 C8        ; F882  @vok:   iny
@083 D0 F1     ; F883          bne @vc
@085 E6 01     ; F885          inc PTR+1
@087 A5 01     ; F887          lda PTR+1
@089 C9 84     ; F889          cmp #$84
@08B D0 DD     ; F88B          bne @vpage

; ; PIA1: PA0-PA3 the keyboard row, PB the columns, CB1 the retrace (falling edge, interrupt).
@08D A9 00     ; F88D          lda #0
@08F 8D 11 E8  ; F88F          sta PIA1+1
@092 8D 13 E8  ; F892          sta PIA1+3
@095 8D 12 E8  ; F895          sta PIA1+2      ; DDRB: all inputs
@098 A9 0F     ; F898          lda #$0F
@09A 8D 10 E8  ; F89A          sta PIA1        ; DDRA
@09D A9 04     ; F89D          lda #$04
@09F 8D 11 E8  ; F89F          sta PIA1+1      ; CRA: ORA
@0A2 A9 03     ; F8A2          lda #3
@0A4 8D 10 E8  ; F8A4          sta PIA1        ; row 3
@0A7 A9 05     ; F8A7          lda #$05
@0A9 8D 13 E8  ; F8A9          sta PIA1+3      ; CRB: ORB, CB1 falling, its interrupt on

; ; The VIA: PA the count, PB7 T1's; the shift register in mode 4 at T2 latch 8 (CB1 a 20 us
; ; clock); T1 free-running with its interrupt.
@0AC A9 FF     ; F8AC          lda #$FF
@0AE 8D 43 E8  ; F8AE          sta VIA+3
@0B1 A9 80     ; F8B1          lda #$80
@0B3 8D 42 E8  ; F8B3          sta VIA+2
@0B6 A9 08     ; F8B6          lda #8
@0B8 8D 48 E8  ; F8B8          sta VIA+8
@0BB A9 D0     ; F8BB          lda #$D0
@0BD 8D 4B E8  ; F8BD          sta VIA+$B      ; ACR: T1 free-running on PB7, SR mode 4
@0C0 A9 0F     ; F8C0          lda #$0F
@0C2 8D 4A E8  ; F8C2          sta VIA+$A
@0C5 A9 E6     ; F8C5          lda #<HALF
@0C7 8D 44 E8  ; F8C7          sta VIA+4
@0CA A9 03     ; F8CA          lda #>HALF
@0CC 8D 45 E8  ; F8CC          sta VIA+5
@0CF A9 C0     ; F8CF          lda #$C0
@0D1 8D 4E E8  ; F8D1          sta VIA+$E      ; IER: T1

@0D4 A9 00     ; F8D4          lda #0
@0D6 85 02     ; F8D6          sta JIFFY
@0D8 A9 55     ; F8D8          lda #$55
@0DA 8D 22 E8  ; F8DA          sta PIA2+2      ; pass
@0DD 58        ; F8DD          cli
@0DE 4C DE F8  ; F8DE  loop:   jmp loop

@0E1 A9 01     ; F8E1  badram: lda #$01
@0E3 8D 22 E8  ; F8E3          sta PIA2+2
@0E6 4C E6 F8  ; F8E6          jmp *
; badvideo:
@0E9 A9 02     ; F8E9          lda #$02
@0EB 8D 22 E8  ; F8EB          sta PIA2+2
@0EE 4C EE F8  ; F8EE          jmp *

@0F1 48        ; F8F1  irq:    pha
@0F2 2C 4D E8  ; F8F2          bit VIA+$D      ; V: IFR bit 6, T1
@0F5 50 03     ; F8F5          bvc @pia
@0F7 AD 44 E8  ; F8F7          lda VIA+4       ; clears T1's flag
@0FA AD 13 E8  ; F8FA  @pia:   lda PIA1+3      ; N: CRB bit 7, the retrace
@0FD 10 29     ; F8FD          bpl @done
@0FF A9 03     ; F8FF          lda #3          ; row 3 to PIA2's port A
@101 8D 10 E8  ; F901          sta PIA1
@104 EA        ; F904          nop
@105 AD 12 E8  ; F905          lda PIA1+2      ; clears the flag
@108 8D 20 E8  ; F908          sta PIA2
@10B A9 08     ; F90B          lda #8          ; row 8, column 0 to PIA2's CA2
@10D 8D 10 E8  ; F90D          sta PIA1
@110 EA        ; F910          nop
@111 AD 12 E8  ; F911          lda PIA1+2
@114 29 01     ; F914          and #$01
@116 F0 04     ; F916          beq @low
@118 A9 3C     ; F918          lda #$3C
@11A D0 02     ; F91A          bne @set
@11C A9 34     ; F91C  @low:   lda #$34
@11E 8D 21 E8  ; F91E  @set:   sta PIA2+1
@121 E6 02     ; F921          inc JIFFY
@123 A5 02     ; F923          lda JIFFY
@125 8D 41 E8  ; F925          sta VIA+1
@128 68        ; F928  @done:  pla
@129 40        ; F929          rti
@12A 40        ; F92A  nmi:    rti

;         .org $FFFA
@7FA 2A F9 00 F8 F1 F8  ; FFFA          .word nmi, reset, irq   ; NMI, RESET, IRQ/BRK

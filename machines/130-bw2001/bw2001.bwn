# Machine 130 BW-2001 (machines/130-bw2001/docs/BW2001.md): the Commodore PET 2001 main board
# 320137, transcribed from Commodore's schematic 320135 sheets 1-3 (machines/130-bw2001/docs
# schematic/), with the changes of BW2001_DESIGN.md (Netlist). References are the board's grid
# locations (UF3: row F, column 3). The 8 MHz clock, divided, counts dots, characters, lines and
# rows; the count addresses the video RAM, whose byte and the scan line address the character ROM,
# whose dots a 74LS165 shifts out. The 6502 runs off the same clock and reaches the video RAM
# through 74LS157s that hand it the RAM's address lines on every $8000 access: the PET's snow.

part X1   OSC freq=8MHz                              # the crystal Y1 and two 74LS04 gates of UD9 (9-8, 11-10)
part J8   POWER
part UE2  74LS08                                        # gate 2 (4,5->6) clock gate; gate 1 (1,2->3) pixel; gates 3,4 not on this sheet
part UC9  74LS93                                        # dot/character divider: /8 on CLK8 (QB QC QD), QA = H0
part UB5  74LS93                                        # horizontal character counter H1-H4
part UA1  74LS93                                        # scan line within a character row (QB QC QD = RA0-RA2), clocked by DIS.ON
part UC8  74LS107                                       # FF1 load pulse, FF2 phi0 synchroniser
part UC7  74LS107                                       # FF1 vertical step pulse, FF2 H5 (horizontal bit 5)
part UC5  74LS107                                       # FF1 horizontal drive, FF2 DIS.ON (display enable)
part UB6  74LS107                                       # vertical state (2-bit Johnson counter)
part UD5  74LS107                                       # video address bits TA0 TA1
part UD8  74LS00                                        # four gates
part UC6  74LS08                                        # four gates
part UC2  74LS00                                        # four gates
part UB1  74LS20                                        # gate 2 (9,10,12,13->8) only; gate 1 not on this sheet
part UE8  74LS20                                        # both gates
part UE9  74LS20                                        # gate 1 (1,2,4,5->6) only; gate 2 not on this sheet
part UD9  74LS04                                        # 3->4, 5->6 here (+ oscillator 9->8, 11->10, replaced by Y1)
part UE5  74LS04                                        # 13->12, 11->10 here (location read 'E5'); others not on this sheet
part UB2  74LS165                                       # dot shift register
part UA2  2316B select=LLH contents=roms/901447-08.bin # the character ROM 901447-08 (P5n)
part UC1  74LS74                                        # reverse-video bit pipeline (SD7)
part UD6  74177                                         # video address TA2-TA5
part UD7  74177                                         # video address TA6-TA9
part UE6  74100                                         # row start latch LA2-LA9
part UD2  74LS157                                       # SA0 SA1, video RAM R/W
part UD3  74LS157                                       # SA2-SA5
part UD4  74LS157                                       # SA6-SA9
part UC3  2114 access=300ns                             # video RAM SD0-SD3 ($8000, 1 KB)
part UC4  2114 access=300ns                             # video RAM SD4-SD7
part UB3  74LS244                                       # SD0-SD3 <-> BD0-BD3
part UB4  74LS244                                       # SD4-SD7 <-> BD4-BD7
part J7   MONITOR                                       # the monitor: video, vertical and horizontal drive
part UF3  6502                                          # CPU
part UE4  7417                                          # A6-A10 -> BA6-BA10; RES_N -> IFC_N
part UE3  7417                                          # A1-A5 -> BA1-BA5; BLANK_TV -> EOI_N
part UG2  74LS154                                       # SEL0_N-SELF_N, 4 KB blocks
part UG4  74LS21                                        # RW_E_N, BD_TO_D
part UG3  74LS00                                        # gates 3, 4 here (BPHI2); gates 1, 2 not on this sheet
part UG5  74LS244                                       # D0-D3 <-> BD0-BD3
part UG6  74LS244                                       # D4-D7 <-> BD4-BD7
part UB8  6520                                          # PIA2 $E820: IEEE data, ATN in, NDAC out, SRQ in, DAV out
part UA5  6522                                          # VIA $E840: user port, IEEE/cassette control
part UG8  6520                                          # PIA1 $E810: keyboard, cassette sense, EOI, DIAG, retrace
part UG9  74LS145                                       # keyboard rows
part UDE9 POR time=1ms                                  # replaces the LM555 (real hold ~1.1 s: R15 1M x C5 1uF)
part UA7  MC3446                                        # IEEE transceiver DIO1-DIO4
part UA8  MC3446                                        # IEEE transceiver DIO5-DIO8
part UA9  MC3446                                        # IEEE transceiver DAV NRFD NDAC ATN
part DS1  LED                                           # diagnostic LED (series R9 470 ohm not modelled)
part J1   IEEE488                                       # IEEE-488 edge connector (24 pins: 1-12, A-N)
part J2   USERPORT                                      # parallel user port (24 pins: 1-12, A-N)
part J3   CASSETTE                                      # cassette #2 (pins A-1 .. F-6 as 1-6)
part J5   BW2001KB                                      # keyboard (1-10 rows, A-J columns)
part J6   CASSETTE                                      # cassette #1 (pins A1 .. F6 as 1-6)
part R13  R value=1k                                    # NMI_N pull-up
part R14  R value=1k                                    # RDY pull-up
part R17  R value=3k3                                   # IRQ_N pull-up
part R26  R value=1k                                    # PU_R26: spare-input high for G3, G4
part R28  R value=1k                                    # BA0
part R29  R value=1k                                    # BA1
part R30  R value=1k                                    # BA2
part R31  R value=1k                                    # BA3
part R32  R value=1k                                    # BA4
part R33  R value=1k                                    # BA5
part R34  R value=1k                                    # BA6
part R35  R value=1k                                    # BA7
part R36  R value=1k                                    # BA8
part R37  R value=1k                                    # BA9
part R38  R value=1k                                    # BA10
part R10  R value=2k4                                   # IFC_N pull-up (R11 5.1k to GND not modelled)
part R48  R value=2k4                                   # EOI_N pull-up (R47 5.1k to GND not modelled)
part R18  R value=10k                                   # KIN0 (R18-R25 drawn as one; order assumed)
part R19  R value=10k                                   # KIN1
part R20  R value=10k                                   # KIN2
part R21  R value=10k                                   # KIN3
part R22  R value=10k                                   # KIN4
part R23  R value=10k                                   # KIN5
part R24  R value=10k                                   # KIN6
part R25  R value=10k                                   # KIN7
part R99  R value=3k3                                   # RES_N pull-up for the POR (not on the PET)
part UI8  2114 access=300ns                             # $0000-$03FF BBD0-BBD3
part UI7  2114 access=300ns                             # $0400-$07FF BBD0-BBD3
part UI6  2114 access=300ns                             # $0800-$0BFF BBD0-BBD3
part UI5  2114 access=300ns                             # $0C00-$0FFF BBD0-BBD3
part UI4  2114 access=300ns                             # $1000-$13FF BBD0-BBD3 (8K only, *)
part UI3  2114 access=300ns                             # $1400-$17FF BBD0-BBD3 (8K only, *)
part UI2  2114 access=300ns                             # $1800-$1BFF BBD0-BBD3 (8K only, *)
part UI1  2114 access=300ns                             # $1C00-$1FFF BBD0-BBD3 (8K only, *)
part UJ8  2114 access=300ns                             # $0000-$03FF BBD4-BBD7
part UJ7  2114 access=300ns                             # $0400-$07FF BBD4-BBD7
part UJ6  2114 access=300ns                             # $0800-$0BFF BBD4-BBD7
part UJ5  2114 access=300ns                             # $0C00-$0FFF BBD4-BBD7
part UJ4  2114 access=300ns                             # $1000-$13FF BBD4-BBD7 (8K only, *)
part UJ3  2114 access=300ns                             # $1400-$17FF BBD4-BBD7 (8K only, *)
part UJ2  2114 access=300ns                             # $1800-$1BFF BBD4-BBD7 (8K only, *)
part UJ1  2114 access=300ns                             # $1C00-$1FFF BBD4-BBD7 (8K only, *)
part UH1  2316B select=LLH contents=roms/901447-01.bin # $C000-$C7FF: BASIC 1 (Commodore's; our firmware: debug-roms/)
part UH5  2316B select=LHH contents=roms/901447-02.bin # $C800-$CFFF: BASIC
part UH2  2316B select=LLH contents=roms/901447-03.bin # $D000-$D7FF: BASIC
part UH6  2316B select=LHH contents=roms/901447-04.bin # $D800-$DFFF: BASIC
part UH3  2316B select=LLH contents=roms/901447-05.bin # $E000-$E7FF: the screen editor
part UH4  2316B select=LLH contents=roms/901447-06.bin # $F000-$F7FF: the operating system (tape, IEEE-488, the monitor)
part UH7  2316B select=LHH contents=roms/901447-07.bin # $F800-$FFFF: the operating system, reset and the vectors
part UI9  74LS139                                       # dual 2-to-4 decoder, RAM 1 KB blocks (no datasheet: pins by number)
part UH8  74LS244                                       # RAM data buffer, BD0-BD3 <-> BBD0-BBD3
part UH9  74LS244                                       # RAM data buffer, BD4-BD7 <-> BBD4-BBD7
part UJ9  74LS00                                        # gates 1, 2 here (pins 1-6): RW_RAM; gates 3, 4 not on this sheet
part R46  R value=1k                                  # pull-up (the schematic's R46 1K)
part R12  R value=1k                                  # pull-up (the schematic's R12 1K)
part R39  R value=1k                                  # pull-up (the schematic's R39 1K)
part R43  R value=1k                                  # pull-up (the schematic's R43 1K)
part R41  R value=1k                                  # pull-up (the schematic's R41 1K)
part R27  R value=1k                                  # pull-up (the schematic's R27 1K)
part R40  R value=1k                                  # pull-up (the schematic's R40 1K)
part R44  R value=1k                                  # pull-up (the schematic's R44 1K)
part R45  R value=1k                                  # pull-up (the schematic's R45 1K)

net OSC8       X1.OUT UE2.2B                                     # E2 pin 5; on the board the 74LS04 pin 8 output (crystal oscillator)
net PU_R46     UE2.2A R46.2                                      # E2 pin 4: R46 1K to +5V, TP5-1 (clock enable; pull low to stop the clock)
net CLK8       UE2.2Y UC9.CKB UC8.2CLK UD8.3A UB2.CLK            # 8 MHz dot clock: E2 pin 6 -> C9 pin 1, C8 pin 9, D8 pin 9, B2 pin 2
net CLK2M      UC9.QC UC7.1CLK                                   # C9 pin 8 -> C7 pin 12 (2 MHz)
net CLK1M      UC9.QD UC9.CKA UC8.1CLK UC8.2J UD9.2A             # C9 pin 11 -> C9 pin 14, C8 pins 12 and 8, D9 pin 3 (1 MHz character clock)
net CLK1M_N    UD9.2Y UC8.2K                                     # D9 pin 4 -> C8 pin 11
net PHI0       UC8.2Q_N                                          # C8 pin 6: off-sheet arrow 'phi0' to the CPU (label also carries 'VERT DRIVE' text, see notes)
net PHI0       UF3.PHI0                                          # in from sheet 3 (arrow "00")
net PHI0_N     UC8.2Q UC1.1CLK                                   # C8 pin 5 -> C1 pin 3
net CHLOAD     UC8.1Q UD8.3B UD5.2CLK UC1.2CLK                   # C8 pin 3 -> D8 pin 10, D5 pin 9, C1 pin 11: short pulse after CLK1M falls
net CHLOAD_N   UC8.1Q_N UB2.SH_LD_N                              # C8 pin 2 -> B2 pin 1 (TP3-5)
net CHLOAD_CLR_N UD8.3Y UC8.1CLR_N                               # D8 pin 8 -> C8 pin 13
net PU_R12     UC8.1J UC8.2CLR_N UC7.1K UC7.1CLR_N UC7.2J UC7.2K UC7.2CLR_N UD9.3A R12.2 # R12 1K to +5V, TP3-2
net HCNT_CLR   UD9.3Y UC9.R01 UC9.R02 UB5.R01 UB5.R02            # D9 pin 6 -> C9 pins 2,3 and B5 pins 2,3 (low unless TP3-2 is grounded)
net H0         UC9.QA UB5.CKA UC5.2CLK                           # C9 pin 12 -> B5 pin 14, C5 pin 9
net H1         UB5.QA UB5.CKB                                    # B5 pin 12 -> B5 pin 1
net H2         UB5.QB UC5.1CLK                                   # B5 pin 9 -> C5 pin 12
net H3         UB5.QC UC6.2B                                     # B5 pin 8 -> C6 pin 5
net H4         UB5.QD UC7.2CLK UC6.1B                            # B5 pin 11 -> C7 pin 9, C6 pin 2
net H5         UC7.2Q UC6.2A                                     # C7 pin 5 -> C6 pin 4
net H5_N       UC7.2Q_N UC6.1A                                   # C7 pin 6 -> C6 pin 1
net DISON_SET  UC6.2Y UC5.2J                                     # C6 pin 6 -> C5 pin 8 (H3 and H5)
net DISON_CLR  UC6.1Y UC5.2K                                     # C6 pin 3 -> C5 pin 11 (H4 and not H5)
net DIS_ON     UC5.2Q UC5.1J UA1.CKB UB1.2D UE9.1D UD5.1CLR_N UD5.2CLR_N UD6.CT_LOAD_N UD7.CT_LOAD_N # 'DIS. ON': C5 pin 5 -> C5 pin 1, A1 pin 1, B1 pin 13, E9 pin 5, D5 pins 13 and 10, D6 pin 1, D7 pin 1
net DIS_OFF    UC5.2Q_N UC5.1K UC6.4A                            # 'DIS. OFF': C5 pin 6 -> C5 pin 4, C6 pin 12
net PU_R39     UC5.1CLR_N UC5.2CLR_N UD5.1J UD5.1K UD5.2J UD5.2K R39.2 # R39 1K to +5V, TP3-1
net HORZ_DRIVE UC5.1Q_N J7.HDRIVE                                # 'HORZ. DRIVE': C5 pin 2 -> J7 pin 5 (C5 pin 3 unused)
net HORZ_DRIVE J2.HORZ                                           # from sheet 3 by label ("HORZ", overline uncertain)
net RA0        UA1.QB UA2.A0 UB1.2B                              # A1 pin 9 -> A2 pin 8, B1 pin 10
net RA1        UA1.QC UA2.A1 UB1.2C                              # A1 pin 8 -> A2 pin 7, B1 pin 12
net RA2        UA1.QD UA2.A2 UB1.2A UE8.2C                       # A1 pin 11 -> A2 pin 6, B1 pin 9, E8 pin 12
net PU_R43     UA1.R02 R43.2                                     # A1 pin 3: R43 1K to +5V (A1 pin 14 CKA and pin 12 QA unconnected)
net ROW7_N     UB1.2Y UC2.3B                                     # B1 pin 8 -> C2 pin 10: low while DIS.ON on scan line 7
net VSTEP      UC7.1Q UB6.1CLK UB6.2CLK UA1.R01                  # C7 pin 3 -> B6 pins 12 and 9, A1 pin 2 (TP3-3)
net VSTEP_N    UC7.1Q_N UD6.CLR_N UD7.CLR_N UC2.3A               # C7 pin 2 -> D6 pin 13, D7 pin 13, C2 pin 9
net VSTEP_J    UC6.4Y UC7.1J                                     # C6 pin 11 -> C7 pin 1
net VEND       UD8.2Y UC6.4B                                     # D8 pin 6 -> C6 pin 13: end of the current vertical state
net PU_R41     UB6.1CLR_N UB6.2CLR_N R41.2                       # B6 pins 13, 10: R41 1K to +5V, TP3-4
net VS0        UB6.1Q UB6.2J UC6.3A                              # B6 pin 3 -> B6 pin 8, C6 pin 9 (legend's right bit)
net VS0_N      UB6.1Q_N UB6.2K UD8.4B                            # B6 pin 2 -> B6 pin 11, D8 pin 13
net VS1        UB6.2Q UB6.1K UC6.3B                              # B6 pin 5 -> B6 pin 4, C6 pin 10 (legend's left bit)
net VS1_N      UB6.2Q_N UB6.1J UD8.4A                            # B6 pin 6 -> B6 pin 1, D8 pin 12
net VERT_DRIVE UD8.4Y J7.VDRIVE                                  # D8 pin 11 -> J7 pin 3 (2200 ohm to GND); low in state 00
net VERT_DRIVE J2.VERT                                           # from sheet 3 by label ("VERT", overline uncertain)
net VIDEO_ON   UC6.3Y UE9.1B UE5.6A                              # C6 pin 8 = VIDEO ON (state 11) -> E9 pin 2, E5 pin 13; off-sheet arrow 'SYNC' (out)
net VIDEO_ON   UA5.PB5 UG8.CB1                                   # in from sheet 3 (arrow "SYNC")
net SYNC_N     UE5.6Y UE8.2D                                     # E5 pin 12 -> E8 pin 13
net PU_R27     UE8.2A R27.2                                      # E8 pin 9: R27 1K to +5V
net BLKEND_N   UE8.2Y UD8.2B                                     # E8 pin 8 -> D8 pin 5: blank state over (TA6, RA2, not VIDEO ON)
net LAT_HI_N   UE8.1Y UE5.5A                                     # E8 pin 6 -> E5 pin 11: LA6-LA9 all high
net LAT_HI     UE5.5Y UD8.1B                                     # E5 pin 10 -> D8 pin 2
net END25_N    UD8.1Y UD8.2A                                     # D8 pin 3 -> D8 pin 4: row start latch = 1000 (end of 25 rows)
net LATCH_G    UC2.3Y UE6.1G UE6.2G                              # C2 pin 8 -> E6 pins 23, 12
net TA0        UD5.2Q UD5.1CLK UD2.3A                            # D5 pin 5 -> D5 pin 12, D2 pin 11 (D5 pin 6 unused)
net TA1        UD5.1Q UD6.CLK1 UD2.4A                            # D5 pin 3 -> D6 pin 8, D2 pin 14 (D5 pin 2 unused)
net TA2        UD6.QA UD6.CLK2 UD3.1A UE6.1D1                    # D6 pin 5 -> D6 pin 6, D3 pin 2, E6 pin 2
net TA3        UD6.QB UD3.2A UE6.1D2                             # D6 pin 9 -> D3 pin 5, E6 pin 3
net TA4        UD6.QC UD3.3A UE6.1D3                             # D6 pin 2 -> D3 pin 11, E6 pin 22
net TA5        UD6.QD UD7.CLK1 UD3.4A UE6.1D4                    # D6 pin 12 -> D7 pin 8, D3 pin 14, E6 pin 21
net TA6        UD7.QA UD7.CLK2 UD4.1A UE6.2D1 UE8.2B             # D7 pin 5 -> D7 pin 6, D4 pin 2, E6 pin 11, E8 pin 10
net TA7        UD7.QB UD4.2A UE6.2D2                             # D7 pin 9 -> D4 pin 5, E6 pin 10
net TA8        UD7.QC UD4.3A UE6.2D3                             # D7 pin 2 -> D4 pin 11, E6 pin 15
net TA9        UD7.QD UD4.4A UE6.2D4                             # D7 pin 12 -> D4 pin 14, E6 pin 16
net LA2        UE6.1Q1 UD6.A                                     # E6 pin 5 -> D6 pin 4
net LA3        UE6.1Q2 UD6.B UD8.1A                              # E6 pin 4 -> D6 pin 10, D8 pin 1
net LA4        UE6.1Q3 UD6.C                                     # E6 pin 19 -> D6 pin 3
net LA5        UE6.1Q4 UD6.D                                     # E6 pin 20 -> D6 pin 11
net LA6        UE6.2Q1 UD7.A UE8.1C                              # E6 pin 8 -> D7 pin 4, E8 pin 4
net LA7        UE6.2Q2 UD7.B UE8.1D                              # E6 pin 9 -> D7 pin 10, E8 pin 5
net LA8        UE6.2Q3 UD7.C UE8.1B                              # E6 pin 18 -> D7 pin 3, E8 pin 2
net LA9        UE6.2Q4 UD7.D UE8.1A                              # E6 pin 17 -> D7 pin 11, E8 pin 1
net SEL8       UC2.4A UD2.S UD3.S UD4.S                          # off-sheet 'SEL8' (in); C2 pin 12, D2 D3 D4 pin 1
net SEL8       UE5.4Y                                            # off-sheet arrow (to the video RAM, sheet 3)
net PU_R40     UD2.1A UD2.1B UD2.2A R40.2                        # D2 pins 2, 3, 5: R40 1K to +5V, TP4-1 (D2 pin 4, 1Y, unused)
net RW_RAM     UD2.2B                                            # off-sheet 'R/W RAM' (in, from sheet 2): D2 pin 6
net RW_RAM     UJ9.2Y UI8.WE_N UI7.WE_N UI6.WE_N UI5.WE_N UI4.WE_N UI3.WE_N UI2.WE_N UI1.WE_N UJ8.WE_N UJ7.WE_N UJ6.WE_N UJ5.WE_N UJ4.WE_N UJ3.WE_N UJ2.WE_N UJ1.WE_N UH8.1OE_N UH9.1OE_N # J9 pin 6; also off-sheet (arrow left, to sheet 3)
net VRW_N      UD2.2Y UC3.WE_N UC4.WE_N UB3.2OE_N UB4.2OE_N      # D2 pin 7 -> C3 pin 10, C4 pin 10, B3 pin 19, B4 pin 19 ('R/W' at the 2114s)
net BA0        UD2.3B                                            # D2 pin 10 (off-sheet, in)
net BA0        UE2.4Y R28.2 UB8.RS0 UA5.RS0 UG8.RS0
net BA0        UI8.A0 UI7.A0 UI6.A0 UI5.A0 UI4.A0 UI3.A0 UI2.A0 UI1.A0 UJ8.A0 UJ7.A0 UJ6.A0 UJ5.A0 UJ4.A0 UJ3.A0 UJ2.A0 UJ1.A0 UH1.A0 UH5.A0 UH3.A0 UH4.A0 UH7.A0 UH2.A0 UH6.A0
net BA1        UD2.4B                                            # D2 pin 13
net BA1        UE3.2Y R29.2 UB8.RS1 UA5.RS1 UG8.RS1
net BA1        UI8.A1 UI7.A1 UI6.A1 UI5.A1 UI4.A1 UI3.A1 UI2.A1 UI1.A1 UJ8.A1 UJ7.A1 UJ6.A1 UJ5.A1 UJ4.A1 UJ3.A1 UJ2.A1 UJ1.A1 UH1.A1 UH5.A1 UH3.A1 UH4.A1 UH7.A1 UH2.A1 UH6.A1
net BA2        UD3.1B                                            # D3 pin 3
net BA2        UE3.3Y R30.2 UA5.RS2
net BA2        UI8.A2 UI7.A2 UI6.A2 UI5.A2 UI4.A2 UI3.A2 UI2.A2 UI1.A2 UJ8.A2 UJ7.A2 UJ6.A2 UJ5.A2 UJ4.A2 UJ3.A2 UJ2.A2 UJ1.A2 UH1.A2 UH5.A2 UH3.A2 UH4.A2 UH7.A2 UH2.A2 UH6.A2
net BA3        UD3.2B                                            # D3 pin 6
net BA3        UE3.4Y R31.2 UA5.RS3
net BA3        UI8.A3 UI7.A3 UI6.A3 UI5.A3 UI4.A3 UI3.A3 UI2.A3 UI1.A3 UJ8.A3 UJ7.A3 UJ6.A3 UJ5.A3 UJ4.A3 UJ3.A3 UJ2.A3 UJ1.A3 UH1.A3 UH5.A3 UH3.A3 UH4.A3 UH7.A3 UH2.A3 UH6.A3
net BA4        UD3.3B                                            # D3 pin 10
net BA4        UE3.5Y R32.2 UG8.CS1
net BA4        UI8.A4 UI7.A4 UI6.A4 UI5.A4 UI4.A4 UI3.A4 UI2.A4 UI1.A4 UJ8.A4 UJ7.A4 UJ6.A4 UJ5.A4 UJ4.A4 UJ3.A4 UJ2.A4 UJ1.A4 UH1.A4 UH5.A4 UH3.A4 UH4.A4 UH7.A4 UH2.A4 UH6.A4
net BA5        UD3.4B                                            # D3 pin 13
net BA5        UE3.6Y R33.2 UB8.CS1
net BA5        UI8.A5 UI7.A5 UI6.A5 UI5.A5 UI4.A5 UI3.A5 UI2.A5 UI1.A5 UJ8.A5 UJ7.A5 UJ6.A5 UJ5.A5 UJ4.A5 UJ3.A5 UJ2.A5 UJ1.A5 UH1.A5 UH5.A5 UH3.A5 UH4.A5 UH7.A5 UH2.A5 UH6.A5
net BA6        UD4.1B                                            # D4 pin 3
net BA6        UE4.1Y R34.2 UE2.3B
net BA6        UI8.A6 UI7.A6 UI6.A6 UI5.A6 UI4.A6 UI3.A6 UI2.A6 UI1.A6 UJ8.A6 UJ7.A6 UJ6.A6 UJ5.A6 UJ4.A6 UJ3.A6 UJ2.A6 UJ1.A6 UH1.A6 UH5.A6 UH3.A6 UH4.A6 UH7.A6 UH2.A6 UH6.A6
net BA7        UD4.2B                                            # D4 pin 6
net BA7        UE4.2Y R35.2
net BA7        UI8.A7 UI7.A7 UI6.A7 UI5.A7 UI4.A7 UI3.A7 UI2.A7 UI1.A7 UJ8.A7 UJ7.A7 UJ6.A7 UJ5.A7 UJ4.A7 UJ3.A7 UJ2.A7 UJ1.A7 UH1.A7 UH5.A7 UH3.A7 UH4.A7 UH7.A7 UH2.A7 UH6.A7

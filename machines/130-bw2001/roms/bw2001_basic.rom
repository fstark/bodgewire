; Generated by bw asm from bw2001_basic.asm: do not edit. Edit the .asm and run bw asm again.
; ; BW-2001 Tiny BASIC (docs/p5p-bw2001-firmware/BW2001_FIRMWARE.md; design §6): the PET 2001's
; ; $C000 sockets, UH1 ($C000) and UH5 ($C800). The dialect is P5o's, as its spec says
; ; (docs/p5o-tiny-basic/TINY_BASIC.md) and as its reference interpreter runs it
; ; (tests/basic/tiny_basic.py): the same checks in the same order, so the same error comes first.
; ;
; ; The program from $0400 in P5o's layout, its top MEMTOP (the kernel's RAM sizing); the
; ; variables at VARS; the direct line tokenised into DIRBUF; FOR and GOSUB in CSTACK. The editor
; ; is reached through its entry points only (machines/130-bw2001/roms/bw2001.inc). Zero page $00-$3F.

;         .rom $C000, $2000
;         .include "bw2001.inc"
; ; BW-2001 firmware, shared by its three ROMs (docs/p5p-bw2001-firmware/BW2001_FIRMWARE_DESIGN.md
; ; §3): the I/O, the RAM map and the entry points. No code here. Each ROM reaches another only
; ; through these entry points, each a JMP at a fixed address (a test reads each one's opcode).

; ; I/O
; SCREEN   = $8000        ; 40 x 25 screen codes in the 1 KB video RAM
; COLUMNS  = 40
; ROWS     = 25
; PIA1     = $E810        ; +0 PA or DDRA, +1 CRA, +2 PB or DDRB, +3 CRB
; PIA1PA   = PIA1
; PIA1CRA  = PIA1+1
; PIA1PB   = PIA1+2
; PIA1CRB  = PIA1+3
; VIA      = $E840        ; +0 port B: PB5 low while the beam is outside the text (the retrace)
; VIAPCR   = VIA+$C       ; CA2 (GRAPHIC): low, the character ROM's first half

; ; Zero page: $00-$3F BASIC, $40-$5F the editor, $60-$7F the kernel, $80-$FF the player's (USR).
; WAITING  = $40          ; 1 while the editor waits for keys to make a line (the harness signal)
; LINES    = $41          ; lines handed over, modulo 256
; CCOL     = $43          ; the editor's cursor column (the monitor reads it for a fresh row)
; MEMTOP   = $60          ; 2: the top of the program area that reset found
; PTR      = $62          ; 2: the kernel's pointer

; ; Pages 2 and 3.
; LINBUF   = $0200        ; 65: the line from the editor, $00-terminated
; DIRBUF   = $0241        ; 72: the tokenised direct line, as a record
; CSTACK   = $0290        ; 72: the control stack, 8 entries of 9 bytes
; KEYBUF   = $02F0        ; 8: the editor's key ring
; VARS     = $0300        ; 52: A-Z, low byte first
; LINKS    = $0334        ; 25: 1 when the row goes on from the row above
; SAVED    = $0350        ; 7: the monitor's PC (2), SR, AC, XR, YR, SP
; USRRAM   = $03F0        ; 16: the player's ({RAM} is 1008)
; PROGRAM  = $0400        ; the program base

; ; Entry points.
; COLD     = $C000        ; BASIC: power-on NEW, READY, the main loop
; WARM     = $C003        ; BASIC: READY on a fresh line, program and variables kept
; NUMOUT   = $C006        ; BASIC: print A (low), Y (high) as a signed decimal
; EDINIT   = $E000        ; editor: clear the screen, links, keys, flags
; EDPRINT  = $E003        ; editor: print A (P5o "print"); A, X, Y kept
; EDLINE   = $E006        ; editor: P5o "line": LINBUF, X = length
; EDINPUT  = $E009        ; editor: P5o "read a line": carry set on break
; EDBREAK  = $E00C        ; editor: P5o "break?": carry set once a STOP press
; EDIRQ    = $E00F        ; editor: the retrace's work (keys, blink)
; MONITOR  = $F000        ; monitor: USR(61440), C*
; MONBRK   = $F003        ; monitor: B*, from the IRQ handler
; SELFTEST = $F800        ; kernel: the self-test
; RESET    = $F803        ; kernel: the reset vector's target

; TXT     = $00           ; 2: the byte being read
; CURLINE = $02           ; 2: the line's record, 0 for the direct line
; TOP     = $04           ; 2: the program's end: its 00 00
; ACC     = $06           ; 2: the expression's value
; ARG     = $08           ; 2: a left operand
; T0      = $0A           ; 2
; T1      = $0C           ; 2
; DEPTH   = $0E           ; P5o's expression depth
; CSP     = $0F           ; CSTACK entries
; COL     = $10           ; BASIC's column
; SEED    = $11           ; 2: RND's R
; ERRSP   = $13           ; S at the main loop
; LNUM    = $14           ; 2: the line number entered
; SRCP    = $16           ; 2: block moves
; DSTP    = $18           ; 2
; COUNT   = $1A           ; 2
; NEWLEN  = $1C           ; the new record's length, 0 to delete
; OLDLEN  = $1D           ; the old one's, 0 if none
; W       = $1E           ; tokenise: the output index
; QUOTE   = $1F           ; tokenise: inside quotes
; SIGN    = $20
; VAR     = $21           ; a variable's index, $FF none
; FIRST   = $22           ; 2: LIST's range
; LAST    = $24           ; 2
; NL      = $26           ; PRINT: a new line at the end
; PROMPT  = $27           ; 2: INPUT's prompt text
; PLEN    = $29           ; its length, 0 none
; POSP    = $2A           ; 2: a record
; KP      = $2C           ; 2: the keyword table
; KW      = $2E           ; the keyword's token
; KX      = $2F           ; tokenise: where the match began
; NUM     = $30           ; 2: NUMOUT
; NZ      = $32
; REM_    = $33           ; 2: division's remainder
; FSTART  = $35           ; 2: FOR's start, limit, step
; FLIM    = $37           ; 2
; FSTEP   = $39           ; 2
; KC      = $3B
; ECODE   = $3C
; BAD     = $3D           ; a line number past 9999

; TPRINT  = $80           ; P5o's tokens
; TINPUT  = $81
; TLET    = $82
; TIF     = $83
; TGOTO   = $84
; TGOSUB  = $85
; TRETURN = $86
; TFOR    = $87
; TNEXT   = $88
; TEND    = $89
; TREM    = $8A
; TPOKE   = $8B
; TCLS    = $8C
; TLIST   = $8D
; TRUN    = $8E
; TNEW    = $8F
; TTHEN   = $90
; TTO     = $91
; TSTEP   = $92
; TAND    = $93
; TOR     = $94
; TNOT    = $95
; TPEEK   = $96
; TRND    = $97
; TABS    = $98
; TUSR    = $99

; ESYNTAX = 1             ; P5o's error codes
; ENOLINE = 2
; ENOGOSUB = 3
; ENOFOR  = 4
; EDEEP   = 5
; EDIVIDE = 6
; EVALUE  = 7
; EMEMORY = 8
; EDIRECT = 9

; ENTRY   = 9             ; CSTACK: type ($80 GOSUB, else FOR's variable), limit, step, line, text
; GOSUBT  = $80

;         .org $C000
@0000 4C 09 C0  ; C000          jmp cold
@0003 4C 17 C0  ; C003          jmp warm
@0006 4C EA CD  ; C006          jmp numout

; ; --- The main loop (design §6.2) ----------------------------------------------------------------

@0009 20 43 CF  ; C009  cold:   jsr new
@000C A9 00     ; C00C          lda #0
@000E 85 10     ; C00E          sta COL
@0010 85 02     ; C010          sta CURLINE
@0012 85 03     ; C012          sta CURLINE+1
@0014 4C 23 C0  ; C014          jmp ready

@0017 A2 FF     ; C017  warm:   ldx #$FF
@0019 9A        ; C019          txs
@001A 58        ; C01A          cli
@001B A9 00     ; C01B          lda #0
@001D 85 10     ; C01D          sta COL
@001F 85 02     ; C01F          sta CURLINE
@0021 85 03     ; C021          sta CURLINE+1
@0023 A2 FF     ; C023  ready:  ldx #$FF
@0025 9A        ; C025          txs
@0026 20 DE CD  ; C026          jsr fresh
@0029 A2 00     ; C029          ldx #0
@002B BD 75 C0  ; C02B  @text:  lda readytext,x
@002E F0 06     ; C02E          beq @nl
@0030 20 B8 CD  ; C030          jsr outc
@0033 E8        ; C033          inx
@0034 D0 F5     ; C034          bne @text
@0036 20 D9 CD  ; C036  @nl:    jsr newline
@0039 A2 FF     ; C039  loop:   ldx #$FF
@003B 9A        ; C03B          txs
@003C 86 13     ; C03C          stx ERRSP
@003E 20 06 E0  ; C03E          jsr EDLINE
@0041 A9 00     ; C041          lda #0
@0043 85 10     ; C043          sta COL
@0045 85 02     ; C045          sta CURLINE
@0047 85 03     ; C047          sta CURLINE+1
@0049 A2 00     ; C049          ldx #0
@004B BD 00 02  ; C04B  @space: lda LINBUF,x
@004E C9 20     ; C04E          cmp #' '
@0050 D0 03     ; C050          bne @first
@0052 E8        ; C052          inx
@0053 D0 F6     ; C053          bne @space
@0055 C9 30     ; C055  @first: cmp #'0'
@0057 90 07     ; C057          bcc direct
@0059 C9 3A     ; C059          cmp #'9'+1
@005B B0 03     ; C05B          bcs direct
@005D 4C 87 C5  ; C05D          jmp progline

@0060 20 5E C8  ; C060  direct: jsr tokenise
@0063 A9 00     ; C063          lda #0
@0065 85 0F     ; C065          sta CSP
@0067 A9 44     ; C067          lda #<(DIRBUF+3)
@0069 85 00     ; C069          sta TXT
@006B A9 02     ; C06B          lda #>(DIRBUF+3)
@006D 85 01     ; C06D          sta TXT+1
@006F 4C 7B C0  ; C06F          jmp nextstmt

; finished:
@0072 4C 23 C0  ; C072          jmp ready

; readytext:
@0075 52 45 41 44 59 00  ; C075          .byte "READY", 0

; ; --- Running (design §6.5) ---------------------------------------------------------------------

; ; Before each statement the break key; after it ':', the line's end, or a syntax error.
; nextstmt:
@007B 20 0C E0  ; C07B          jsr EDBREAK
@007E 90 03     ; C07E          bcc @run
@0080 4C 7F CE  ; C080          jmp dobreak
@0083 20 D3 C0  ; C083  @run:   jsr statement
; endstmt:
@0086 20 93 CD  ; C086          jsr peek
@0089 C9 3A     ; C089          cmp #':'
@008B D0 06     ; C08B          bne @eol
@008D 20 A2 CD  ; C08D          jsr adv
@0090 4C 7B C0  ; C090          jmp nextstmt
@0093 C9 00     ; C093  @eol:   cmp #0
@0095 F0 03     ; C095          beq eol
@0097 4C 47 CE  ; C097          jmp syntax
@009A A5 02     ; C09A  eol:    lda CURLINE
@009C 05 03     ; C09C          ora CURLINE+1
@009E F0 D2     ; C09E          beq finished
@00A0 A0 02     ; C0A0          ldy #2
@00A2 B1 02     ; C0A2          lda (CURLINE),y
@00A4 18        ; C0A4          clc
@00A5 65 02     ; C0A5          adc CURLINE
@00A7 85 02     ; C0A7          sta CURLINE
@00A9 90 02     ; C0A9          bcc @start
@00AB E6 03     ; C0AB          inc CURLINE+1
@00AD 20 B3 C0  ; C0AD  @start: jsr startline
@00B0 4C 7B C0  ; C0B0          jmp nextstmt

; ; TXT at CURLINE's text; at the end marker the program is over.
; startline:
@00B3 A0 00     ; C0B3          ldy #0
@00B5 B1 02     ; C0B5          lda (CURLINE),y
@00B7 C8        ; C0B7          iny
@00B8 11 02     ; C0B8          ora (CURLINE),y
@00BA F0 0E     ; C0BA          beq @end
@00BC 18        ; C0BC          clc
@00BD A5 02     ; C0BD          lda CURLINE
@00BF 69 03     ; C0BF          adc #3
@00C1 85 00     ; C0C1          sta TXT
@00C3 A5 03     ; C0C3          lda CURLINE+1
@00C5 69 00     ; C0C5          adc #0
@00C7 85 01     ; C0C7          sta TXT+1
@00C9 60        ; C0C9          rts
@00CA A9 00     ; C0CA  @end:   lda #0
@00CC 85 02     ; C0CC          sta CURLINE
@00CE 85 03     ; C0CE          sta CURLINE+1
@00D0 4C 72 C0  ; C0D0          jmp finished

; ; A statement: empty at ':' or the end, LET by its letter, else by its token.
; statement:
@00D3 20 93 CD  ; C0D3          jsr peek
@00D6 C9 00     ; C0D6          cmp #0
@00D8 F0 2E     ; C0D8          beq @empty
@00DA C9 3A     ; C0DA          cmp #':'
@00DC F0 2A     ; C0DC          beq @empty
@00DE C9 41     ; C0DE          cmp #'A'
@00E0 90 07     ; C0E0          bcc @token
@00E2 C9 5B     ; C0E2          cmp #'Z'+1
@00E4 B0 03     ; C0E4          bcs @token
@00E6 4C 29 C1  ; C0E6          jmp let
@00E9 C9 80     ; C0E9  @token: cmp #TPRINT
@00EB 90 18     ; C0EB          bcc @bad
@00ED C9 90     ; C0ED          cmp #TNEW+1
@00EF B0 14     ; C0EF          bcs @bad
@00F1 20 A2 CD  ; C0F1          jsr adv
@00F4 38        ; C0F4          sec
@00F5 E9 80     ; C0F5          sbc #TPRINT
@00F7 AA        ; C0F7          tax
@00F8 BD 09 C1  ; C0F8          lda stmtlo,x
@00FB 85 0A     ; C0FB          sta T0
@00FD BD 19 C1  ; C0FD          lda stmthi,x
@0100 85 0B     ; C100          sta T0+1
@0102 6C 0A 00  ; C102          jmp (T0)
@0105 4C 47 CE  ; C105  @bad:   jmp syntax
@0108 60        ; C108  @empty: rts

@0109 3B B9 29 A6 CD ED FB 16  ; C109  stmtlo: .byte <print, <input, <let, <if, <goto, <gosub, <return, <for
@0111 83 07 0C 19 37 3C F0 03  ; C111          .byte <next, <end, <rem, <poke, <cls, <list, <run, <new_
@0119 C1 C1 C1 C2 C2 C2 C2 C3  ; C119  stmthi: .byte >print, >input, >let, >if, >goto, >gosub, >return, >for
@0121 C3 C4 C4 C4 C4 C4 C4 C5  ; C121          .byte >next, >end, >rem, >poke, >cls, >list, >run, >new_

; ; --- Statements ---------------------------------------------------------------------------------

@0129 20 4D CC  ; C129  let:    jsr variable
@012C 85 21     ; C12C          sta VAR
@012E A9 3D     ; C12E          lda #'='
@0130 20 A9 CD  ; C130          jsr expect
@0133 20 8B C9  ; C133          jsr expr
@0136 A6 21     ; C136          ldx VAR
@0138 4C 62 CC  ; C138          jmp setvar

@013B A9 01     ; C13B  print:  lda #1
@013D 85 26     ; C13D          sta NL
@013F 20 93 CD  ; C13F  @loop:  jsr peek
@0142 C9 00     ; C142          cmp #0
@0144 F0 6B     ; C144          beq @end
@0146 C9 3A     ; C146          cmp #':'
@0148 F0 67     ; C148          beq @end
@014A C9 3B     ; C14A          cmp #';'
@014C D0 0A     ; C14C          bne @comma
@014E 20 A2 CD  ; C14E          jsr adv
@0151 A9 00     ; C151          lda #0
@0153 85 26     ; C153          sta NL
@0155 4C 3F C1  ; C155          jmp @loop
@0158 C9 2C     ; C158  @comma: cmp #','
@015A D0 15     ; C15A          bne @string
@015C 20 A2 CD  ; C15C          jsr adv
@015F A9 20     ; C15F  @tab:   lda #' '
@0161 20 B8 CD  ; C161          jsr outc
@0164 A5 10     ; C164          lda COL
@0166 29 07     ; C166          and #7
@0168 D0 F5     ; C168          bne @tab
@016A A9 00     ; C16A          lda #0
@016C 85 26     ; C16C          sta NL
@016E 4C 3F C1  ; C16E          jmp @loop
; @string:
@0171 C9 22     ; C171          cmp #'"'
@0173 D0 1C     ; C173          bne @expr
@0175 20 A2 CD  ; C175          jsr adv
@0178 A0 00     ; C178  @char:  ldy #0
@017A B1 00     ; C17A          lda (TXT),y
@017C F0 19     ; C17C          beq @item
@017E C9 22     ; C17E          cmp #'"'
@0180 F0 09     ; C180          beq @close
@0182 20 B8 CD  ; C182          jsr outc
@0185 20 A2 CD  ; C185          jsr adv
@0188 4C 78 C1  ; C188          jmp @char
@018B 20 A2 CD  ; C18B  @close: jsr adv
@018E 4C 97 C1  ; C18E          jmp @item
@0191 20 8B C9  ; C191  @expr:  jsr expr
@0194 20 E6 CD  ; C194          jsr printacc
@0197 A9 01     ; C197  @item:  lda #1
@0199 85 26     ; C199          sta NL
@019B 20 93 CD  ; C19B          jsr peek
@019E C9 00     ; C19E          cmp #0
@01A0 F0 0F     ; C1A0          beq @end
@01A2 C9 3A     ; C1A2          cmp #':'
@01A4 F0 0B     ; C1A4          beq @end
@01A6 C9 3B     ; C1A6          cmp #';'
@01A8 F0 95     ; C1A8          beq @loop
@01AA C9 2C     ; C1AA          cmp #','
@01AC F0 91     ; C1AC          beq @loop
@01AE 4C 47 CE  ; C1AE          jmp syntax
@01B1 A5 26     ; C1B1  @end:   lda NL
@01B3 F0 03     ; C1B3          beq @done
@01B5 20 D9 CD  ; C1B5          jsr newline
@01B8 60        ; C1B8  @done:  rts

@01B9 20 7B C5  ; C1B9  input:  jsr indirect
@01BC A9 00     ; C1BC          lda #0
@01BE 85 29     ; C1BE          sta PLEN
@01C0 20 93 CD  ; C1C0          jsr peek
@01C3 C9 22     ; C1C3          cmp #'"'
@01C5 D0 28     ; C1C5          bne @var
@01C7 20 A2 CD  ; C1C7          jsr adv
@01CA A5 00     ; C1CA          lda TXT
@01CC 85 27     ; C1CC          sta PROMPT
@01CE A5 01     ; C1CE          lda TXT+1
@01D0 85 28     ; C1D0          sta PROMPT+1
@01D2 A0 00     ; C1D2  @count: ldy #0
@01D4 B1 00     ; C1D4          lda (TXT),y
@01D6 F0 0C     ; C1D6          beq @noclose
@01D8 C9 22     ; C1D8          cmp #'"'
@01DA F0 0B     ; C1DA          beq @closed
@01DC E6 29     ; C1DC          inc PLEN
@01DE 20 A2 CD  ; C1DE          jsr adv
@01E1 4C D2 C1  ; C1E1          jmp @count
; @noclose:
@01E4 4C 47 CE  ; C1E4          jmp syntax
; @closed:
@01E7 20 A2 CD  ; C1E7          jsr adv
@01EA A9 3B     ; C1EA          lda #';'

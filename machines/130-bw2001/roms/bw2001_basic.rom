@061B C5 14     ; C61B          cmp LNUM
@061D A5 0B     ; C61D          lda T0+1
@061F E5 15     ; C61F          sbc LNUM+1
@0621 90 15     ; C621          bcc @after
@0623 A5 0A     ; C623          lda T0
@0625 C5 14     ; C625          cmp LNUM
@0627 D0 1E     ; C627          bne @room
@0629 A5 0B     ; C629          lda T0+1
@062B C5 15     ; C62B          cmp LNUM+1
@062D D0 18     ; C62D          bne @room
@062F A0 02     ; C62F          ldy #2
@0631 B1 2A     ; C631          lda (POSP),y
@0633 85 1D     ; C633          sta OLDLEN
@0635 4C 47 C6  ; C635          jmp @room
@0638 A0 02     ; C638  @after: ldy #2
@063A B1 2A     ; C63A          lda (POSP),y
@063C 18        ; C63C          clc
@063D 65 2A     ; C63D          adc POSP
@063F 85 2A     ; C63F          sta POSP
@0641 90 C7     ; C641          bcc @find
@0643 E6 2B     ; C643          inc POSP+1
@0645 D0 C3     ; C645          bne @find
@0647 38        ; C647  @room:  sec             ; T0 = TOP - OLDLEN + NEWLEN + 2 must not pass MEMTOP
@0648 A5 04     ; C648          lda TOP
@064A E5 1D     ; C64A          sbc OLDLEN
@064C 85 0A     ; C64C          sta T0
@064E A5 05     ; C64E          lda TOP+1
@0650 E9 00     ; C650          sbc #0
@0652 85 0B     ; C652          sta T0+1
@0654 18        ; C654          clc
@0655 A5 0A     ; C655          lda T0
@0657 65 1C     ; C657          adc NEWLEN
@0659 85 0A     ; C659          sta T0
@065B A5 0B     ; C65B          lda T0+1
@065D 69 00     ; C65D          adc #0
@065F 85 0B     ; C65F          sta T0+1
@0661 18        ; C661          clc
@0662 A5 0A     ; C662          lda T0
@0664 69 02     ; C664          adc #2
@0666 85 0A     ; C666          sta T0
@0668 A5 0B     ; C668          lda T0+1
@066A 69 00     ; C66A          adc #0
@066C 85 0B     ; C66C          sta T0+1
@066E A5 60     ; C66E          lda MEMTOP
@0670 C5 0A     ; C670          cmp T0
@0672 A5 61     ; C672          lda MEMTOP+1
@0674 E5 0B     ; C674          sbc T0+1
@0676 B0 05     ; C676          bcs @fits
@0678 A9 08     ; C678          lda #EMEMORY
@067A 4C 49 CE  ; C67A          jmp error
@067D A5 1D     ; C67D  @fits:  lda OLDLEN
@067F F0 26     ; C67F          beq @insert
@0681 18        ; C681          clc             ; down: [POSP + OLDLEN, TOP + 2) to POSP
@0682 A5 2A     ; C682          lda POSP
@0684 65 1D     ; C684          adc OLDLEN
@0686 85 16     ; C686          sta SRCP
@0688 A5 2B     ; C688          lda POSP+1
@068A 69 00     ; C68A          adc #0
@068C 85 17     ; C68C          sta SRCP+1
@068E A5 2A     ; C68E          lda POSP
@0690 85 18     ; C690          sta DSTP
@0692 A5 2B     ; C692          lda POSP+1
@0694 85 19     ; C694          sta DSTP+1
@0696 20 D6 C6  ; C696          jsr span        ; COUNT = TOP + 2 - SRCP
@0699 20 EF C6  ; C699          jsr movedown
@069C 38        ; C69C          sec
@069D A5 04     ; C69D          lda TOP
@069F E5 1D     ; C69F          sbc OLDLEN
@06A1 85 04     ; C6A1          sta TOP
@06A3 B0 02     ; C6A3          bcs @insert
@06A5 C6 05     ; C6A5          dec TOP+1
; @insert:
@06A7 A5 1C     ; C6A7          lda NEWLEN
@06A9 D0 03     ; C6A9          bne @open
@06AB 4C 39 C0  ; C6AB          jmp loop
@06AE A5 2A     ; C6AE  @open:  lda POSP        ; up: [POSP, TOP + 2) to POSP + NEWLEN, from the end
@06B0 85 16     ; C6B0          sta SRCP
@06B2 A5 2B     ; C6B2          lda POSP+1
@06B4 85 17     ; C6B4          sta SRCP+1
@06B6 20 D6 C6  ; C6B6          jsr span
@06B9 20 13 C7  ; C6B9          jsr moveup
@06BC A0 00     ; C6BC          ldy #0
@06BE B9 41 02  ; C6BE  @copy:  lda DIRBUF,y
@06C1 91 2A     ; C6C1          sta (POSP),y
@06C3 C8        ; C6C3          iny
@06C4 C4 1C     ; C6C4          cpy NEWLEN
@06C6 D0 F6     ; C6C6          bne @copy
@06C8 18        ; C6C8          clc
@06C9 A5 04     ; C6C9          lda TOP
@06CB 65 1C     ; C6CB          adc NEWLEN
@06CD 85 04     ; C6CD          sta TOP
@06CF 90 02     ; C6CF          bcc @done
@06D1 E6 05     ; C6D1          inc TOP+1
@06D3 4C 39 C0  ; C6D3  @done:  jmp loop

; ; COUNT = TOP + 2 - SRCP.
@06D6 38        ; C6D6  span:   sec
@06D7 A5 04     ; C6D7          lda TOP
@06D9 E5 16     ; C6D9          sbc SRCP
@06DB 85 1A     ; C6DB          sta COUNT
@06DD A5 05     ; C6DD          lda TOP+1
@06DF E5 17     ; C6DF          sbc SRCP+1
@06E1 85 1B     ; C6E1          sta COUNT+1
@06E3 18        ; C6E3          clc
@06E4 A5 1A     ; C6E4          lda COUNT
@06E6 69 02     ; C6E6          adc #2
@06E8 85 1A     ; C6E8          sta COUNT
@06EA 90 02     ; C6EA          bcc @done
@06EC E6 1B     ; C6EC          inc COUNT+1
@06EE 60        ; C6EE  @done:  rts

; ; COUNT bytes from SRCP to DSTP, ascending.
; movedown:
@06EF A0 00     ; C6EF          ldy #0
@06F1 A5 1A     ; C6F1  @loop:  lda COUNT
@06F3 05 1B     ; C6F3          ora COUNT+1
@06F5 F0 1B     ; C6F5          beq @done
@06F7 B1 16     ; C6F7          lda (SRCP),y
@06F9 91 18     ; C6F9          sta (DSTP),y
@06FB E6 16     ; C6FB          inc SRCP
@06FD D0 02     ; C6FD          bne @s
@06FF E6 17     ; C6FF          inc SRCP+1
@0701 E6 18     ; C701  @s:     inc DSTP
@0703 D0 02     ; C703          bne @d
@0705 E6 19     ; C705          inc DSTP+1
@0707 A5 1A     ; C707  @d:     lda COUNT
@0709 D0 02     ; C709          bne @c
@070B C6 1B     ; C70B          dec COUNT+1
@070D C6 1A     ; C70D  @c:     dec COUNT
@070F 4C F1 C6  ; C70F          jmp @loop
@0712 60        ; C712  @done:  rts

; ; COUNT bytes from SRCP up by NEWLEN, descending.
@0713 18        ; C713  moveup: clc             ; SRCP to the last byte, DSTP NEWLEN above it
@0714 A5 16     ; C714          lda SRCP
@0716 65 1A     ; C716          adc COUNT
@0718 85 16     ; C718          sta SRCP
@071A A5 17     ; C71A          lda SRCP+1
@071C 65 1B     ; C71C          adc COUNT+1
@071E 85 17     ; C71E          sta SRCP+1
@0720 A5 16     ; C720          lda SRCP
@0722 D0 02     ; C722          bne @dec
@0724 C6 17     ; C724          dec SRCP+1
@0726 C6 16     ; C726  @dec:   dec SRCP
@0728 18        ; C728          clc
@0729 A5 16     ; C729          lda SRCP
@072B 65 1C     ; C72B          adc NEWLEN
@072D 85 18     ; C72D          sta DSTP
@072F A5 17     ; C72F          lda SRCP+1
@0731 69 00     ; C731          adc #0
@0733 85 19     ; C733          sta DSTP+1
@0735 A0 00     ; C735          ldy #0
@0737 A5 1A     ; C737  @loop:  lda COUNT
@0739 05 1B     ; C739          ora COUNT+1
@073B F0 1F     ; C73B          beq @done
@073D B1 16     ; C73D          lda (SRCP),y
@073F 91 18     ; C73F          sta (DSTP),y
@0741 A5 16     ; C741          lda SRCP
@0743 D0 02     ; C743          bne @s
@0745 C6 17     ; C745          dec SRCP+1
@0747 C6 16     ; C747  @s:     dec SRCP
@0749 A5 18     ; C749          lda DSTP
@074B D0 02     ; C74B          bne @d
@074D C6 19     ; C74D          dec DSTP+1
@074F C6 18     ; C74F  @d:     dec DSTP
@0751 A5 1A     ; C751          lda COUNT
@0753 D0 02     ; C753          bne @c
@0755 C6 1B     ; C755          dec COUNT+1
@0757 C6 1A     ; C757  @c:     dec COUNT
@0759 4C 37 C7  ; C759          jmp @loop
@075C 60        ; C75C  @done:  rts

; ; UH1 ends here: the rest is in UH5.
;         .org $C7FF
@07FF 40        ; C7FF          .checksum $C000, $800
;         .org $C800

; ; The record of line ACC: POSP, or NO SUCH LINE (BAD VALUE outside 1-9999, signed).
; findline:
@0800 A5 07     ; C800          lda ACC+1
@0802 30 3D     ; C802          bmi @bad
@0804 A5 06     ; C804          lda ACC
@0806 A6 07     ; C806          ldx ACC+1
@0808 20 46 C8  ; C808          jsr inrange
@080B B0 34     ; C80B          bcs @bad
@080D A9 00     ; C80D          lda #<PROGRAM
@080F 85 2A     ; C80F          sta POSP
@0811 A9 04     ; C811          lda #>PROGRAM
@0813 85 2B     ; C813          sta POSP+1
@0815 A0 00     ; C815  @next:  ldy #0
@0817 B1 2A     ; C817          lda (POSP),y
@0819 C8        ; C819          iny
@081A 11 2A     ; C81A          ora (POSP),y
@081C F0 1D     ; C81C          beq @none
@081E 88        ; C81E          dey
@081F B1 2A     ; C81F          lda (POSP),y
@0821 C5 06     ; C821          cmp ACC
@0823 D0 07     ; C823          bne @on
@0825 C8        ; C825          iny
@0826 B1 2A     ; C826          lda (POSP),y
@0828 C5 07     ; C828          cmp ACC+1
@082A F0 14     ; C82A          beq @found
@082C A0 02     ; C82C  @on:    ldy #2
@082E B1 2A     ; C82E          lda (POSP),y
@0830 18        ; C830          clc
@0831 65 2A     ; C831          adc POSP
@0833 85 2A     ; C833          sta POSP
@0835 90 DE     ; C835          bcc @next
@0837 E6 2B     ; C837          inc POSP+1
@0839 D0 DA     ; C839          bne @next
@083B A9 02     ; C83B  @none:  lda #ENOLINE
@083D 4C 49 CE  ; C83D          jmp error
@0840 60        ; C840  @found: rts
@0841 A9 07     ; C841  @bad:   lda #EVALUE
@0843 4C 49 CE  ; C843          jmp error

; ; Carry clear when A (low) X (high) is 1-9999, unsigned.
; inrange:
@0846 E0 00     ; C846          cpx #0
@0848 D0 06     ; C848          bne @high
@084A C9 00     ; C84A          cmp #0
@084C F0 0E     ; C84C          beq @out
@084E 18        ; C84E          clc
@084F 60        ; C84F          rts
@0850 E0 27     ; C850  @high:  cpx #>9999
@0852 90 06     ; C852          bcc @in
@0854 D0 06     ; C854          bne @out
@0856 C9 10     ; C856          cmp #<9999+1
@0858 B0 02     ; C858          bcs @out
@085A 18        ; C85A  @in:    clc
@085B 60        ; C85B          rts
@085C 38        ; C85C  @out:   sec
@085D 60        ; C85D          rts

; ; LINBUF from X tokenised into DIRBUF+3, $00-terminated; NEWLEN the record's length.
; tokenise:
@085E A9 03     ; C85E          lda #3
@0860 85 1E     ; C860          sta W
@0862 A9 00     ; C862          lda #0
@0864 85 1F     ; C864          sta QUOTE
@0866 BD 00 02  ; C866  @loop:  lda LINBUF,x
@0869 F0 4A     ; C869          beq @end
@086B A4 1F     ; C86B          ldy QUOTE
@086D D0 0D     ; C86D          bne @inquote
@086F C9 22     ; C86F          cmp #'"'
@0871 D0 16     ; C871          bne @word
@0873 A9 01     ; C873          lda #1
@0875 85 1F     ; C875          sta QUOTE
@0877 A9 22     ; C877          lda #'"'
@0879 4C AB C8  ; C879          jmp @copy
; @inquote:
@087C C9 22     ; C87C          cmp #'"'
@087E D0 2B     ; C87E          bne @copy
@0880 A9 00     ; C880          lda #0
@0882 85 1F     ; C882          sta QUOTE
@0884 A9 22     ; C884          lda #'"'
@0886 4C AB C8  ; C886          jmp @copy
@0889 20 C0 C8  ; C889  @word:  jsr keyword
@088C 90 1A     ; C88C          bcc @plain
@088E A4 1E     ; C88E          ldy W
@0890 99 41 02  ; C890          sta DIRBUF,y
@0893 E6 1E     ; C893          inc W
@0895 C9 8A     ; C895          cmp #TREM
@0897 D0 CD     ; C897          bne @loop
@0899 BD 00 02  ; C899  @rest:  lda LINBUF,x
@089C F0 17     ; C89C          beq @end
@089E A4 1E     ; C89E          ldy W
@08A0 99 41 02  ; C8A0          sta DIRBUF,y
@08A3 E6 1E     ; C8A3          inc W
@08A5 E8        ; C8A5          inx
@08A6 D0 F1     ; C8A6          bne @rest
@08A8 BD 00 02  ; C8A8  @plain: lda LINBUF,x
@08AB A4 1E     ; C8AB  @copy:  ldy W
@08AD 99 41 02  ; C8AD          sta DIRBUF,y
@08B0 E6 1E     ; C8B0          inc W
@08B2 E8        ; C8B2          inx
@08B3 D0 B1     ; C8B3          bne @loop
@08B5 A4 1E     ; C8B5  @end:   ldy W
@08B7 A9 00     ; C8B7          lda #0
@08B9 99 41 02  ; C8B9          sta DIRBUF,y
@08BC C8        ; C8BC          iny
@08BD 84 1C     ; C8BD          sty NEWLEN
@08BF 60        ; C8BF          rts

; ; The keyword at LINBUF,X, if any: carry set, A its token, X past it.
; keyword:
@08C0 86 2F     ; C8C0          stx KX
@08C2 A9 2F     ; C8C2          lda #<words
@08C4 85 2C     ; C8C4          sta KP
@08C6 A9 C9     ; C8C6          lda #>words
@08C8 85 2D     ; C8C8          sta KP+1
@08CA A9 80     ; C8CA          lda #TPRINT
@08CC 85 2E     ; C8CC          sta KW
@08CE A0 00     ; C8CE  @try:   ldy #0
@08D0 A6 2F     ; C8D0          ldx KX
@08D2 B1 2C     ; C8D2  @char:  lda (KP),y
@08D4 F0 2A     ; C8D4          beq @none
@08D6 85 3B     ; C8D6          sta KC
@08D8 29 7F     ; C8D8          and #$7F
@08DA DD 00 02  ; C8DA          cmp LINBUF,x
@08DD D0 0A     ; C8DD          bne @skip
@08DF E8        ; C8DF          inx
@08E0 C8        ; C8E0          iny
@08E1 A5 3B     ; C8E1          lda KC
@08E3 10 ED     ; C8E3          bpl @char
@08E5 A5 2E     ; C8E5          lda KW
@08E7 38        ; C8E7          sec
@08E8 60        ; C8E8          rts
@08E9 B1 2C     ; C8E9  @skip:  lda (KP),y
@08EB 30 03     ; C8EB          bmi @last
@08ED C8        ; C8ED          iny
@08EE D0 F9     ; C8EE          bne @skip
@08F0 C8        ; C8F0  @last:  iny
@08F1 98        ; C8F1          tya
@08F2 18        ; C8F2          clc
@08F3 65 2C     ; C8F3          adc KP
@08F5 85 2C     ; C8F5          sta KP
@08F7 90 02     ; C8F7          bcc @n
@08F9 E6 2D     ; C8F9          inc KP+1
@08FB E6 2E     ; C8FB  @n:     inc KW
@08FD 4C CE C8  ; C8FD          jmp @try
@0900 A6 2F     ; C900  @none:  ldx KX
@0902 18        ; C902          clc
@0903 60        ; C903          rts

; ; Prints byte A of a line as LIST shows it: a token as its keyword.
; outtoken:
@0904 C9 80     ; C904          cmp #TPRINT
@0906 B0 03     ; C906          bcs @word
@0908 4C B8 CD  ; C908          jmp outc
@090B 38        ; C90B  @word:  sec
@090C E9 80     ; C90C          sbc #TPRINT
@090E AA        ; C90E          tax
@090F A0 00     ; C90F          ldy #0
@0911 E0 00     ; C911  @find:  cpx #0
@0913 F0 0C     ; C913          beq @print
@0915 B9 2F C9  ; C915  @skip:  lda words,y
@0918 C8        ; C918          iny
@0919 29 80     ; C919          and #$80
@091B F0 F8     ; C91B          beq @skip
@091D CA        ; C91D          dex
@091E 4C 11 C9  ; C91E          jmp @find
@0921 B9 2F C9  ; C921  @print: lda words,y
@0924 48        ; C924          pha
@0925 29 7F     ; C925          and #$7F
@0927 20 B8 CD  ; C927          jsr outc
@092A C8        ; C92A          iny
@092B 68        ; C92B          pla
@092C 10 F3     ; C92C          bpl @print
@092E 60        ; C92E          rts

; ; P5o's keywords in token order, each last letter with bit 7 set; 0 ends the table.
@092F 50 52 49 4E D4 49 4E 50 55 D4 4C 45 D4 49 C6  ; C92F  words:  .byte "PRIN", 'T'|$80, "INPU", 'T'|$80, "LE", 'T'|$80, "I", 'F'|$80
@093E 47 4F 54 CF 47 4F 53 55 C2 52 45 54 55 52 CE 46  ; C93E          .byte "GOT", 'O'|$80, "GOSU", 'B'|$80, "RETUR", 'N'|$80, "FO", 'R'|$80
@094E 4F D2
@0950 4E 45 58 D4 45 4E C4 52 45 CD 50 4F 4B C5  ; C950          .byte "NEX", 'T'|$80, "EN", 'D'|$80, "RE", 'M'|$80, "POK", 'E'|$80
@095E 43 4C D3 4C 49 53 D4 52 55 CE 4E 45 D7  ; C95E          .byte "CL", 'S'|$80, "LIS", 'T'|$80, "RU", 'N'|$80, "NE", 'W'|$80
@096B 54 48 45 CE 54 CF 53 54 45 D0 41 4E C4  ; C96B          .byte "THE", 'N'|$80, "T", 'O'|$80, "STE", 'P'|$80, "AN", 'D'|$80
@0978 4F D2 4E 4F D4 50 45 45 CB 52 4E C4  ; C978          .byte "O", 'R'|$80, "NO", 'T'|$80, "PEE", 'K'|$80, "RN", 'D'|$80
@0984 41 42 D3 55 53 D2 00  ; C984          .byte "AB", 'S'|$80, "US", 'R'|$80, 0

; ; --- Expressions (design §6.6), P5o's eight levels from the loosest -----------------------------

@098B A9 00     ; C98B  expr:   lda #0
@098D 85 0E     ; C98D          sta DEPTH
@098F 20 B5 C9  ; C98F  orlv:   jsr andlv
@0992 20 93 CD  ; C992  @loop:  jsr peek
@0995 C9 94     ; C995          cmp #TOR
@0997 D0 1B     ; C997          bne @done
@0999 20 A2 CD  ; C999          jsr adv
@099C 20 70 CC  ; C99C          jsr pushacc
@099F 20 B5 C9  ; C99F          jsr andlv
@09A2 20 83 CC  ; C9A2          jsr pullarg
@09A5 A5 08     ; C9A5          lda ARG
@09A7 05 06     ; C9A7          ora ACC
@09A9 85 06     ; C9A9          sta ACC
@09AB A5 09     ; C9AB          lda ARG+1
@09AD 05 07     ; C9AD          ora ACC+1
@09AF 85 07     ; C9AF          sta ACC+1
@09B1 4C 92 C9  ; C9B1          jmp @loop
@09B4 60        ; C9B4  @done:  rts

@09B5 20 DB C9  ; C9B5  andlv:  jsr notlv
@09B8 20 93 CD  ; C9B8  @loop:  jsr peek
@09BB C9 93     ; C9BB          cmp #TAND
@09BD D0 1B     ; C9BD          bne @done
@09BF 20 A2 CD  ; C9BF          jsr adv
@09C2 20 70 CC  ; C9C2          jsr pushacc
@09C5 20 DB C9  ; C9C5          jsr notlv
@09C8 20 83 CC  ; C9C8          jsr pullarg
@09CB A5 08     ; C9CB          lda ARG
@09CD 25 06     ; C9CD          and ACC
@09CF 85 06     ; C9CF          sta ACC
@09D1 A5 09     ; C9D1          lda ARG+1
@09D3 25 07     ; C9D3          and ACC+1
@09D5 85 07     ; C9D5          sta ACC+1
@09D7 4C B8 C9  ; C9D7          jmp @loop
@09DA 60        ; C9DA  @done:  rts

@09DB 20 93 CD  ; C9DB  notlv:  jsr peek
@09DE C9 95     ; C9DE          cmp #TNOT
@09E0 D0 18     ; C9E0          bne cmplv
@09E2 20 A2 CD  ; C9E2          jsr adv
@09E5 20 D2 CB  ; C9E5          jsr deeper
@09E8 20 DB C9  ; C9E8          jsr notlv
@09EB A5 06     ; C9EB          lda ACC
@09ED 49 FF     ; C9ED          eor #$FF
@09EF 85 06     ; C9EF          sta ACC
@09F1 A5 07     ; C9F1          lda ACC+1
@09F3 49 FF     ; C9F3          eor #$FF
@09F5 85 07     ; C9F5          sta ACC+1
@09F7 C6 0E     ; C9F7          dec DEPTH
@09F9 60        ; C9F9          rts

; ; Comparisons, left to right: true -1, false 0. The operator as the results it accepts: bit 0
; ; less, bit 1 equal, bit 2 greater. The second character follows with no space.
@09FA 20 78 CA  ; C9FA  cmplv:  jsr addlv
@09FD 20 93 CD  ; C9FD  @loop:  jsr peek
@0A00 C9 3D     ; CA00          cmp #'='
@0A02 D0 05     ; CA02          bne @less
@0A04 A9 02     ; CA04          lda #2
@0A06 4C 45 CA  ; CA06          jmp @op
@0A09 C9 3C     ; CA09  @less:  cmp #'<'
@0A0B D0 1E     ; CA0B          bne @greater
@0A0D 20 A2 CD  ; CA0D          jsr adv
@0A10 A0 00     ; CA10          ldy #0
@0A12 B1 00     ; CA12          lda (TXT),y
@0A14 C9 3E     ; CA14          cmp #'>'
@0A16 D0 05     ; CA16          bne @le
@0A18 A9 05     ; CA18          lda #5
@0A1A 4C 45 CA  ; CA1A          jmp @op
@0A1D C9 3D     ; CA1D  @le:    cmp #'='
@0A1F D0 05     ; CA1F          bne @lt
@0A21 A9 03     ; CA21          lda #3

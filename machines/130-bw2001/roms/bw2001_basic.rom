@0D81 45 0B     ; CD81          eor T0+1
@0D83 85 12     ; CD83          sta SEED+1
@0D85 A5 12     ; CD85          lda SEED+1      ; >> 9: the high byte >> 1
@0D87 4A        ; CD87          lsr
@0D88 45 11     ; CD88          eor SEED
@0D8A 85 11     ; CD8A          sta SEED
@0D8C A5 11     ; CD8C          lda SEED        ; << 8: the low byte into the high
@0D8E 45 12     ; CD8E          eor SEED+1
@0D90 85 12     ; CD90          sta SEED+1
@0D92 60        ; CD92          rts

; ; --- Reading the line ------------------------------------------------------------------------------

; ; Spaces skipped; A the byte at TXT (0 at the line's end), not taken.
@0D93 A0 00     ; CD93  peek:   ldy #0
@0D95 B1 00     ; CD95  @loop:  lda (TXT),y
@0D97 C9 20     ; CD97          cmp #' '
@0D99 D0 06     ; CD99          bne @done
@0D9B 20 A2 CD  ; CD9B          jsr adv
@0D9E 4C 95 CD  ; CD9E          jmp @loop
@0DA1 60        ; CDA1  @done:  rts

@0DA2 E6 00     ; CDA2  adv:    inc TXT
@0DA4 D0 02     ; CDA4          bne @done
@0DA6 E6 01     ; CDA6          inc TXT+1
@0DA8 60        ; CDA8  @done:  rts

; ; The byte A next, after spaces, else SYNTAX.
@0DA9 85 3B     ; CDA9  expect: sta KC
@0DAB 20 93 CD  ; CDAB          jsr peek
@0DAE C5 3B     ; CDAE          cmp KC
@0DB0 D0 03     ; CDB0          bne @bad
@0DB2 4C A2 CD  ; CDB2          jmp adv
@0DB5 4C 47 CE  ; CDB5  @bad:   jmp syntax

; ; --- Output, with BASIC's column -------------------------------------------------------------------

@0DB8 20 03 E0  ; CDB8  outc:   jsr EDPRINT
@0DBB C9 0D     ; CDBB          cmp #$0D
@0DBD F0 13     ; CDBD          beq @zero
@0DBF C9 0C     ; CDBF          cmp #$0C
@0DC1 F0 0F     ; CDC1          beq @zero
@0DC3 E6 10     ; CDC3          inc COL
@0DC5 48        ; CDC5          pha
@0DC6 A5 10     ; CDC6          lda COL
@0DC8 C9 28     ; CDC8          cmp #COLUMNS
@0DCA D0 04     ; CDCA          bne @kept
@0DCC A9 00     ; CDCC          lda #0
@0DCE 85 10     ; CDCE          sta COL
@0DD0 68        ; CDD0  @kept:  pla
@0DD1 60        ; CDD1          rts
@0DD2 48        ; CDD2  @zero:  pha
@0DD3 A9 00     ; CDD3          lda #0
@0DD5 85 10     ; CDD5          sta COL
@0DD7 68        ; CDD7          pla
@0DD8 60        ; CDD8          rts

; newline:
@0DD9 A9 0D     ; CDD9          lda #$0D
@0DDB 4C B8 CD  ; CDDB          jmp outc

@0DDE A5 10     ; CDDE  fresh:  lda COL
@0DE0 F0 03     ; CDE0          beq @done
@0DE2 4C D9 CD  ; CDE2          jmp newline
@0DE5 60        ; CDE5  @done:  rts

; printacc:
@0DE6 A5 06     ; CDE6          lda ACC
@0DE8 A4 07     ; CDE8          ldy ACC+1
@0DEA 85 30     ; CDEA  numout: sta NUM
@0DEC 84 31     ; CDEC          sty NUM+1
@0DEE 98        ; CDEE          tya
@0DEF 10 12     ; CDEF          bpl @pos
@0DF1 A9 2D     ; CDF1          lda #'-'
@0DF3 20 B8 CD  ; CDF3          jsr outc
@0DF6 38        ; CDF6          sec
@0DF7 A9 00     ; CDF7          lda #0
@0DF9 E5 30     ; CDF9          sbc NUM
@0DFB 85 30     ; CDFB          sta NUM
@0DFD A9 00     ; CDFD          lda #0
@0DFF E5 31     ; CDFF          sbc NUM+1
@0E01 85 31     ; CE01          sta NUM+1
@0E03 A9 00     ; CE03  @pos:   lda #0
@0E05 85 32     ; CE05          sta NZ
@0E07 A2 00     ; CE07          ldx #0
@0E09 A0 30     ; CE09  @power: ldy #'0'
@0E0B 38        ; CE0B  @sub:   sec
@0E0C A5 30     ; CE0C          lda NUM
@0E0E FD 3F CE  ; CE0E          sbc powlo,x
@0E11 48        ; CE11          pha
@0E12 A5 31     ; CE12          lda NUM+1
@0E14 FD 43 CE  ; CE14          sbc powhi,x
@0E17 90 09     ; CE17          bcc @digit
@0E19 85 31     ; CE19          sta NUM+1
@0E1B 68        ; CE1B          pla
@0E1C 85 30     ; CE1C          sta NUM
@0E1E C8        ; CE1E          iny
@0E1F 4C 0B CE  ; CE1F          jmp @sub
@0E22 68        ; CE22  @digit: pla
@0E23 C0 30     ; CE23          cpy #'0'
@0E25 D0 04     ; CE25          bne @print
@0E27 A5 32     ; CE27          lda NZ
@0E29 F0 08     ; CE29          beq @skip
@0E2B 98        ; CE2B  @print: tya
@0E2C 20 B8 CD  ; CE2C          jsr outc
@0E2F A9 01     ; CE2F          lda #1
@0E31 85 32     ; CE31          sta NZ
@0E33 E8        ; CE33  @skip:  inx
@0E34 E0 04     ; CE34          cpx #4
@0E36 D0 D1     ; CE36          bne @power
@0E38 A5 30     ; CE38          lda NUM
@0E3A 09 30     ; CE3A          ora #'0'
@0E3C 4C B8 CD  ; CE3C          jmp outc

@0E3F 10 E8 64 0A  ; CE3F  powlo:  .byte <10000, <1000, <100, <10
@0E43 27 03 00 00  ; CE43  powhi:  .byte >10000, >1000, >100, >10

; ; --- Errors -----------------------------------------------------------------------------------------

@0E47 A9 01     ; CE47  syntax: lda #ESYNTAX
@0E49 85 3C     ; CE49  error:  sta ECODE
@0E4B A6 13     ; CE4B          ldx ERRSP
@0E4D 9A        ; CE4D          txs
@0E4E 20 DE CD  ; CE4E          jsr fresh
@0E51 A6 3C     ; CE51          ldx ECODE
@0E53 BD CD CE  ; CE53          lda msglo-1,x
@0E56 85 0A     ; CE56          sta T0
@0E58 BD D6 CE  ; CE58          lda msghi-1,x
@0E5B 85 0B     ; CE5B          sta T0+1
@0E5D A0 00     ; CE5D          ldy #0
@0E5F B1 0A     ; CE5F  @msg:   lda (T0),y
@0E61 F0 06     ; CE61          beq @word
@0E63 20 B8 CD  ; CE63          jsr outc
@0E66 C8        ; CE66          iny
@0E67 D0 F6     ; CE67          bne @msg
@0E69 A2 00     ; CE69  @word:  ldx #0
@0E6B BD BC CE  ; CE6B  @e:     lda errortext,x
@0E6E F0 06     ; CE6E          beq @where
@0E70 20 B8 CD  ; CE70          jsr outc
@0E73 E8        ; CE73          inx
@0E74 D0 F5     ; CE74          bne @e
@0E76 20 9B CE  ; CE76  @where: jsr inline
@0E79 20 D9 CD  ; CE79          jsr newline
@0E7C 4C 23 C0  ; CE7C          jmp ready

; dobreak:
@0E7F A6 13     ; CE7F          ldx ERRSP
@0E81 9A        ; CE81          txs
@0E82 20 DE CD  ; CE82          jsr fresh
@0E85 A2 00     ; CE85          ldx #0
@0E87 BD C3 CE  ; CE87  @b:     lda breaktext,x
@0E8A F0 06     ; CE8A          beq @where
@0E8C 20 B8 CD  ; CE8C          jsr outc
@0E8F E8        ; CE8F          inx
@0E90 D0 F5     ; CE90          bne @b
@0E92 20 9B CE  ; CE92  @where: jsr inline
@0E95 20 D9 CD  ; CE95          jsr newline
@0E98 4C 23 C0  ; CE98          jmp ready

; ; " IN n" when a program line was running.
@0E9B A5 02     ; CE9B  inline: lda CURLINE
@0E9D 05 03     ; CE9D          ora CURLINE+1
@0E9F F0 1A     ; CE9F          beq @done
@0EA1 A2 00     ; CEA1          ldx #0
@0EA3 BD C9 CE  ; CEA3  @in:    lda intext,x
@0EA6 F0 06     ; CEA6          beq @number
@0EA8 20 B8 CD  ; CEA8          jsr outc
@0EAB E8        ; CEAB          inx
@0EAC D0 F5     ; CEAC          bne @in
; @number:
@0EAE A0 00     ; CEAE          ldy #0
@0EB0 B1 02     ; CEB0          lda (CURLINE),y
@0EB2 48        ; CEB2          pha
@0EB3 C8        ; CEB3          iny
@0EB4 B1 02     ; CEB4          lda (CURLINE),y
@0EB6 A8        ; CEB6          tay
@0EB7 68        ; CEB7          pla
@0EB8 4C EA CD  ; CEB8          jmp numout
@0EBB 60        ; CEBB  @done:  rts

; errortext:
@0EBC 20 45 52 52 4F 52 00  ; CEBC          .byte " ERROR", 0
; breaktext:
@0EC3 42 52 45 41 4B 00  ; CEC3          .byte "BREAK", 0
@0EC9 20 49 4E 20 00  ; CEC9  intext: .byte " IN ", 0

@0ECE E0 E7 F4 FD 04 0D 1C 26 34  ; CECE  msglo:  .byte <m1, <m2, <m3, <m4, <m5, <m6, <m7, <m8, <m9
@0ED7 CE CE CE CE CF CF CF CF CF  ; CED7  msghi:  .byte >m1, >m2, >m3, >m4, >m5, >m6, >m7, >m8, >m9
@0EE0 53 59 4E 54 41 58 00  ; CEE0  m1:     .byte "SYNTAX", 0
@0EE7 4E 4F 20 53 55 43 48 20 4C 49 4E 45 00  ; CEE7  m2:     .byte "NO SUCH LINE", 0
@0EF4 4E 4F 20 47 4F 53 55 42 00  ; CEF4  m3:     .byte "NO GOSUB", 0
@0EFD 4E 4F 20 46 4F 52 00  ; CEFD  m4:     .byte "NO FOR", 0
@0F04 54 4F 4F 20 44 45 45 50 00  ; CF04  m5:     .byte "TOO DEEP", 0
@0F0D 44 49 56 49 44 45 20 42 59 20 5A 45 52 4F 00  ; CF0D  m6:     .byte "DIVIDE BY ZERO", 0
@0F1C 42 41 44 20 56 41 4C 55 45 00  ; CF1C  m7:     .byte "BAD VALUE", 0
@0F26 4F 55 54 20 4F 46 20 4D 45 4D 4F 52 59 00  ; CF26  m8:     .byte "OUT OF MEMORY", 0
@0F34 49 4C 4C 45 47 41 4C 20 44 49 52 45 43 54 00  ; CF34  m9:     .byte "ILLEGAL DIRECT", 0

; ; --- NEW and RUN's clearing ---------------------------------------------------------------------------

@0F43 A9 00     ; CF43  new:    lda #<PROGRAM
@0F45 85 04     ; CF45          sta TOP
@0F47 A9 04     ; CF47          lda #>PROGRAM
@0F49 85 05     ; CF49          sta TOP+1
@0F4B A9 00     ; CF4B          lda #0
@0F4D 8D 00 04  ; CF4D          sta PROGRAM
@0F50 8D 01 04  ; CF50          sta PROGRAM+1
@0F53 A9 00     ; CF53  clear:  lda #0
@0F55 A2 33     ; CF55          ldx #2*26-1
@0F57 9D 00 03  ; CF57  @vars:  sta VARS,x
@0F5A CA        ; CF5A          dex
@0F5B 10 FA     ; CF5B          bpl @vars
@0F5D 85 0F     ; CF5D          sta CSP
@0F5F 85 12     ; CF5F          sta SEED+1
@0F61 A9 01     ; CF61          lda #1
@0F63 85 11     ; CF63          sta SEED
@0F65 60        ; CF65          rts


@0231 4C EF C1  ; C231          jmp @var
@0234 60        ; C234  @done:  rts
@0235 A2 00     ; C235  @redo:  ldx #0
@0237 BD 48 C2  ; C237  @r:     lda redotext,x
@023A F0 06     ; C23A          beq @rnl
@023C 20 B8 CD  ; C23C          jsr outc
@023F E8        ; C23F          inx
@0240 D0 F5     ; C240          bne @r
@0242 20 D9 CD  ; C242  @rnl:   jsr newline
@0245 4C F4 C1  ; C245          jmp @ask

; redotext:
@0248 52 45 44 4F 00  ; C248          .byte "REDO", 0

; ; INPUT's answer in LINBUF: spaces, an optional sign, 1-5 digits worth 0-65535, spaces. ACC, or
; ; carry set for REDO.
@024D A2 00     ; C24D  answer: ldx #0
@024F 86 20     ; C24F          stx SIGN
@0251 86 06     ; C251          stx ACC
@0253 86 07     ; C253          stx ACC+1
@0255 BD 00 02  ; C255  @lead:  lda LINBUF,x
@0258 C9 20     ; C258          cmp #' '
@025A D0 03     ; C25A          bne @sign
@025C E8        ; C25C          inx
@025D D0 F6     ; C25D          bne @lead
@025F C9 2B     ; C25F  @sign:  cmp #'+'
@0261 F0 08     ; C261          beq @signed
@0263 C9 2D     ; C263          cmp #'-'
@0265 D0 05     ; C265          bne @digits
@0267 A9 01     ; C267          lda #1
@0269 85 20     ; C269          sta SIGN
; @signed:
@026B E8        ; C26B          inx
; @digits:
@026C A0 00     ; C26C          ldy #0
@026E BD 00 02  ; C26E  @digit: lda LINBUF,x
@0271 C9 30     ; C271          cmp #'0'
@0273 90 14     ; C273          bcc @trail
@0275 C9 3A     ; C275          cmp #'9'+1
@0277 B0 10     ; C277          bcs @trail
@0279 C0 05     ; C279          cpy #5
@027B F0 27     ; C27B          beq @bad
@027D 29 0F     ; C27D          and #$0F
@027F 20 13 CC  ; C27F          jsr times10
@0282 B0 20     ; C282          bcs @bad
@0284 E8        ; C284          inx
@0285 C8        ; C285          iny
@0286 4C 6E C2  ; C286          jmp @digit
@0289 C0 00     ; C289  @trail: cpy #0
@028B F0 17     ; C28B          beq @bad
@028D BD 00 02  ; C28D  @sp:    lda LINBUF,x
@0290 C9 20     ; C290          cmp #' '
@0292 D0 03     ; C292          bne @end
@0294 E8        ; C294          inx
@0295 D0 F6     ; C295          bne @sp
@0297 C9 00     ; C297  @end:   cmp #0
@0299 D0 09     ; C299          bne @bad
@029B A5 20     ; C29B          lda SIGN
@029D F0 03     ; C29D          beq @ok
@029F 20 96 CC  ; C29F          jsr negate
@02A2 18        ; C2A2  @ok:    clc
@02A3 60        ; C2A3          rts
@02A4 38        ; C2A4  @bad:   sec

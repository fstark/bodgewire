; ; NEWLEN bytes of DIRBUF in place of line LNUM (OLDLEN bytes, 0 if none), if they fit below
; ; MEMTOP with the end marker; else OUT OF MEMORY with nothing moved.
@05FE A9 00     ; C5FE  store:  lda #<PROGRAM

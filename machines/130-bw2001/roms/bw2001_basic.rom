@020A 20 B8 CD  ; C20A          jsr outc
@020D 20 09 E0  ; C20D          jsr EDINPUT
@0210 90 03     ; C210          bcc @got
@0212 4C 7F CE  ; C212          jmp dobreak
@0215 A9 00     ; C215  @got:   lda #0
@0217 85 10     ; C217          sta COL
@0219 20 4D C2  ; C219          jsr answer
@021C B0 17     ; C21C          bcs @redo
@021E A6 21     ; C21E          ldx VAR
@0220 20 62 CC  ; C220          jsr setvar
@0223 A9 00     ; C223          lda #0
@0225 85 29     ; C225          sta PLEN
@0227 20 93 CD  ; C227          jsr peek
@022A C9 2C     ; C22A          cmp #','
@022C D0 06     ; C22C          bne @done

@01EF 20 4D CC  ; C1EF  @var:   jsr variable
@01F2 85 21     ; C1F2          sta VAR
@01F4 A0 00     ; C1F4  @ask:   ldy #0
; @prompt:
@01F6 C4 29     ; C1F6          cpy PLEN
@01F8 F0 09     ; C1F8          beq @mark
@01FA B1 27     ; C1FA          lda (PROMPT),y
@01FC 20 B8 CD  ; C1FC          jsr outc
@01FF C8        ; C1FF          iny

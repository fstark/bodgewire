@05C2 20 46 C8  ; C5C2          jsr inrange
@05C5 B0 32     ; C5C5          bcs @bad
@05C7 A2 00     ; C5C7          ldx #0          ; back past the digits: they were counted from the line's start
@05C9 BD 00 02  ; C5C9  @skip:  lda LINBUF,x
@05CC C9 20     ; C5CC          cmp #' '
@05CE F0 08     ; C5CE          beq @next
@05D0 C9 30     ; C5D0          cmp #'0'

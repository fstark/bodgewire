; ; --- The control stack ----------------------------------------------------------------------------

; ; Y = entry X's offset in CSTACK.
; entryof:
@050B BD 10 C5  ; C50B          lda offsets,x
@050E A8        ; C50E          tay
@050F 60        ; C50F          rts
; offsets:
@0510 00 09 12 1B 24 2D 36 3F  ; C510          .byte 0, ENTRY, 2*ENTRY, 3*ENTRY, 4*ENTRY, 5*ENTRY, 6*ENTRY, 7*ENTRY

; ; Pushes an entry of type A: ACC the limit, ARG the step (FOR), CURLINE and TXT the place to
; ; go back to. A ninth is TOO DEEP.
@0518 A6 0F     ; C518  push:   ldx CSP
@051A E0 08     ; C51A          cpx #8
@051C 90 05     ; C51C          bcc @room
@051E A9 05     ; C51E          lda #EDEEP
@0520 4C 49 CE  ; C520          jmp error
@0523 48        ; C523  @room:  pha
@0524 20 0B C5  ; C524          jsr entryof
@0527 68        ; C527          pla
@0528 99 90 02  ; C528          sta CSTACK,y
@052B A5 06     ; C52B          lda ACC
@052D 99 91 02  ; C52D          sta CSTACK+1,y
@0530 A5 07     ; C530          lda ACC+1
@0532 99 92 02  ; C532          sta CSTACK+2,y
@0535 A5 08     ; C535          lda ARG
@0537 99 93 02  ; C537          sta CSTACK+3,y
@053A A5 09     ; C53A          lda ARG+1
@053C 99 94 02  ; C53C          sta CSTACK+4,y
@053F A5 02     ; C53F          lda CURLINE
@0541 99 95 02  ; C541          sta CSTACK+5,y
@0544 A5 03     ; C544          lda CURLINE+1
@0546 99 96 02  ; C546          sta CSTACK+6,y
@0549 A5 00     ; C549          lda TXT
@054B 99 97 02  ; C54B          sta CSTACK+7,y
@054E A5 01     ; C54E          lda TXT+1
@0550 99 98 02  ; C550          sta CSTACK+8,y
@0553 E6 0F     ; C553          inc CSP
@0555 60        ; C555          rts

; ; The innermost FOR of variable A ($FF: any) above the innermost GOSUB: carry set, X its index.
; findfor:
@0556 85 3B     ; C556          sta KC
@0558 A6 0F     ; C558          ldx CSP
@055A F0 1D     ; C55A  @down:  beq @none
@055C CA        ; C55C          dex
@055D 20 0B C5  ; C55D          jsr entryof
@0560 B9 90 02  ; C560          lda CSTACK,y
@0563 C9 80     ; C563          cmp #GOSUBT
@0565 F0 12     ; C565          beq @none
@0567 A5 3B     ; C567          lda KC
@0569 C9 FF     ; C569          cmp #$FF
@056B F0 05     ; C56B          beq @found
@056D D9 90 02  ; C56D          cmp CSTACK,y
@0570 D0 02     ; C570          bne @down2
@0572 38        ; C572  @found: sec
@0573 60        ; C573          rts
@0574 E0 00     ; C574  @down2: cpx #0
@0576 4C 5A C5  ; C576          jmp @down
@0579 18        ; C579  @none:  clc
@057A 60        ; C57A          rts

; ; ILLEGAL DIRECT in the direct line.
; indirect:
@057B A5 02     ; C57B          lda CURLINE
@057D 05 03     ; C57D          ora CURLINE+1
@057F D0 05     ; C57F          bne @ok
@0581 A9 09     ; C581          lda #EDIRECT
@0583 4C 49 CE  ; C583          jmp error
@0586 60        ; C586  @ok:    rts

; ; --- Lines (design §6.4) ----------------------------------------------------------------------------

; ; A program line in LINBUF from X: its number (1-9999, else BAD VALUE), the spaces after it,
; ; then its text stored, or the line deleted when there is none.
; progline:
@0587 A9 00     ; C587          lda #0

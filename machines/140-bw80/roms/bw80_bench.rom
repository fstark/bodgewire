; Generated by bw asm from bw80_bench.asm: do not edit. Edit the .asm and run bw asm again.
; ; BW-80 chips bench program (P5u): tests/data/bw80_bench.bwn, docs/p5u-bw80-chips/
; ; BW80_CHIPS_DESIGN.md §6.2. On the ZX80's CPU, ROM, RAM and data bus resistors: tests the RAM,
; ; runs a line of character codes in the RAM's $C000 mirror (each fetch forced to a NOP by the
; ; 74LS05s while the 74LS373 latches the code), writes into the ROM's space, then reads two
; ; keyboard rows forever. Results in RAM: STATUS $55 when every check passed, else the code of the
; ; first that failed; KEYS8 and KEYS9 the last reads of the rows on A8 and A9.

;         .cpu z80
;         .rom $0000, $1000

; STATUS = $4000          ; $55 passed; $E1 RAM, $E2 NOP line, $E3 line read, $E4 ROM read
; KEYS8 = $4001           ; IN with A8 low
; KEYS9 = $4002           ; IN with A9 low
; LINE = $4100            ; the line of character codes
; MIRROR = $8000          ; A15 high: the RAM's mirror, where an M1 fetch of a code is a NOP

;         .org $0000
@000 F3        ; 0000          DI
; ; RAM, pass 1: each byte gets its address's low byte xor high byte.
@001 21 00 40  ; 0001          LD HL,$4000
@004 7D        ; 0004  fill:   LD A,L
@005 AC        ; 0005          XOR H
@006 77        ; 0006          LD (HL),A
@007 23        ; 0007          INC HL
@008 7C        ; 0008          LD A,H
@009 FE 44     ; 0009          CP $44
@00B 20 F7     ; 000B          JR NZ,fill
; ; Pass 2: check, and leave the complement.
@00D 21 00 40  ; 000D          LD HL,$4000
@010 7D        ; 0010  check1: LD A,L
@011 AC        ; 0011          XOR H
@012 BE        ; 0012          CP (HL)
@013 20 6E     ; 0013          JR NZ,ramfail
@015 2F        ; 0015          CPL
@016 77        ; 0016          LD (HL),A
@017 23        ; 0017          INC HL
@018 7C        ; 0018          LD A,H
@019 FE 44     ; 0019          CP $44
@01B 20 F3     ; 001B          JR NZ,check1
; ; Pass 3: check the complement.
@01D 21 00 40  ; 001D          LD HL,$4000
@020 7D        ; 0020  check2: LD A,L
@021 AC        ; 0021          XOR H
@022 2F        ; 0022          CPL
@023 BE        ; 0023          CP (HL)
@024 20 5D     ; 0024          JR NZ,ramfail
@026 23        ; 0026          INC HL
@027 7C        ; 0027          LD A,H
@028 FE 44     ; 0028          CP $44
@02A 20 F4     ; 002A          JR NZ,check2

; ; The line: codes $01-$10 (bit 6 clear) then RET ($C9, bit 6 set), run in the mirror. Executed
; ; as themselves, $01 would load BC and $09 add BC to HL.
@02C 31 00 44  ; 002C          LD SP,$4400
@02F 21 00 41  ; 002F          LD HL,LINE
@032 06 10     ; 0032          LD B,$10
@034 3E 01     ; 0034          LD A,$01
@036 77        ; 0036  copy:   LD (HL),A
@037 23        ; 0037          INC HL
@038 3C        ; 0038          INC A
@039 10 FB     ; 0039          DJNZ copy
@03B 36 C9     ; 003B          LD (HL),$C9
@03D 21 34 12  ; 003D          LD HL,$1234
@040 01 78 56  ; 0040          LD BC,$5678
@043 CD 00 C1  ; 0043          CALL LINE | MIRROR
@046 7C        ; 0046          LD A,H
@047 FE 12     ; 0047          CP $12
@049 20 3C     ; 0049          JR NZ,linefail
@04B 7D        ; 004B          LD A,L
@04C FE 34     ; 004C          CP $34
@04E 20 37     ; 004E          JR NZ,linefail
@050 78        ; 0050          LD A,B
@051 FE 56     ; 0051          CP $56
@053 20 32     ; 0053          JR NZ,linefail
@055 79        ; 0055          LD A,C
@056 FE 78     ; 0056          CP $78
@058 20 2D     ; 0058          JR NZ,linefail
; ; A data read of the mirror is not an M1: not forced.
@05A 3A 00 C1  ; 005A          LD A,(LINE | MIRROR)
@05D FE 01     ; 005D          CP $01
@05F 20 2A     ; 005F          JR NZ,readfail
; ; A write into the ROM's space: the ROM drives the memory side, the CPU its own.
@061 3E AA     ; 0061          LD A,$AA
@063 32 00 08  ; 0063          LD (rombyte),A
@066 3A 00 08  ; 0066          LD A,(rombyte)
@069 FE 3C     ; 0069          CP $3C
@06B 20 22     ; 006B          JR NZ,romfail
@06D 3E 55     ; 006D          LD A,$55
@06F 32 00 40  ; 006F          LD (STATUS),A

@072 01 FE FE  ; 0072  keys:   LD BC,$FEFE
@075 ED 78     ; 0075          IN A,(C)
@077 32 01 40  ; 0077          LD (KEYS8),A
@07A 06 FD     ; 007A          LD B,$FD
@07C ED 78     ; 007C          IN A,(C)
@07E 32 02 40  ; 007E          LD (KEYS9),A
@081 18 EF     ; 0081          JR keys

; ramfail:
@083 3E E1     ; 0083          LD A,$E1
@085 18 0A     ; 0085          JR fail
; linefail:
@087 3E E2     ; 0087          LD A,$E2
@089 18 06     ; 0089          JR fail
; readfail:
@08B 3E E3     ; 008B          LD A,$E3
@08D 18 02     ; 008D          JR fail
; romfail:
@08F 3E E4     ; 008F          LD A,$E4
@091 32 00 40  ; 0091  fail:   LD (STATUS),A
@094 18 FE     ; 0094          JR *

;         .org $0800
; rombyte:
@800 3C        ; 0800          .byte $3C

# 100 heartbeat (machines/100-heartbeat/docs/HEARTBEAT.md): a 6502 free-running on NOPs. Its data
# bus is held at $EA by resistors, so every byte it reads is a NOP and the address counts up one
# every two cycles at 1 MHz. U2 and U3 buffer A0-A15 to sixteen LEDs, D16 (A15) on the left, each
# lit while its line is high. SW1 resets the CPU, which then starts at $EAEA.

part X1  OSC freq=1MHz
part J1  POWER
part U1  6502
part U2  74LS244
part U3  74LS244
part SW1 BUTTON
part D1 LED
part D2 LED
part D3 LED
part D4 LED
part D5 LED
part D6 LED
part D7 LED
part D8 LED
part D9 LED
part D10 LED
part D11 LED
part D12 LED
part D13 LED
part D14 LED
part D15 LED
part D16 LED
part R1 R value=330
part R2 R value=330
part R3 R value=330
part R4 R value=330
part R5 R value=330
part R6 R value=330
part R7 R value=330
part R8 R value=330
part R9 R value=330
part R10 R value=330
part R11 R value=330
part R12 R value=330
part R13 R value=330
part R14 R value=330
part R15 R value=330
part R16 R value=330
part R17 R value=4k7
part R18 R value=4k7
part R19 R value=4k7
part R20 R value=4k7
part R21 R value=4k7
part R22 R value=4k7
part R23 R value=4k7
part R24 R value=4k7
part R25 R value=3k3
part R26 R value=3k3
part R27 R value=4k7

net PHI0     X1.OUT U1.PHI0
net VCC      U1.RDY U1.SO

# Data bus held at $EA (1110 1010): every byte the CPU reads is a NOP.
net DB0      U1.D0 R17.2
net DB1      U1.D1 R18.2
net DB2      U1.D2 R19.2
net DB3      U1.D3 R20.2
net DB4      U1.D4 R21.2
net DB5      U1.D5 R22.2
net DB6      U1.D6 R23.2
net DB7      U1.D7 R24.2
net VCC      R18.1 R20.1 R22.1 R23.1 R24.1
net GND      R17.1 R19.1 R21.1

# Interrupts off; reset by SW1.
net IRQ_N    U1.IRQ_N R25.2
net NMI_N    U1.NMI_N R26.2
net RES_N    U1.RES_N R27.2 SW1.1
net VCC      R25.1 R26.1 R27.1
net GND      SW1.2

# Address bus buffered to the LEDs: U2 takes A0-A7, U3 A8-A15 (1A1-1A4 the low four).
net GND      U2.1OE_N U2.2OE_N U3.1OE_N U3.2OE_N
net A0       U1.A0 U2.1A1
net LA0      U2.1Y1 D1.A
net LK0      D1.K R1.2
net A1       U1.A1 U2.1A2
net LA1      U2.1Y2 D2.A
net LK1      D2.K R2.2
net A2       U1.A2 U2.1A3
net LA2      U2.1Y3 D3.A
net LK2      D3.K R3.2
net A3       U1.A3 U2.1A4
net LA3      U2.1Y4 D4.A
net LK3      D4.K R4.2
net A4       U1.A4 U2.2A1
net LA4      U2.2Y1 D5.A
net LK4      D5.K R5.2
net A5       U1.A5 U2.2A2
net LA5      U2.2Y2 D6.A
net LK5      D6.K R6.2
net A6       U1.A6 U2.2A3
net LA6      U2.2Y3 D7.A
net LK6      D7.K R7.2
net A7       U1.A7 U2.2A4
net LA7      U2.2Y4 D8.A
net LK7      D8.K R8.2
net A8       U1.A8 U3.1A1
net LA8      U3.1Y1 D9.A
net LK8      D9.K R9.2
net A9       U1.A9 U3.1A2
net LA9      U3.1Y2 D10.A
net LK9      D10.K R10.2
net A10      U1.A10 U3.1A3
net LA10     U3.1Y3 D11.A
net LK10     D11.K R11.2
net A11      U1.A11 U3.1A4
net LA11     U3.1Y4 D12.A
net LK11     D12.K R12.2
net A12      U1.A12 U3.2A1
net LA12     U3.2Y1 D13.A
net LK12     D13.K R13.2
net A13      U1.A13 U3.2A2
net LA13     U3.2Y2 D14.A
net LK13     D14.K R14.2
net A14      U1.A14 U3.2A3
net LA14     U3.2Y3 D15.A
net LK14     D15.K R15.2
net A15      U1.A15 U3.2A4
net LA15     U3.2Y4 D16.A
net LK15     D16.K R16.2
net GND      R1.1 R2.1 R3.1 R4.1 R5.1 R6.1 R7.1 R8.1 R9.1 R10.1 R11.1 R12.1 R13.1 R14.1 R15.1 R16.1

; Generated by bw asm from bw1_002.asm: do not edit. Edit the .asm and run bw asm again.
; ; BW-1 monitor (docs/p5k-bw1-monitor/BW1_MONITOR.md): the 6530-002's ROM at $1C00-$1FFF, our
; ; own code behind the KIM-1's entry points, so programs from the KIM books run.
; ;
; ; Memory (U4 decodes A10-A12, A13-A15 free): $0000-$03FF RAM; $1700 the 003's ports, $1740 the
; ; 002's (SAD, PADD, SBD, PBDD); $1780 and $17C0 the RIOT RAMs; $1800 the 003's ROM (the
; ; self-test); $1C00 this one; the 6502's vectors at $FFFA read $1FFA.
; ; Keypad and digits (KIM Fig. 3.5): PB1-PB4 drive U24 (74145): outputs 0-2 the keypad's rows
; ; (SBD $00, $02, $04), read on PA6-PA0; output 3 the strap to PA0 (SBD $06); outputs 4-9 digits
; ; 1-6 (SBD $08-$12), a segment lit while its PA0 (a) to PA6 (g) is high.
; ; Keys (GETKEY): 0-F $00-$0F, AD $10, DA $11, + $12, GO $13, PC $14, none $15.
; ;
; ; Entry points at the KIM's addresses: SAVE $1C00 (SAVE1 $1C05, SAVE2 $1C0F), NMIT $1C1C,
; ; IRQT $1C1F, RST $1C22, START $1C4F, AK $1EFE, SCAND $1F19, SCANDS $1F1F, KEYIN $1F40,
; ; CONVD $1F48, INCPT $1F63, GETKEY $1F6A, TABLE $1FE7.
; ; Zero page (the KIM's): saved registers $EF-$F5, INH $F9, POINTL $FA, POINTH $FB, TEMP $FC,
; ; TMPX $FD, MODE $FF (1: address). Stack in page 1. RIOT RAM: NMIV $17FA, IRQV $17FE.
; ; No adc or sbc: the monitor runs with a stopped program's D flag.

;         .rom $1C00, $400

; PCL     = $EF
; PCH     = $F0
; PREG    = $F1
; SPUSER  = $F2
; ACC     = $F3
; YREG    = $F4
; XREG    = $F5
; INL     = $F8
; INH     = $F9
; POINTL  = $FA
; POINTH  = $FB
; TEMP    = $FC           ; Y in CONVD; the key in the main loop
; TMPX    = $FD           ; the rows ANDed in AK
; MODE    = $FF           ; 1 address, 0 data
; NMIV    = $17FA
; IRQV    = $17FE
; SAD     = $1740
; PADD    = $1741
; SBD     = $1742
; PBDD    = $1743
; SELFTEST = $1800        ; bw1_003.asm
; DIGIT1  = $08           ; SBD of digit 1; +2 a digit (U24 outputs 4-9)
; STRAP   = $06           ; SBD of U24 output 3, the strap's line
; DELAY   = 100           ; dey/bne loops a digit: about 0.5 ms

; ; --- NMI, BRK: save the registers, show the PC ---------------------------------------------

;         .org $1C00
@000 85 F3     ; 1C00  SAVE:   sta ACC
@002 68        ; 1C02          pla
@003 85 F1     ; 1C03          sta PREG
@005 68        ; 1C05  SAVE1:  pla
@006 85 EF     ; 1C06          sta PCL
@008 85 FA     ; 1C08          sta POINTL
@00A 68        ; 1C0A          pla
@00B 85 F0     ; 1C0B          sta PCH
@00D 85 FB     ; 1C0D          sta POINTH
@00F 84 F4     ; 1C0F  SAVE2:  sty YREG
@011 86 F5     ; 1C11          stx XREG
@013 BA        ; 1C13          tsx
@014 86 F2     ; 1C14          stx SPUSER
@016 20 FB 1C  ; 1C16          jsr INITS
@019 4C 4F 1C  ; 1C19          jmp START

;         .org $1C1C
@01C 6C FA 17  ; 1C1C  NMIT:   jmp (NMIV)
@01F 6C FE 17  ; 1C1F  IRQT:   jmp (IRQV)

; ; --- Reset: the strap is read before any RAM is touched -----------------------------------

@022 A9 00     ; 1C22  RST:    lda #0
@024 8D 41 17  ; 1C24          sta PADD        ; PA inputs (RES did it too)
@027 A9 1E     ; 1C27          lda #$1E
@029 8D 43 17  ; 1C29          sta PBDD        ; PB1-PB4 out: U24's inputs
@02C A9 06     ; 1C2C          lda #STRAP
@02E 8D 42 17  ; 1C2E          sta SBD         ; U24 output 3 low: a closed strap pulls PA0 low
@031 A9 01     ; 1C31          lda #$01
@033 2C 40 17  ; 1C33          bit SAD         ; at least 5 us after the write: the port's 1 us, then U24
@036 D0 03     ; 1C36          bne @mon
@038 4C 00 18  ; 1C38          jmp SELFTEST    ; strap closed: no RAM touched so far
@03B A2 FF     ; 1C3B  @mon:   ldx #$FF
@03D 9A        ; 1C3D          txs
@03E 4C D3 1C  ; 1C3E          jmp COLD

; ; --- The loop: show the address and its byte, read a key ----------------------------------

;         .org $1C4F
@04F 20 FF 1C  ; 1C4F  START:  jsr INIT1
@052 20 19 1F  ; 1C52  @up:    jsr SCAND       ; A = 0 when no key is held
@055 D0 FB     ; 1C55          bne @up         ; every key released first
@057 20 19 1F  ; 1C57  @down:  jsr SCAND
@05A F0 FB     ; 1C5A          beq @down
@05C 20 19 1F  ; 1C5C          jsr SCAND       ; still held a scan later
@05F F0 F6     ; 1C5F          beq @down
@061 20 6A 1F  ; 1C61          jsr GETKEY
@064 C9 15     ; 1C64          cmp #$15
@066 B0 E7     ; 1C66          bcs START       ; released meanwhile
@068 C9 10     ; 1C68          cmp #$10
@06A 90 2D     ; 1C6A          bcc HEX
@06C D0 07     ; 1C6C          bne @da
@06E A9 01     ; 1C6E          lda #1          ; AD
@070 85 FF     ; 1C70          sta MODE
@072 4C 4F 1C  ; 1C72          jmp START
@075 C9 11     ; 1C75  @da:    cmp #$11
@077 D0 07     ; 1C77          bne @plus
@079 A9 00     ; 1C79          lda #0          ; DA
@07B 85 FF     ; 1C7B          sta MODE
@07D 4C 4F 1C  ; 1C7D          jmp START
@080 C9 12     ; 1C80  @plus:  cmp #$12
@082 D0 06     ; 1C82          bne @go
@084 20 63 1F  ; 1C84          jsr INCPT       ; +
@087 4C 4F 1C  ; 1C87          jmp START
@08A C9 13     ; 1C8A  @go:    cmp #$13
@08C F0 32     ; 1C8C          beq GOEXEC
@08E A5 EF     ; 1C8E          lda PCL         ; PC
@090 85 FA     ; 1C90          sta POINTL
@092 A5 F0     ; 1C92          lda PCH
@094 85 FB     ; 1C94          sta POINTH
@096 4C 4F 1C  ; 1C96          jmp START

; ; A hex key: shifted into the address (AD) or into the byte there (DA).
@099 85 FC     ; 1C99  HEX:    sta TEMP
@09B A5 FF     ; 1C9B          lda MODE
@09D F0 12     ; 1C9D          beq @data
@09F A2 04     ; 1C9F          ldx #4
@0A1 06 FA     ; 1CA1  @shift: asl POINTL
@0A3 26 FB     ; 1CA3          rol POINTH
@0A5 CA        ; 1CA5          dex
@0A6 D0 F9     ; 1CA6          bne @shift
@0A8 A5 FA     ; 1CA8          lda POINTL
@0AA 05 FC     ; 1CAA          ora TEMP
@0AC 85 FA     ; 1CAC          sta POINTL
@0AE 4C 4F 1C  ; 1CAE          jmp START
@0B1 A0 00     ; 1CB1  @data:  ldy #0
@0B3 B1 FA     ; 1CB3          lda (POINTL),y
@0B5 0A        ; 1CB5          asl
@0B6 0A        ; 1CB6          asl
@0B7 0A        ; 1CB7          asl
@0B8 0A        ; 1CB8          asl
@0B9 05 FC     ; 1CB9          ora TEMP
@0BB 91 FA     ; 1CBB          sta (POINTL),y
@0BD 4C 4F 1C  ; 1CBD          jmp START

; ; GO: the saved registers and stack pointer, then the address.
@0C0 A6 F2     ; 1CC0  GOEXEC: ldx SPUSER
@0C2 9A        ; 1CC2          txs
@0C3 A5 FB     ; 1CC3          lda POINTH
@0C5 48        ; 1CC5          pha
@0C6 A5 FA     ; 1CC6          lda POINTL
@0C8 48        ; 1CC8          pha
@0C9 A5 F1     ; 1CC9          lda PREG
@0CB 48        ; 1CCB          pha
@0CC A6 F5     ; 1CCC          ldx XREG
@0CE A4 F4     ; 1CCE          ldy YREG
@0D0 A5 F3     ; 1CD0          lda ACC
@0D2 40        ; 1CD2          rti

; ; After reset with the strap open: the vectors, the registers, $0200.
@0D3 86 F2     ; 1CD3  COLD:   stx SPUSER      ; $FF
@0D5 A9 00     ; 1CD5          lda #0
@0D7 85 F3     ; 1CD7          sta ACC
@0D9 85 F5     ; 1CD9          sta XREG
@0DB 85 F4     ; 1CDB          sta YREG
@0DD 85 F1     ; 1CDD          sta PREG
@0DF 85 FA     ; 1CDF          sta POINTL
@0E1 A9 00     ; 1CE1          lda #<SAVE
@0E3 8D FA 17  ; 1CE3          sta NMIV
@0E6 8D FE 17  ; 1CE6          sta IRQV
@0E9 A9 1C     ; 1CE9          lda #>SAVE
@0EB 8D FB 17  ; 1CEB          sta NMIV+1
@0EE 8D FF 17  ; 1CEE          sta IRQV+1
@0F1 A9 02     ; 1CF1          lda #$02
@0F3 85 FB     ; 1CF3          sta POINTH
@0F5 20 FB 1C  ; 1CF5          jsr INITS       ; the first use of the stack
@0F8 4C 4F 1C  ; 1CF8          jmp START

@0FB A9 01     ; 1CFB  INITS:  lda #1
@0FD 85 FF     ; 1CFD          sta MODE        ; address mode
@0FF A9 1E     ; 1CFF  INIT1:  lda #$1E
@101 8D 43 17  ; 1D01          sta PBDD
@104 A9 00     ; 1D04          lda #0
@106 8D 41 17  ; 1D06          sta PADD
@109 60        ; 1D09          rts

; ; --- Display and keys ------------------------------------------------------------------------

; ; SCANDS: POINTH POINTL INH on the six digits, then AK.
@10A A9 7F     ; 1D0A  SCANX:  lda #$7F
@10C 8D 41 17  ; 1D0C          sta PADD        ; segments out; SBD is on a row since the last AK: no digit lit
@10F A2 08     ; 1D0F          ldx #DIGIT1
@111 A0 03     ; 1D11          ldy #3
@113 B9 F8 00  ; 1D13  @byte:  lda INL,y       ; y = 3 POINTH, 2 POINTL, 1 INH
@116 4A        ; 1D16          lsr
@117 4A        ; 1D17          lsr
@118 4A        ; 1D18          lsr
@119 4A        ; 1D19          lsr
@11A 20 29 1D  ; 1D1A          jsr CONVX
@11D B9 F8 00  ; 1D1D          lda INL,y
@120 20 29 1D  ; 1D20          jsr CONVX
@123 88        ; 1D23          dey
@124 D0 ED     ; 1D24          bne @byte
@126 4C 46 1D  ; 1D26          jmp AKX

; ; CONVD: hex digit A (low 4 bits) on the digit X selects for about 0.5 ms, then X + 2; Y kept.
@129 84 FC     ; 1D29  CONVX:  sty TEMP
@12B 29 0F     ; 1D2B          and #$0F
@12D A8        ; 1D2D          tay
@12E B9 E7 1F  ; 1D2E          lda TABLE,y
@131 A0 00     ; 1D31          ldy #0
@133 8C 40 17  ; 1D33          sty SAD         ; blank before the digit changes
@136 8E 42 17  ; 1D36          stx SBD
@139 8D 40 17  ; 1D39          sta SAD
@13C A0 64     ; 1D3C          ldy #DELAY
@13E 88        ; 1D3E  @wait:  dey
@13F D0 FD     ; 1D3F          bne @wait
@141 E8        ; 1D41          inx
@142 E8        ; 1D42          inx
@143 A4 FC     ; 1D43          ldy TEMP
@145 60        ; 1D45          rts

; ; AK: A = 0 if no key is held. Row 0 is selected first, so the last digit goes dark before
; ; port A floats high.
@146 A9 00     ; 1D46  AKX:    lda #0
@148 8D 42 17  ; 1D48          sta SBD
@14B 8D 41 17  ; 1D4B          sta PADD        ; PA inputs
@14E AD 40 17  ; 1D4E          lda SAD
@151 09 80     ; 1D51          ora #$80
@153 85 FD     ; 1D53          sta TMPX
@155 A9 02     ; 1D55          lda #$02
@157 8D 42 17  ; 1D57          sta SBD
@15A AD 40 17  ; 1D5A          lda SAD
@15D 09 80     ; 1D5D          ora #$80
@15F 25 FD     ; 1D5F          and TMPX
@161 85 FD     ; 1D61          sta TMPX
@163 A9 04     ; 1D63          lda #$04
@165 8D 42 17  ; 1D65          sta SBD
@168 AD 40 17  ; 1D68          lda SAD
@16B 09 80     ; 1D6B          ora #$80
@16D 25 FD     ; 1D6D          and TMPX
@16F 49 FF     ; 1D6F          eor #$FF        ; a 1 for each column pulled low
@171 60        ; 1D71          rts

; ; GETKEY: A = the key held, $15 if none; with two, the lower code.
@172 A9 00     ; 1D72  GETKX:  lda #0
@174 8D 41 17  ; 1D74          sta PADD
@177 A2 00     ; 1D77          ldx #0          ; SBD of the row
@179 A0 FE     ; 1D79          ldy #$FE        ; the row's first code - 2
@17B 8E 42 17  ; 1D7B  @row:   stx SBD
@17E AD 40 17  ; 1D7E          lda SAD
@181 09 80     ; 1D81          ora #$80
@183 49 FF     ; 1D83          eor #$FF
@185 D0 10     ; 1D85          bne @found
@187 C8        ; 1D87          iny
@188 C8        ; 1D88          iny
@189 C8        ; 1D89          iny
@18A C8        ; 1D8A          iny
@18B C8        ; 1D8B          iny
@18C C8        ; 1D8C          iny
@18D C8        ; 1D8D          iny
@18E E8        ; 1D8E          inx
@18F E8        ; 1D8F          inx
@190 E0 06     ; 1D90          cpx #6
@192 D0 E7     ; 1D92          bne @row
@194 A9 15     ; 1D94          lda #$15
@196 60        ; 1D96          rts
@197 C8        ; 1D97  @found: iny             ; PA6 is the first 1 out of bit 7: the row's first code
@198 0A        ; 1D98          asl
@199 90 FC     ; 1D99          bcc @found
@19B 98        ; 1D9B          tya
@19C 60        ; 1D9C          rts

; ; --- The KIM's entry points ------------------------------------------------------------------

;         .org $1EFE
@2FE 4C 46 1D  ; 1EFE  AK:     jmp AKX

;         .org $1F19
@319 A0 00     ; 1F19  SCAND:  ldy #0
@31B B1 FA     ; 1F1B          lda (POINTL),y
@31D 85 F9     ; 1F1D          sta INH
@31F 4C 0A 1D  ; 1F1F  SCANDS: jmp SCANX

;         .org $1F40
@340 A9 00     ; 1F40  KEYIN:  lda #0
@342 8D 41 17  ; 1F42          sta PADD
@345 4C 46 1D  ; 1F45          jmp AKX

;         .org $1F48
@348 4C 29 1D  ; 1F48  CONVD:  jmp CONVX

;         .org $1F63
@363 E6 FA     ; 1F63  INCPT:  inc POINTL
@365 D0 02     ; 1F65          bne @done
@367 E6 FB     ; 1F67          inc POINTH
@369 60        ; 1F69  @done:  rts

@36A 4C 72 1D  ; 1F6A  GETKEY: jmp GETKX       ; $1F6A

;         .org $1FE7
@3E7 BF 86 DB CF E6 ED FD 87  ; 1FE7  TABLE:  .byte $BF, $86, $DB, $CF, $E6, $ED, $FD, $87     ; 0-7, PA0 = a ... PA6 = g
@3EF FF EF F7 FC B9 DE F9 F1  ; 1FEF          .byte $FF, $EF, $F7, $FC, $B9, $DE, $F9, $F1     ; 8-F
@3F7 4C        ; 1FF7          .checksum

;         .org $1FFA
@3FA 1C 1C 22 1C 1F 1C  ; 1FFA          .word NMIT, RST, IRQT   ; NMI, RESET, IRQ/BRK

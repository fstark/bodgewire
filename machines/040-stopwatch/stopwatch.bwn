# 040 stopwatch (machines/040-stopwatch/docs/STOPWATCH.md): 1 MHz clock, gated by the run
# flip-flop U11 (set by Start SW1, cleared by Stop SW2), divided by 10 000 in four 74LS90 to
# 100 Hz, then counted by three more 74LS90 into hundredths, tenths and seconds, each shown on
# a common-anode 7-segment digit through a 74LS47. Reset SW3 clears every counter: 0.00 to 9.99.

part X1 OSC freq=1MHz
part J1 POWER
part SW1 BUTTON legend=START
part SW2 BUTTON legend=STOP
part SW3 BUTTON legend=RESET
part R1 R value=4k7
part R2 R value=4k7
part R3 R value=4k7
part R4 R value=330
part R5 R value=330
part R6 R value=330
part U1 74LS90
part U2 74LS90
part U3 74LS90
part U4 74LS90
part U5 74LS90
part U6 74LS90
part U7 74LS90
part U8 74LS47
part U9 74LS47
part U10 74LS47
part U11 74LS74
part U12 74LS00
part DS1 DIGIT
part DS2 DIGIT
part DS3 DIGIT

# Buttons, run flip-flop, clock gate, reset
net CLK      X1.OUT U12.1A
net START_N  R1.2 SW1.1 U11.1PRE_N
net STOP_N   R2.2 SW2.1 U11.1CLR_N
net RST_N    R3.2 SW3.1 U12.2A U12.2B
net RUN      U11.1Q U12.1B
net GCLK     U12.1Y U1.CKA
net RESET    U12.2Y U1.R01 U1.R02 U2.R01 U2.R02 U3.R01 U3.R02 U4.R01 U4.R02
net RESET    U5.R01 U5.R02 U6.R01 U6.R02 U7.R01 U7.R02

net VCC      R1.1 R2.1 R3.1 R4.1 R5.1 R6.1 U11.2PRE_N U11.2CLR_N
net VCC      U8.LT_N U8.RBI_N U8.BI_N U9.LT_N U9.RBI_N U9.BI_N U10.LT_N U10.RBI_N U10.BI_N
net GND      SW1.2 SW2.2 SW3.2 DS1.DP U11.1D U11.1CLK U11.2D U11.2CLK
net GND      U12.3A U12.3B U12.4A U12.4B
net GND      U1.R91 U1.R92 U2.R91 U2.R92 U3.R91 U3.R92 U4.R91 U4.R92
net GND      U5.R91 U5.R92 U6.R91 U6.R92 U7.R91 U7.R92

# Prescaler: 1 MHz to 100 Hz, each 74LS90 a decade (QA linked to CKB)
net F500K    U1.QA U1.CKB
net F100K    U1.QD U2.CKA
net F50K     U2.QA U2.CKB
net F10K     U2.QD U3.CKA
net F5K      U3.QA U3.CKB
net F1K      U3.QD U4.CKA
net F500     U4.QA U4.CKB
net F100     U4.QD U7.CKA

# Display counters: hundredths U7, tenths U6, seconds U5; QD carries to the next
net H0       U7.QA U7.CKB U10.A
net H1       U7.QB U10.B
net H2       U7.QC U10.C
net H3       U7.QD U10.D U6.CKA
net T0       U6.QA U6.CKB U9.A
net T1       U6.QB U9.B
net T2       U6.QC U9.C
net T3       U6.QD U9.D U5.CKA
net S0       U5.QA U5.CKB U8.A
net S1       U5.QB U8.B
net S2       U5.QC U8.C
net S3       U5.QD U8.D

# Digits: common anode through one resistor, segments straight on the decoder outputs
net DS1_CA   R4.2 DS1.CA1 DS1.CA2
net DS1_A    U8.SA_N DS1.A
net DS1_B    U8.SB_N DS1.B
net DS1_C    U8.SC_N DS1.C
net DS1_D    U8.SD_N DS1.D
net DS1_E    U8.SE_N DS1.E
net DS1_F    U8.SF_N DS1.F
net DS1_G    U8.SG_N DS1.G
net DS2_CA   R5.2 DS2.CA1 DS2.CA2
net DS2_A    U9.SA_N DS2.A
net DS2_B    U9.SB_N DS2.B
net DS2_C    U9.SC_N DS2.C
net DS2_D    U9.SD_N DS2.D
net DS2_E    U9.SE_N DS2.E
net DS2_F    U9.SF_N DS2.F
net DS2_G    U9.SG_N DS2.G
net DS3_CA   R6.2 DS3.CA1 DS3.CA2
net DS3_A    U10.SA_N DS3.A
net DS3_B    U10.SB_N DS3.B
net DS3_C    U10.SC_N DS3.C
net DS3_D    U10.SD_N DS3.D
net DS3_E    U10.SE_N DS3.E
net DS3_F    U10.SF_N DS3.F
net DS3_G    U10.SG_N DS3.G

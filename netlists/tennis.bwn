# Machine 070, paddle tennis (docs/machines/070-tennis/TENNIS.md): the 060 bouncing ball's
# beam counters, sync, net and ball (U1-U26), grown in stages (TENNIS_DESIGN.md, Stages).
# Two paddles from two controllers (J3, J4) triggered by VSYNC_N; the ball turns at a paddle or
# a goal, and leaves a paddle at an angle set by the quarter it hits; a miss hides the ball for a
# serve and scores for the other player; the scores are drawn at the top from one decoder; at 11
# the game is over until Start (SW1). No side walls are drawn: the 060 side walls are the goals.

part X1  OSC freq=2MHz
part U1  74LS161    # H0-H3
part U2  74LS161    # H4-H6
part U3  74LS161    # V0-V3
part U4  74LS161    # V4-V7
part U5  74LS161    # V8
part U6  74LS20     # LINE_END_N, HSYNC_N
part U7  74LS30     # FRAME_END_N
part U8  74LS20     # VSYNC_N, BOTTOM_N
part U9  74LS04     # H4_N, LINE_END, VBALL, MR, MIX_N, HBLANK
part U10 74LS86     # composite sync
part U11 74LS74     # output registers
part U12 74LS27     # wall and net decodes
part U13 74LS02     # wall decodes, ball height clock
part U14 74LS00     # TOP_N, LEFT_N, HBLANK_N
part U15 74LS20     # RIGHT_N, NET_N
part U16 74LS30     # video mixer
part U17 74LS27     # MOVE, VIDEO_D
part U18 74LS161    # ball horizontal, low
part U19 74LS161    # ball horizontal, high
part U20 74LS161    # ball vertical, low
part U21 74LS161    # ball vertical, high
part U22 74LS107    # ball vertical, bit 8
part U23 74LS93     # ball height
part U24 74LS00     # ball loads, BALL_N, MR_N
part U25 74LS02     # bounce detectors
part U26 74LS107    # directions
part J1  POWER
part J2  VIDEO
part J3  PADDLE min=1.248ms max=14.56ms reversed=yes  # left controller
part J4  PADDLE min=1.248ms max=14.56ms reversed=yes  # right controller
part U27 74LS74     # LWAIT, RWAIT: pulses moved to line starts
part U28 74LS93     # left paddle lines LP0-LP3
part U29 74LS93     # right paddle lines RP0-RP3
part U30 74LS107    # LDONE, RDONE
part U31 74LS157    # this half's paddle: SP2, SP3, PADV, TENS
part U32 74LS02     # LPAD_CK, RPAD_CK, LPADV, RPADV
part U33 74LS20     # COL_L_N, COL_R_N
part U34 74LS20     # PAD_N, REGION_N
part U35 74LS27     # GO_RIGHT, GO_LEFT, PAD_HIT
part U36 74LS08     # SIDES_N, TURN_N, HIT_LOW, SET_SHALLOW
part U37 74LS02     # HIT_HIGH, SET_STEEP, VLOAD_C, MID_A
part U38 74LS32     # GO_DOWN, GO_UP, BALLV_N
part U39 74LS107    # SHALLOW, GAME_OVER
part U40 74LS107    # TURN_ODD, FAST
part U41 74LS04     # H6_N, PAD_HIT_N, MOVE_N, SERVING, START, REGION
part U42 74LS00     # PCOL, MID_N, SCORE_N, H3_N
part U43 74LS27     # MISS_LEFT, MISS_RIGHT, HMOVE
part U44 74LS107    # LOST_LEFT, LOST_RIGHT
part U45 74LS107    # FRAME1
part U46 74LS93     # serve timer, SERVE_END
part U47 74LS02     # SKIP, SERVING_N, H34_LOW
part U48 74LS90     # left score units SL0-SL3
part U49 74LS90     # right score units SR0-SR3
part U50 74LS107    # TENS_L, TENS_R
part U52 74LS157    # this half's units SC0-SC3
part U53 74LS48     # SEG_A-SEG_G
part U54 74LS157    # this half of the cell: FE, BC, GD, A_TOP
part U55 74LS20     # T2_N, T4_N
part U56 74LS20     # T1_N, T5_N
part U57 74LS20     # T3_N
part U58 74LS30     # GLYPH
part SW1 BUTTON     # Start
part R1  R value=1k # START_N pull-up

net CLK         X1.OUT U1.CLK U2.CLK U3.CLK U4.CLK U5.CLK U11.1CLK U11.2CLK
net CLK         U18.CLK U19.CLK U20.CLK U21.CLK U26.1CLK U26.2CLK

# Horizontal counter 0..127, free-running.
net VCC         U1.CLR_N U1.ENP U1.ENT U1.LOAD_N U2.CLR_N U2.ENP U2.LOAD_N
net GND         U1.A U1.B U1.C U1.D U2.A U2.B U2.C U2.D
net H0          U1.QA U18.ENP U19.ENP U24.1B
net H1          U1.QB U12.3A
net H2          U1.QC U12.2A U12.3B U15.1D
net H3          U1.QD U6.2D U12.2B U12.3C U15.1C
net HC          U1.RCO U2.ENT U6.1A
net H4          U2.QA U6.1B U9.1A U12.2C U15.1B U15.2C
net H5          U2.QB U6.1C U6.2B U13.1A U14.3B U15.2B
net H6          U2.QC U6.1D U6.2A U13.1B U14.3A U15.1A
net H4_N        U9.1Y U6.2C
net LINE_END_N  U6.1Y U9.2A
net LINE_END    U9.2Y U3.ENP U3.ENT U4.ENP U5.ENP U7.G U20.ENP U21.ENP U13.3A
net HSYNC_N     U6.2Y U10.1A

# Vertical counter 0..311: counts at each line end, loaded with 0 at the frame end.
net VCC         U3.CLR_N U4.CLR_N U5.CLR_N U7.H
net GND         U3.A U3.B U3.C U3.D U4.A U4.B U4.C U4.D U5.A U5.B U5.C U5.D
net V0          U3.QA U7.F U17.1C
net V1          U3.QB U7.E U17.1B
net V2          U3.QC U7.D U8.1D U15.2D
net VC1         U3.RCO U4.ENT
net V4          U4.QA U7.C U8.1C U8.2D U12.1A
net V5          U4.QB U7.B U8.1B U8.2C U12.1B
net V6          U4.QC U8.2B U12.1C
net V7          U4.QD U8.2A U13.2A
net VC2         U4.RCO U5.ENT
net V8          U5.QA U7.A U8.1A U13.2B U17.2C
net FRAME_END_N U7.Y U3.LOAD_N U4.LOAD_N U5.LOAD_N
net VSYNC_N     U8.1Y U10.1B U17.1A

# Composite sync: HSYNC XOR VSYNC, then inverted.
net SYNC        U10.1Y U10.2A
net VCC         U10.2B
net SYNC_N_D    U10.2Y U11.1D

# Playfield: walls and net, active low.
net TOP_A       U12.1Y U14.1A
net TOP_B       U13.2Y U14.1B
net TOP_N       U14.1Y U16.B U25.3B
net BOTTOM_N    U8.2Y U16.C U25.4B
net LEFT_A      U12.2Y U14.2A
net H56_LOW     U13.1Y U14.2B
net LEFT_N      U14.2Y U36.1A
net RIGHT_N     U15.1Y U36.1B
net NET_A       U12.3Y U15.2A
net NET_N       U15.2Y U16.E

# Ball horizontal: steps every other dot, reloaded at 255 with 192 (191 or 193 on the HMOVE line).
net VCC         U18.CLR_N U18.ENT U19.CLR_N U19.D
net MOVE        U17.1Y U41.3A
net HMOVE       U43.3Y U18.A U24.4A
net MR          U9.4Y U18.B U18.C U18.D U19.A U19.B
net MR_N        U24.4Y U9.4A U19.C
net BHC         U18.RCO U19.ENT
net HBALL       U19.RCO U24.1A U24.3A
net HLOAD_N     U24.1Y U18.LOAD_N U19.LOAD_N

# Ball vertical: 9 bits, steps each line, reloaded on the line of 511 with 195 (down) or 203 (up).
# LINE_END on ENP, not ENT: RCO follows ENT combinationally and would glitch (VRCO clocks U22).
net VCC         U20.CLR_N U20.ENT U20.A U21.CLR_N U21.C U21.D
net GND         U21.A U21.B
net BVC         U20.RCO U21.ENT
net VRCO        U21.RCO U22.1CLK U24.2A U23.R01
net VCC         U22.1J U22.1K U22.1CLR_N
net BV8         U22.1Q U24.2B U23.R02
net VLOAD_N     U24.2Y U20.LOAD_N U21.LOAD_N

# Frame bit: FRAME0 toggles at each frame start (V8 falls).
net VCC         U22.2J U22.2K U22.2CLR_N
net V8          U22.2CLK
net FRAME0      U22.2Q
net FRAME0_N    U22.2Q_N

# Ball height: cleared on the line of 511, counts 8 lines, then QA stops it.
net BALL_CK     U13.3Y U23.CKB
net BALL_QD     U23.QD U23.CKA
net BALL_OFF    U23.QA U13.3B U9.3A
net VBALL       U9.3Y U24.3B
net BALL_N      U24.3Y U25.3A U25.4A

# Bounces and directions.
net HIT_TOP     U25.3Y U38.1A
net HIT_BOTTOM  U25.4Y U38.2A
net VCC         U26.1CLR_N U26.2CLR_N
net HDIR        U26.1Q U24.4B
net VDIR_N      U26.2Q_N U20.D

# Video: the mixer (Pong's summing resistors), blanking, output registers.
net VCC         U16.G U16.H
net MIX         U16.Y U9.5A
net MIX_N       U9.5Y U17.2A
net HBLANK_N    U14.3Y U9.6A
net HBLANK      U9.6Y U17.2B
net VIDEO_D     U17.2Y U11.2D
net SYNC_N      U11.1Q J2.SYNC_N
net VIDEO       U11.2Q J2.VIDEO
net VCC         U11.1PRE_N U11.1CLR_N U11.2PRE_N U11.2CLR_N

# Unused gate inputs.

# Paddles. Each controller is triggered at line 308; LWAIT is its pulse taken at line starts.
# The paddle counter is cleared while LWAIT is high, then counts lines (at dot 127) until LP3
# falls after line 15 and sets LDONE. A paddle is lit on its lines at its column.
net VSYNC_N     J3.TRIG_N J4.TRIG_N
net LPULSE      J3.OUT U27.1D
net RPULSE      J4.OUT U27.2D
net LINE_END_N  U27.1CLK U27.2CLK
net VCC         U27.1PRE_N U27.1CLR_N U27.2PRE_N U27.2CLR_N
net LWAIT       U27.1Q U28.R01 U28.R02 U32.3A
net LWAIT_N     U27.1Q_N U30.1CLR_N
net RWAIT       U27.2Q U29.R01 U29.R02 U32.4A
net RWAIT_N     U27.2Q_N U30.2CLR_N
net LINE_END    U32.1A U32.2A
net LPAD_CK     U32.1Y U28.CKA
net RPAD_CK     U32.2Y U29.CKA
net LP0         U28.QA U28.CKB
net LP1         U28.QB
net LP2         U28.QC U31.1A
net LP3         U28.QD U30.1CLK U31.2A
net RP0         U29.QA U29.CKB
net RP1         U29.QB
net RP2         U29.QC U31.1B
net RP3         U29.QD U30.2CLK U31.2B
net VCC         U30.1J U30.2J
net GND         U30.1K U30.2K
net LDONE       U30.1Q U32.1B U32.3B
net RDONE       U30.2Q U32.2B U32.4B
net LPADV       U32.3Y U31.3A
net RPADV       U32.4Y U31.3B

# This half of the line's paddle (H6 low: left, high: right).
net H6          U31.S
net GND         U31.G_N
net SP2         U31.1Y
net SP3         U31.2Y
net PADV        U31.3Y U34.1A

# Paddle columns: dots 6-7 (left), 88-89 (right).
net H34_LOW     U47.4Y U33.1C
net H12_LOW     U13.4Y U33.2D
net H1          U13.4A U33.1A
net H2          U13.4B U33.1B
net H3          U33.2A U47.4B
net H4          U33.2B U47.4A
net H6          U33.2C
net H56_LOW     U33.1D
net COL_L_N     U33.1Y U42.1A
net COL_R_N     U33.2Y U42.1B
net PCOL        U42.1Y U34.1B
net VCC         U34.1C U34.1D
net PAD_N       U34.1Y U16.D

# Later stages: tens (stage 5), PLAY (stage 6, tied high above in U34.1D), unused gates.

# Hits: the ball turns right on the left goal or a paddle in the left half (H6 low), left on
# the right goal or a paddle in the right half.
net H6_N        U41.1Y U35.2C
net H6          U41.1A U35.1C
net SIDES_N     U36.1Y U36.2A
net PAD_N       U36.2B U35.3B
net TURN_N      U36.2Y U35.1B U35.2B
net BALL_N      U35.1A U35.2A U35.3A
net GO_RIGHT    U35.1Y U26.1J
net GO_LEFT     U35.2Y U26.1K

# Angles: the ball's line 4 (U23 QD high, QB and QC low) on a paddle sets VDIR from the paddle
# line's bit 3 and SHALLOW from bits 2 xor 3.
net BALL_QB     U23.QB U37.4A
net BALL_QC     U23.QC U37.4B
net MID_A       U37.4Y U42.2B
net BALL_QD     U42.2A
net MID_N       U42.2Y U35.3C
net PAD_HIT     U35.3Y U41.2A U36.3A U36.4A
net PAD_HIT_N   U41.2Y U37.1A U37.2A
net SP3         U36.3B U37.1B U10.3B
net SP2         U10.3A
net SP_MID      U10.3Y U36.4B U37.2B
net HIT_LOW     U36.3Y U38.1B
net HIT_HIGH    U37.1Y U38.2B
net GO_DOWN     U38.1Y U26.2J
net GO_UP       U38.2Y U26.2K
net SET_SHALLOW U36.4Y U39.1J
net SET_STEEP   U37.2Y U39.1K
net CLK         U39.1CLK
net VCC         U39.1CLR_N
net SHALLOW     U39.1Q
net STEEP       U39.1Q_N U20.B U37.3B
net VDIR_N      U37.3A
net VLOAD_C     U37.3Y U20.C

# Speed: TURN_ODD toggles each time the ball turns left; FAST is set at its second fall. Slow,
# the ball steps sideways only on frames with FRAME0 low (SKIP).
net HDIR        U40.1CLK
net VCC         U40.1J U40.1K U40.2J
net GND         U40.2K
net TURN_ODD    U40.1Q U40.2CLK
net FAST        U40.2Q U47.2A
net FRAME0_N    U47.2B
net SKIP        U47.2Y U43.3C
net MOVE_N      U41.3Y U43.3A

# Later stages and unused gates.
net GND         U38.4A U38.4B U39.2J U39.2K U39.2CLK U39.2CLR_N

# Misses: the ball meeting a goal while moving into it. LOST_LEFT and LOST_RIGHT are set with the
# turn (same edge as HDIR), cleared by SERVE_END; while serving the ball is hidden from the
# picture and does not move sideways.
net BALL_N      U43.1A U43.2A U38.3A
net LEFT_N      U43.1B
net RIGHT_N     U43.2B
net HDIR        U43.1C
net HDIR_N      U26.1Q_N U43.2C
net MISS_LEFT   U43.1Y U44.1J
net MISS_RIGHT  U43.2Y U44.2J
net CLK         U44.1CLK U44.2CLK
net SERVE_END   U46.QD U44.1K U44.2K
net LOST_LEFT   U44.1Q U47.3A
net LOST_RIGHT  U44.2Q U47.3B
net SERVING_N   U47.3Y U41.4A U40.1CLR_N U40.2CLR_N U46.R01 U46.R02
net SERVING     U41.4Y U38.3B U43.3B
net BALLV_N     U38.3Y U16.A

# Serve timer: FRAME1 falls every 4 frames; SERVE_END rises after 8 of them.
net VCC         U45.1J U45.1K U45.1CLR_N
net FRAME0      U45.1CLK
net FRAME1      U45.1Q U46.CKA
net ST0         U46.QA U46.CKB
net ST1         U46.QB
net ST2         U46.QC
net GND         U45.2J U45.2K U45.2CLK U45.2CLR_N

# Scores: the left player scores when the ball is lost on the right, and the other way round.
# TENS is set when the units go from 9 to 0. Start clears them.
net LOST_RIGHT_N U44.2Q_N U48.CKA
net LOST_LEFT_N U44.1Q_N U49.CKA
net SL0         U48.QA U48.CKB
net SL1         U48.QB
net SL2         U48.QC
net SL3         U48.QD U50.1CLK
net SR0         U49.QA U49.CKB
net SR1         U49.QB
net SR2         U49.QC
net SR3         U49.QD U50.2CLK
net GND         U48.R91 U48.R92 U49.R91 U49.R92
net START       U41.5Y U48.R01 U48.R02 U49.R01 U49.R02
net VCC         U50.1J U50.2J
net GND         U50.1K U50.2K
net TENS_L      U50.1Q
net TENS_R      U50.2Q
net START_N     SW1.1 R1.2 U41.5A U50.1CLR_N U50.2CLR_N
net GND         SW1.2
net VCC         R1.1

# PLAY (stage 6).
net VCC         U44.1CLR_N U44.2CLR_N

# Score digits on lines 32-63, each cell 4 dots x 32 lines: left tens at dots 16-19, units 24-27,
# right tens 64-67, units 72-75 (H5 and H2 low, H4 != H6; H3 low: tens, high: units). U52 picks
# this half's units count into U53; U54 picks the strokes of the cell's top or bottom half (V4);
# five NAND terms draw a and g (rows 0, 3), d (row 7), f/e (column 0), b/c (column 3) and the
# tens "1" (column 3 of the tens cell).
net H6          U52.S
net GND         U52.G_N U54.G_N U54.4B
net SL0         U52.1A
net SR0         U52.1B
net SL1         U52.2A
net SR1         U52.2B
net SL2         U52.3A
net SR2         U52.3B
net SL3         U52.4A
net SR3         U52.4B
net SC0         U52.1Y U53.A
net SC1         U52.2Y U53.B
net SC2         U52.3Y U53.C
net SC3         U52.4Y U53.D
net VCC         U53.LT_N U53.RBI_N U53.BI_N
net SEG_A       U53.SA U54.4A
net SEG_B       U53.SB U54.2A
net SEG_C       U53.SC U54.2B
net SEG_D       U53.SD U54.3B
net SEG_E       U53.SE U54.1B
net SEG_F       U53.SF U54.1A
net SEG_G       U53.SG U54.3A
net V4          U54.S
net FE          U54.1Y U57.1B
net BC          U54.2Y U55.2B
net GD          U54.3Y U55.1B
net A_TOP       U54.4Y U56.1B
net TENS_L      U31.4A
net TENS_R      U31.4B
net TENS        U31.4Y U56.2B
net V3          U3.QD U25.1B U55.1C
net V2          U25.1A U55.1D
net V23_LOW     U25.1Y U56.1C
# H0 and H1 only within REGION (QH0_N, QH1_N, COL3), and UNITS (the units cell), keep the terms
# quiet outside the digits.
net H0          U14.4A
net H1          U57.2A
net REGION      U14.4B U57.2B
net VCC         U57.2C U57.2D
net QH0_N       U14.4Y U47.1A U57.1C
net QH1_N       U57.2Y U47.1B U57.1D
net COL3        U47.1Y U55.2C U56.2A
net VCC         U55.2D U56.1D
net H3          U42.4A U42.4B
net H3_N        U42.4Y U25.2B U56.2C
net REGION_N    U25.2A
net UNITS       U25.2Y U55.1A U55.2A U56.1A U57.1A
net VCC         U56.2D
net T1_N        U56.1Y U58.A
net T2_N        U55.1Y U58.B
net T3_N        U57.1Y U58.C
net T4_N        U55.2Y U58.D
net T5_N        U56.2Y U58.E
net VCC         U58.F U58.G U58.H
net GLYPH       U58.Y U42.3A
net H2          U17.3A
net H5          U17.3B
net V6          U17.3C
net SCORE_A     U17.3Y U34.2C
net H4          U10.4A
net H6          U10.4B
net HX          U10.4Y U34.2D
net V5          U34.2A
net TOP_B       U34.2B
net REGION_N    U34.2Y U41.6A
net REGION      U41.6Y U42.3B
net SCORE_N     U42.3Y U16.F

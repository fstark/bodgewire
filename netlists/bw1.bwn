# Machine 120, BW-1 (docs/machines/120-bw1/BW1.md): a 6502 single-board computer on the KIM-1's
# own design (KIM-1 User Manual, Figs. 3.2-3.5 and 3.13, its reference designators where it has
# them). U4 decodes A10-A12 into 1K blocks, A13-A15 not decoded: K0 the RAM of eight 6102s (U5-U12,
# DOUT through the 74125s U13, U14), K5 both 6530s' RAM and ports, K6 the 003's ROM (U3, the
# self-test), K7 the 002's (U2, the monitor). The 002's PB1-PB4 drive U24, a 74145: outputs 0-2
# the keypad's rows, 4-9 the six digits' common cathodes; its PA0-PA6 light the segments through
# U17 and read the keypad's columns. ST and RS pull NMI_N and RES_N low; SST on joins NMI_N to
# SST_N, low on an opcode fetch outside the 002's ROM. U24 output 3 (pad 4) is the self-test
# strap: a wire from it to PA0 makes reset run the self-test.

part X1  OSC freq=1MHz
part J1  POWER
part U1  6502
part U2  6530 mask=002 contents=../roms/bw1_002.rom  # monitor; display and keypad
part U3  6530 mask=003 contents=../roms/bw1_003.rom  # self-test; ports unconnected
part U4  74145       # K0-K7
part U5  6102        # D7
part U6  6102        # D6
part U7  6102        # D5
part U8  6102        # D4
part U9  6102        # D3
part U10 6102        # D2
part U11 6102        # D1
part U12 6102        # D0
part U13 74125       # D3-D0 onto the bus
part U14 74125       # D7-D4 onto the bus
part U15 74LS00      # RAM_RW, BUF_N, SST_N
part U16 74LS04      # RW_N, K0_N
part U17 74LS244     # segment driver
part U24 74145       # digits and keypad rows
part U25 POR time=20ms
part DS1 DIGITCC    # leftmost
part DS2 DIGITCC
part DS3 DIGITCC
part DS4 DIGITCC
part DS5 DIGITCC
part DS6 DIGITCC
part SW1  KEY legend=0
part SW2  KEY legend=1
part SW3  KEY legend=2
part SW4  KEY legend=3
part SW5  KEY legend=4
part SW6  KEY legend=5
part SW7  KEY legend=6
part SW8  KEY legend=7
part SW9  KEY legend=8
part SW10 KEY legend=9
part SW11 KEY legend=A
part SW12 KEY legend=B
part SW13 KEY legend=C
part SW14 KEY legend=D
part SW15 KEY legend=E
part SW16 KEY legend=F
part SW17 KEY legend=AD pc=/
part SW18 KEY legend=DA pc=*
part SW19 KEY legend=+
part SW20 KEY legend=GO pc=Enter
part SW21 KEY legend=PC pc=P
part SW22 KEY legend=ST pc=Escape
part SW23 KEY legend=RS pc=Backspace
part SW24 SLIDE legend=SST
part R1  R value=3k3 # K0
part R2  R value=3k3 # K5
part R3  R value=3k3 # K6
part R4  R value=3k3 # K7
part R5  R value=3k3 # RES_N
part R6  R value=3k3 # NMI_N
part R7  R value=3k3 # IRQ_N

# Clock, reset, interrupts: RS (SW23) and the power-on reset on RES_N, ST (SW22) on NMI_N.
net PHI0     X1.OUT U1.PHI0
net PHI2     U1.PHI2 U2.PHI2 U3.PHI2 U15.1B
net VCC      U1.RDY U1.SO
net RES_N    U1.RES_N U2.RES_N U3.RES_N U25.RST_N R5.2 SW23.1
net NMI_N    U1.NMI_N R6.2 SW22.1 SW24.2
net IRQ_N    U1.IRQ_N R7.2
net GND      SW22.2 SW23.2
net VCC      R1.1 R2.1 R3.1 R4.1 R5.1 R6.1 R7.1

# Single step: SST_N low on an opcode fetch (SYNC) outside the 002's ROM (K7 high); SW24 on joins
# it to NMI_N.
net SYNC     U1.SYNC U15.3A
net SST_N    U15.3Y SW24.1

# Address bus: A0-A9 to the RAMs and both 6530s, A10-A12 to the decoder; A13-A15 not decoded.
net A0       U1.A0 U2.A0 U3.A0 U5.A0 U6.A0 U7.A0 U8.A0 U9.A0 U10.A0 U11.A0 U12.A0
net A1       U1.A1 U2.A1 U3.A1 U5.A1 U6.A1 U7.A1 U8.A1 U9.A1 U10.A1 U11.A1 U12.A1
net A2       U1.A2 U2.A2 U3.A2 U5.A2 U6.A2 U7.A2 U8.A2 U9.A2 U10.A2 U11.A2 U12.A2
net A3       U1.A3 U2.A3 U3.A3 U5.A3 U6.A3 U7.A3 U8.A3 U9.A3 U10.A3 U11.A3 U12.A3
net A4       U1.A4 U2.A4 U3.A4 U5.A4 U6.A4 U7.A4 U8.A4 U9.A4 U10.A4 U11.A4 U12.A4
net A5       U1.A5 U2.A5 U3.A5 U5.A5 U6.A5 U7.A5 U8.A5 U9.A5 U10.A5 U11.A5 U12.A5
net A6       U1.A6 U2.A6 U3.A6 U5.A6 U6.A6 U7.A6 U8.A6 U9.A6 U10.A6 U11.A6 U12.A6
net A7       U1.A7 U2.A7 U3.A7 U5.A7 U6.A7 U7.A7 U8.A7 U9.A7 U10.A7 U11.A7 U12.A7
net A8       U1.A8 U2.A8 U3.A8 U5.A8 U6.A8 U7.A8 U8.A8 U9.A8 U10.A8 U11.A8 U12.A8
net A9       U1.A9 U2.A9 U3.A9 U5.A9 U6.A9 U7.A9 U8.A9 U9.A9 U10.A9 U11.A9 U12.A9
net A10      U1.A10 U4.A
net A11      U1.A11 U4.B
net A12      U1.A12 U4.C
net GND      U4.D

# Decoding: K0 the 6102s, K5 both 6530s' RAM and ports (CS1), K6 the 003's ROM, K7 the 002's (RS0).
net K0       U4.Y0_N R1.2 U16.2A U5.CE_N U6.CE_N U7.CE_N U8.CE_N U9.CE_N U10.CE_N U11.CE_N U12.CE_N
net K5       U4.Y5_N R2.2 U2.CS1 U3.CS1
net K6       U4.Y6_N R3.2 U3.RS0
net K7       U4.Y7_N R4.2 U2.RS0 U15.3B

# Read and write: RAM_RW low while PHI2 is high in a write; BUF_N low while reading the 6102s.
net RW       U1.RW U2.RW U3.RW U16.1A U15.2A
net RW_N     U16.1Y U15.1A
net K0_N     U16.2Y U15.2B
net RAM_RW   U15.1Y U5.RW U6.RW U7.RW U8.RW U9.RW U10.RW U11.RW U12.RW
net BUF_N    U15.2Y U13.1OE_N U13.2OE_N U13.3OE_N U13.4OE_N U14.1OE_N U14.2OE_N U14.3OE_N U14.4OE_N
net VCC      U15.4A U15.4B
net GND      U16.3A U16.4A U16.5A U16.6A

# Data bus: DIN straight on it, DOUT through the 74125s (KIM Fig. 3.4), both 6530s.
net D0       U1.D0 U2.D0 U3.D0 U12.DIN U13.1Y
net D1       U1.D1 U2.D1 U3.D1 U11.DIN U13.2Y
net D2       U1.D2 U2.D2 U3.D2 U10.DIN U13.4Y
net D3       U1.D3 U2.D3 U3.D3 U9.DIN U13.3Y
net D4       U1.D4 U2.D4 U3.D4 U8.DIN U14.1Y
net D5       U1.D5 U2.D5 U3.D5 U7.DIN U14.2Y
net D6       U1.D6 U2.D6 U3.D6 U6.DIN U14.4Y
net D7       U1.D7 U2.D7 U3.D7 U5.DIN U14.3Y
net DOUT0    U12.DOUT U13.1A
net DOUT1    U11.DOUT U13.2A
net DOUT2    U10.DOUT U13.4A
net DOUT3    U9.DOUT U13.3A
net DOUT4    U8.DOUT U14.1A
net DOUT5    U7.DOUT U14.2A
net DOUT6    U6.DOUT U14.4A
net DOUT7    U5.DOUT U14.3A

# Display: U24 outputs 4-9 sink the digits' common cathodes, DS1 on the left; PA0-PA6 light the
# segments through U17, on every digit.
net PB1      U2.PB1 U24.A
net PB2      U2.PB2 U24.B
net PB3      U2.PB3 U24.C
net PB4      U2.PB4 U24.D
net STRAP    U24.Y3_N  # the self-test strap: a wire to PA0
net DIG1     U24.Y4_N DS1.CC1 DS1.CC2
net DIG2     U24.Y5_N DS2.CC1 DS2.CC2
net DIG3     U24.Y6_N DS3.CC1 DS3.CC2
net DIG4     U24.Y7_N DS4.CC1 DS4.CC2
net DIG5     U24.Y8_N DS5.CC1 DS5.CC2
net DIG6     U24.Y9_N DS6.CC1 DS6.CC2
net PA0      U2.PA0 U17.1A1 SW7.2 SW14.2 SW21.2
net PA1      U2.PA1 U17.1A2 SW6.2 SW13.2 SW20.2
net PA2      U2.PA2 U17.1A3 SW5.2 SW12.2 SW19.2
net PA3      U2.PA3 U17.1A4 SW4.2 SW11.2 SW18.2
net PA4      U2.PA4 U17.2A1 SW3.2 SW10.2 SW17.2
net PA5      U2.PA5 U17.2A2 SW2.2 SW9.2 SW16.2
net PA6      U2.PA6 U17.2A3 SW1.2 SW8.2 SW15.2
net SEG_A    U17.1Y1 DS1.A DS2.A DS3.A DS4.A DS5.A DS6.A
net SEG_B    U17.1Y2 DS1.B DS2.B DS3.B DS4.B DS5.B DS6.B
net SEG_C    U17.1Y3 DS1.C DS2.C DS3.C DS4.C DS5.C DS6.C
net SEG_D    U17.1Y4 DS1.D DS2.D DS3.D DS4.D DS5.D DS6.D
net SEG_E    U17.2Y1 DS1.E DS2.E DS3.E DS4.E DS5.E DS6.E
net SEG_F    U17.2Y2 DS1.F DS2.F DS3.F DS4.F DS5.F DS6.F
net SEG_G    U17.2Y3 DS1.G DS2.G DS3.G DS4.G DS5.G DS6.G
net GND      U17.1OE_N U17.2OE_N U17.2A4

# Keypad: key SWn has the code n-1 (GETKEY); it joins row (n-1)/7, an output of U24, to column
# PA(6 - (n-1)%7), pulled up inside U2.
net ROW0     U24.Y0_N SW1.1 SW2.1 SW3.1 SW4.1 SW5.1 SW6.1 SW7.1
net ROW1     U24.Y1_N SW8.1 SW9.1 SW10.1 SW11.1 SW12.1 SW13.1 SW14.1
net ROW2     U24.Y2_N SW15.1 SW16.1 SW17.1 SW18.1 SW19.1 SW20.1 SW21.1

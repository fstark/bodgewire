# PET 2001 main logic, sheet 1 of 3 (drawing 320130, board 320137): CPU, address and data
# buffers, decoding, PIA1, PIA2, VIA, IEEE-488, user port, cassette, keyboard connector, reset.
# Transcribed from hp-1.png (300 dpi); see sheet1_notes.md for every pin, the uncertain
# readings and the off-sheet signals. Power pins are not drawn on the sheet: they go on the
# VCC/GND rails here. Parts marked ?TYPE have no datasheet (not simulated); their pins are
# REF.<number> and the netlist will not load until they are replaced or removed.
#
# Departures from the drawing (decided by the user): the LM555 reset UDE9 is our POR, which
# drives RES_N directly (the 555 drove it through inverter D9 1->2, now unused); RPOR is its
# pull-up, not on the schematic. Resistors are R parts only where they pull a logic line up;
# the IEEE terminations' pull-downs (R11, R47), LED series resistor R9, the 555's RC parts and
# the cassette motor transistor circuits are in the notes only.

# ---------------------------------------------------------------------------- parts
part UF3  6502                       # CPU
part UE5  74LS04                     # A11 -> BA11_N -> BA11; buffer direction; SEL8 (gates 5, 6 not on this sheet)
part UE4  7417                       # A6-A10 -> BA6-BA10; RES_N -> IFC_N
part UE3  7417                       # A1-A5 -> BA1-BA5; BLANK_TV -> EOI_N
part UE2  74LS08                     # gates 3, 4 here (BA0, VIA CS1); gates 1, 2 on sheet 3
part UG2  74LS154                    # SEL0_N-SELF_N, 4 KB blocks
part UG4  74LS21                     # RW_E_N, BD_TO_D
part UG3  74LS00                     # gates 3, 4 here (BPHI2); gates 1, 2 not on this sheet
part UG5  74LS244                    # D0-D3 <-> BD0-BD3
part UG6  74LS244                    # D4-D7 <-> BD4-BD7
part UB8  6520                       # PIA2 $E820: IEEE data, ATN in, NDAC out, SRQ in, DAV out
part UA5  6522                       # VIA $E840: user port, IEEE/cassette control
part UG8  6520                       # PIA1 $E810: keyboard, cassette sense, EOI, DIAG, retrace
part UG9  74LS145                    # keyboard rows
part UE9  74LS20                     # gate 2 here: DIAG LED; gate 1 not on this sheet
part UD9  74LS04                     # gates 1 (was the 555's inverter) and 6 here
part UDE9 POR time=1ms               # replaces the LM555 (real hold ~1.1 s: R15 1M x C5 1uF)
part UA7  ?MC3446                    # IEEE transceiver DIO1-DIO4
part UA8  ?MC3446                    # IEEE transceiver DIO5-DIO8
part UA9  ?MC3446                    # IEEE transceiver DAV NRFD NDAC ATN
part DS1  LED                        # diagnostic LED (series R9 470 ohm not modelled)
part J1   ?IEEE488                   # IEEE-488 edge connector (24 pins: 1-12, A-N)
part J2   ?USERPORT                  # parallel user port (24 pins: 1-12, A-N)
part J3   ?CASSETTE                  # cassette #2 (pins A-1 .. F-6 as 1-6)
part J4   ?EXPANSION                 # memory expansion (40 pins; 13-15, 26, 31, 32 not drawn)
part J5   ?KEYBOARD                  # keyboard (1-10 rows, A-J columns)
part J6   ?CASSETTE                  # cassette #1 (pins A1 .. F6 as 1-6)
part R13  R value=1k                 # NMI_N pull-up
part R14  R value=1k                 # RDY pull-up
part R17  R value=3k3                # IRQ_N pull-up
part R26  R value=1k                 # PU_R26: spare-input high for G3, G4
part R28  R value=1k                 # BA0
part R29  R value=1k                 # BA1
part R30  R value=1k                 # BA2
part R31  R value=1k                 # BA3
part R32  R value=1k                 # BA4
part R33  R value=1k                 # BA5
part R34  R value=1k                 # BA6
part R35  R value=1k                 # BA7
part R36  R value=1k                 # BA8
part R37  R value=1k                 # BA9
part R38  R value=1k                 # BA10
part R10  R value=2k4                # IFC_N pull-up (R11 5.1k to GND not modelled)
part R48  R value=2k4                # EOI_N pull-up (R47 5.1k to GND not modelled)
part R18  R value=10k                # KIN0 (R18-R25 drawn as one; order assumed)
part R19  R value=10k                # KIN1
part R20  R value=10k                # KIN2
part R21  R value=10k                # KIN3
part R22  R value=10k                # KIN4
part R23  R value=10k                # KIN5
part R24  R value=10k                # KIN6
part R25  R value=10k                # KIN7
part RPOR R value=3k3                # not on the schematic: POR's pull-up on RES_N

# ---------------------------------------------------------------------------- power
net VCC  UF3.VCC UE5.VCC UE4.VCC UE3.VCC UE2.VCC UG2.VCC UG4.VCC UG3.VCC UG5.VCC UG6.VCC UB8.VCC UA5.VCC UG8.VCC UG9.VCC UE9.VCC UD9.VCC UDE9.VCC UA7.16 UA8.16 UA9.16
net GND  UF3.GND UF3.GND2 UE5.GND UE4.GND UE3.GND UE2.GND UG2.GND UG4.GND UG3.GND UG5.GND UG6.GND UB8.GND UA5.GND UG8.GND UG9.GND UE9.GND UD9.GND UDE9.GND UA7.8 UA8.8 UA9.8
net VCC  R13.1 R14.1 R17.1 R26.1 R28.1 R29.1 R30.1 R31.1 R32.1 R33.1 R34.1 R35.1 R36.1 R37.1 R38.1 R10.1 R48.1 R18.1 R19.1 R20.1 R21.1 R22.1 R23.1 R24.1 R25.1 RPOR.1
net VCC  UF3.SO DS1.A J3.2 J6.2      # SO not drawn (tied high here); J3/J6 B: +5V
net GND  UG2.G1_N UG2.G2_N UA7.4 UA7.12 UA8.4 UA8.12 UA9.4 UA9.12 UD9.1A
net GND  J1.E J1.F J1.H J1.J J1.K J1.L J1.M J1.N J2.1 J2.11 J2.12 J2.A J2.N J3.1 J6.1
net CHASSIS J1.12                    # chassis ground symbol

# ---------------------------------------------------------------------------- clock, reset, interrupts
net PHI0     UF3.PHI0                # in from sheet 3 (arrow "00")
net PHI2     UF3.PHI2 UB8.PHI2 UA5.PHI2 UG8.PHI2 UG3.4B
net G3_11    UG3.4Y UG3.3B
net BPHI2    UG3.3Y J4.29            # "B02": off-sheet arrow; PHI2 through two NANDs
net PU_R26   R26.2 UG3.3A UG3.4A UG4.1C UG4.1D
net RES_N    UDE9.RST_N RPOR.2 UF3.RES_N UB8.RES_N UA5.RES_N UG8.RES_N UE4.6A J4.27
net IRQ_N    R17.2 UF3.IRQ_N UB8.IRQA_N UB8.IRQB_N UA5.IRQ_N UG8.IRQA_N UG8.IRQB_N J4.28
net NMI_N    R13.2 UF3.NMI_N UE2.4B  # NMI pull-up doubles as the high for E2's spare input
net RDY      R14.2 UF3.RDY
net RW       UF3.RW UB8.RW UA5.RW UG8.RW UG4.1B

# ---------------------------------------------------------------------------- address buffers
net A0       UF3.A0 UE2.4A
net A1       UF3.A1 UE3.2A
net A2       UF3.A2 UE3.3A
net A3       UF3.A3 UE3.4A
net A4       UF3.A4 UE3.5A
net A5       UF3.A5 UE3.6A
net A6       UF3.A6 UE4.1A
net A7       UF3.A7 UE4.2A
net A8       UF3.A8 UE4.3A
net A9       UF3.A9 UE4.4A
net A10      UF3.A10 UE4.5A
net A11      UF3.A11 UE5.1A
net A12      UF3.A12 UG2.A
net A13      UF3.A13 UG2.B
net A14      UF3.A14 UG2.C
net A15      UF3.A15 UG2.D
net BA0      UE2.4Y R28.2 UB8.RS0 UA5.RS0 UG8.RS0 J4.1
net BA1      UE3.2Y R29.2 UB8.RS1 UA5.RS1 UG8.RS1 J4.2
net BA2      UE3.3Y R30.2 UA5.RS2 J4.3
net BA3      UE3.4Y R31.2 UA5.RS3 J4.4
net BA4      UE3.5Y R32.2 UG8.CS1 J4.5
net BA5      UE3.6Y R33.2 UB8.CS1 J4.6
net BA6      UE4.1Y R34.2 UE2.3B J4.7
net BA7      UE4.2Y R35.2 J4.8
net BA8      UE4.3Y R36.2 J4.9
net BA9      UE4.4Y R37.2 J4.10
net BA10     UE4.5Y R38.2 J4.11
net BA11_N   UE5.1Y UE5.2A           # off-sheet arrow "BA11" overlined
net BA11     UE5.2Y UE2.3A UB8.CS0 UG8.CS0 J4.12

# ---------------------------------------------------------------------------- decoding
net SEL0_N   UG2.Y0_N                # off-sheet arrow
net SEL1_N   UG2.Y1_N J4.16          # also off-sheet arrow
net SEL2_N   UG2.Y2_N J4.17
net SEL3_N   UG2.Y3_N J4.18
net SEL4_N   UG2.Y4_N J4.19
net SEL5_N   UG2.Y5_N J4.20
net SEL6_N   UG2.Y6_N J4.21
net SEL7_N   UG2.Y7_N J4.22
net SEL8_N   UG2.Y8_N UE5.4A
net SEL8     UE5.4Y                  # off-sheet arrow (to the video RAM, sheet 3)
net SEL9_N   UG2.Y9_N J4.23
net SEL10_N  UG2.Y10_N J4.24         # $A000 ("SEL10" on J4)
net SEL11_N  UG2.Y11_N J4.25         # $B000 ("SEL11" on J4)
net SELC_N   UG2.Y12_N UG4.2B        # off-sheet arrow
net SELD_N   UG2.Y13_N UG4.2C        # off-sheet arrow
net SELE_N   UG2.Y14_N UG4.1A UB8.CS2_N UA5.CS2_N UG8.CS2_N   # off-sheet arrow
net SELF_N   UG2.Y15_N UG4.2D        # off-sheet arrow
net RW_E_N   UG4.1Y UG4.2A J4.30     # "R/W . E" (overline on E only): RW AND SELE_N; off-sheet arrow
net BD_TO_D  UG4.2Y UE5.3A UG5.1OE_N UG6.1OE_N   # high: read outside $C000-$FFFF, BD drives D
net BD_TO_D_N UE5.3Y UG5.2OE_N UG6.2OE_N
net VIA_CS1  UE2.3Y UA5.CS1          # BA6 AND BA11

# ---------------------------------------------------------------------------- data bus and buffers
# 1A->1Y (OE pin 1, BD_TO_D low): D -> BD.  2A->2Y (OE pin 19, BD_TO_D high): BD -> D.
net D0       UF3.D0 UB8.D0 UA5.D0 UG8.D0 UG5.1A1 UG5.2Y4
net D1       UF3.D1 UB8.D1 UA5.D1 UG8.D1 UG5.1A2 UG5.2Y3
net D2       UF3.D2 UB8.D2 UA5.D2 UG8.D2 UG5.1A3 UG5.2Y2
net D3       UF3.D3 UB8.D3 UA5.D3 UG8.D3 UG5.1A4 UG5.2Y1
net D4       UF3.D4 UB8.D4 UA5.D4 UG8.D4 UG6.1A1 UG6.2Y4
net D5       UF3.D5 UB8.D5 UA5.D5 UG8.D5 UG6.1A2 UG6.2Y3
net D6       UF3.D6 UB8.D6 UA5.D6 UG8.D6 UG6.1A3 UG6.2Y2
net D7       UF3.D7 UB8.D7 UA5.D7 UG8.D7 UG6.1A4 UG6.2Y1
net BD0      UG5.1Y1 UG5.2A4 J4.33
net BD1      UG5.1Y2 UG5.2A3 J4.34
net BD2      UG5.1Y3 UG5.2A2 J4.35
net BD3      UG5.1Y4 UG5.2A1 J4.36
net BD4      UG6.1Y1 UG6.2A4 J4.37
net BD5      UG6.1Y2 UG6.2A3 J4.38
net BD6      UG6.1Y3 UG6.2A2 J4.39
net BD7      UG6.1Y4 UG6.2A1 J4.40

# ---------------------------------------------------------------------------- PIA2 (UB8) and IEEE-488
# MC3446 channel: driver in -> bus, bus -> receiver out. A: 3->2->1, B: 5->6->7, C: 11->10->9, D: 13->14->15.
net DI1      UB8.PA0 UA7.1
net DI2      UB8.PA1 UA7.7
net DI3      UB8.PA2 UA7.9
net DI4      UB8.PA3 UA7.15
net DI5      UB8.PA4 UA8.1
net DI6      UB8.PA5 UA8.7
net DI7      UB8.PA6 UA8.9
net DI8      UB8.PA7 UA8.15
net DO1      UB8.PB0 UA7.3
net DO2      UB8.PB1 UA7.5
net DO3      UB8.PB2 UA7.11
net DO4      UB8.PB3 UA7.13
net DO5      UB8.PB4 UA8.3
net DO6      UB8.PB5 UA8.5
net DO7      UB8.PB6 UA8.11
net DO8      UB8.PB7 UA8.13
net DIO1     UA7.2 J1.1
net DIO2     UA7.6 J1.2
net DIO3     UA7.10 J1.3
net DIO4     UA7.14 J1.4
net DIO5     UA8.2 J1.A
net DIO6     UA8.6 J1.B
net DIO7     UA8.10 J1.C
net DIO8     UA8.14 J1.D
net ATN_IN_N    UB8.CA1 UA9.15
net NDAC_OUT_N  UB8.CA2 UA9.11
net SRQ_N       UB8.CB1 J1.10 J2.3   # "SRQ IN" at the PIA; no transceiver, no pull-up on this sheet
net DAV_OUT_N   UB8.CB2 UA9.3
net DAV_IN_N    UA5.PB7 UA9.1
net NRFD_IN_N   UA5.PB6 UA9.7
net NDAC_IN_N   UA5.PB0 UA9.9
net NRFD_OUT_N  UA5.PB1 UA9.5
net ATN_OUT_N   UA5.PB2 UA9.13
net DAV_N    UA9.2 J1.6
net NRFD_N   UA9.6 J1.7
net NDAC_N   UA9.10 J1.8
net ATN_N    UA9.14 J1.11
net IFC_N    UE4.6Y R10.2 J1.9       # RES_N through 7417; R11 5.1k to GND
net EOI_N    UE3.1Y R48.2 UG8.PA6 J1.5 J2.4   # "EOI IN" at PIA1 PA6; R47 5.1k to GND

# ---------------------------------------------------------------------------- VIA (UA5) and user port
net USR_CA1  UA5.CA1 J2.B            # "CA1"
net GRAPHIC  UA5.CA2                 # off-sheet arrow "GRAPHIC" (character set select)
net PA0      UA5.PA0 J2.C            # user port "PA0-PA7" ("C-L")
net PA1      UA5.PA1 J2.D
net PA2      UA5.PA2 J2.E
net PA3      UA5.PA3 J2.F
net PA4      UA5.PA4 J2.H
net PA5      UA5.PA5 J2.J
net PA6      UA5.PA6 J2.K
net PA7      UA5.PA7 J2.L
net CASS_WRITE   UA5.PB3 J2.7 J3.5 J6.5
net CASS2_MOTOR  UA5.PB4             # "#2 CASS MOTOR": R3 1k -> Q3 base (motor driver, notes)
net SYNC         UA5.PB5 UG8.CB1     # in from sheet 3 (arrow "SYNC")
net CASS2_READ   UA5.CB1 J2.8 J3.4   # "#2 CASS READ"
net USR_CB2      UA5.CB2 J2.M        # "CB2"

# ---------------------------------------------------------------------------- PIA1 (UG8), keyboard, cassette sense
net KEY_A    UG8.PA0 UG9.A UE9.2D
net KEY_B    UG8.PA1 UG9.B UE9.2C
net KEY_C    UG8.PA2 UG9.C UD9.6A
net KEY_D    UG8.PA3 UG9.D UE9.2B
net KEY_C_N  UD9.6Y UE9.2A
net DIAG_LED_N UE9.2Y DS1.K          # TP2-2; lit for row value 11 (PA3-PA0 = 1011)
net CASS1_SWITCH UG8.PA4 J6.6        # "#1 CASS SWITCH" (PA4 pull-up inside the 6520)
net CASS2_SWITCH UG8.PA5 J3.6        # "#2 CASS SWITCH" (PA5 pull-up inside the 6520)
net DIAG     UG8.PA7 J2.5            # "DIG JUMPER" at the PIA, "DIAG" on J2
net CASS1_READ   UG8.CA1 J2.6 J6.4   # "#1 CASS READ"
net BLANK_TV UG8.CA2 UE3.1A          # off-sheet arrow "BLANK TV", also EOI out (labelled EOI)
net CASS1_MOTOR  UG8.CB2             # "#1 CASS MOTOR": R5 1k -> Q6 base (motor driver, notes)
net KIN0     UG8.PB0 R18.2 J5.A
net KIN1     UG8.PB1 R19.2 J5.B
net KIN2     UG8.PB2 R20.2 J5.C
net KIN3     UG8.PB3 R21.2 J5.D
net KIN4     UG8.PB4 R22.2 J5.E
net KIN5     UG8.PB5 R23.2 J5.F
net KIN6     UG8.PB6 R24.2 J5.H
net KIN7     UG8.PB7 R25.2 J5.J
net ROW0     UG9.Y0_N J5.1           # rows: unlabelled on the sheet
net ROW1     UG9.Y1_N J5.2
net ROW2     UG9.Y2_N J5.3
net ROW3     UG9.Y3_N J5.4
net ROW4     UG9.Y4_N J5.5
net ROW5     UG9.Y5_N J5.6
net ROW6     UG9.Y6_N J5.7
net ROW7     UG9.Y7_N J5.8
net ROW8     UG9.Y8_N J5.9
net ROW9     UG9.Y9_N J5.10

# ---------------------------------------------------------------------------- connector pins from analog circuits / other sheets
net VIDEO        J2.2                # from sheet 3 by label
net HORZ         J2.9                # from sheet 3 by label ("HORZ", overline uncertain)
net VERT         J2.10               # from sheet 3 by label ("VERT", overline uncertain)
net CASS2_MOTOR_OUT J3.3             # Q1 (TIP29) emitter, "#2 CASS MOTOR"
net CASS1_MOTOR_OUT J6.3             # Q4 (TIP29) emitter, "#1 CASS MOTOR"

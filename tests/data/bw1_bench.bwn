# Bench for P5j (docs/p5j-bw1-chips/BW1_CHIPS_DESIGN.md §7), no Board: the KIM-1's processor,
# decoder, 6530-002 and 1K RAM wired as its User Manual's Figs. 3.2-3.4, reference designators
# included, with LS gates for the glue. U2 runs machines/120-bw1/roms/bw1_bench.asm: it tests the 6102s and its own
# RAM, shows $55 on PA0-PA6, then counts its timer's interrupts (PB7 on IRQ_N) on PB0-PB4 and
# copies PA7 (SW1, pulled up by the 6530 itself) to PB5. U4 decodes A10-A12 into 1K blocks (K0
# the RAM, K5 the 6530's RAM and ports, K7 its ROM); A13-A15 are not decoded (D on GND).

part X1  OSC freq=1MHz
part J1  POWER
part U1  6502
part U2  6530 mask=002 contents=../../machines/120-bw1/roms/bw1_bench.rom
part U4  74145       # K0-K7
part U5  6102        # D7
part U6  6102        # D6
part U7  6102        # D5
part U8  6102        # D4
part U9  6102        # D3
part U10 6102        # D2
part U11 6102        # D1
part U12 6102        # D0
part U13 74125       # D3-D0 onto the bus
part U14 74125       # D7-D4 onto the bus
part U15 74LS00      # RAM_RW, BUF_N
part U16 74LS04      # RW_N, K0_N
part U25 POR time=1ms
part SW1 BUTTON      # on PA7
part R1  R value=3k3 # K0
part R2  R value=3k3 # K5
part R3  R value=3k3 # K7
part R4  R value=3k3 # RES_N
part R5  R value=3k3 # NMI_N
part R6  R value=3k3 # IRQ_N

# Clock, reset, interrupts.
net PHI0     X1.OUT U1.PHI0
net PHI2     U1.PHI2 U2.PHI2 U15.1B
net VCC      U1.RDY U1.SO
net RES_N    U1.RES_N U2.RES_N U25.RST_N R4.2
net NMI_N    U1.NMI_N R5.2
net IRQ_N    U1.IRQ_N U2.PB7 R6.2
net VCC      R1.1 R2.1 R3.1 R4.1 R5.1 R6.1

# Address bus.
net A0       U1.A0 U2.A0 U5.A0 U6.A0 U7.A0 U8.A0 U9.A0 U10.A0 U11.A0 U12.A0
net A1       U1.A1 U2.A1 U5.A1 U6.A1 U7.A1 U8.A1 U9.A1 U10.A1 U11.A1 U12.A1
net A2       U1.A2 U2.A2 U5.A2 U6.A2 U7.A2 U8.A2 U9.A2 U10.A2 U11.A2 U12.A2
net A3       U1.A3 U2.A3 U5.A3 U6.A3 U7.A3 U8.A3 U9.A3 U10.A3 U11.A3 U12.A3
net A4       U1.A4 U2.A4 U5.A4 U6.A4 U7.A4 U8.A4 U9.A4 U10.A4 U11.A4 U12.A4
net A5       U1.A5 U2.A5 U5.A5 U6.A5 U7.A5 U8.A5 U9.A5 U10.A5 U11.A5 U12.A5
net A6       U1.A6 U2.A6 U5.A6 U6.A6 U7.A6 U8.A6 U9.A6 U10.A6 U11.A6 U12.A6
net A7       U1.A7 U2.A7 U5.A7 U6.A7 U7.A7 U8.A7 U9.A7 U10.A7 U11.A7 U12.A7
net A8       U1.A8 U2.A8 U5.A8 U6.A8 U7.A8 U8.A8 U9.A8 U10.A8 U11.A8 U12.A8
net A9       U1.A9 U2.A9 U5.A9 U6.A9 U7.A9 U8.A9 U9.A9 U10.A9 U11.A9 U12.A9
net A10      U1.A10 U4.A
net A11      U1.A11 U4.B
net A12      U1.A12 U4.C
net GND      U4.D

# Decoding: K0 the 6102s, K5 the 6530's RAM and ports (CS1), K7 its ROM (RS0).
net K0       U4.Y0_N R1.2 U16.2A U5.CE_N U6.CE_N U7.CE_N U8.CE_N U9.CE_N U10.CE_N U11.CE_N U12.CE_N
net K5       U4.Y5_N R2.2 U2.CS1
net K7       U4.Y7_N R3.2 U2.RS0

# Read and write: RAM_RW low while PHI2 is high in a write; BUF_N low while reading the 6102s.
net RW       U1.RW U2.RW U16.1A U15.2A
net RW_N     U16.1Y U15.1A
net K0_N     U16.2Y U15.2B
net RAM_RW   U15.1Y U5.RW U6.RW U7.RW U8.RW U9.RW U10.RW U11.RW U12.RW
net BUF_N    U15.2Y U13.1OE_N U13.2OE_N U13.3OE_N U13.4OE_N U14.1OE_N U14.2OE_N U14.3OE_N U14.4OE_N
net VCC      U15.3A U15.3B U15.4A U15.4B
net GND      U16.3A U16.4A U16.5A U16.6A

# Data bus: DIN straight on it, DOUT through the 74125s (Fig. 3.4).
net D0       U1.D0 U2.D0 U12.DIN U13.1Y
net D1       U1.D1 U2.D1 U11.DIN U13.2Y
net D2       U1.D2 U2.D2 U10.DIN U13.4Y
net D3       U1.D3 U2.D3 U9.DIN U13.3Y
net D4       U1.D4 U2.D4 U8.DIN U14.1Y
net D5       U1.D5 U2.D5 U7.DIN U14.2Y
net D6       U1.D6 U2.D6 U6.DIN U14.4Y
net D7       U1.D7 U2.D7 U5.DIN U14.3Y
net DOUT0    U12.DOUT U13.1A
net DOUT1    U11.DOUT U13.2A
net DOUT2    U10.DOUT U13.4A
net DOUT3    U9.DOUT U13.3A
net DOUT4    U8.DOUT U14.1A
net DOUT5    U7.DOUT U14.2A
net DOUT6    U6.DOUT U14.4A
net DOUT7    U5.DOUT U14.3A

# Ports: the result on PA0-PA6, the button on PA7, the count on PB0-PB4, the button's copy on PB5.
net PA0      U2.PA0
net PA1      U2.PA1
net PA2      U2.PA2
net PA3      U2.PA3
net PA4      U2.PA4
net PA5      U2.PA5
net PA6      U2.PA6
net PA7      U2.PA7 SW1.1
net GND      SW1.2
net PB0      U2.PB0
net PB1      U2.PB1
net PB2      U2.PB2
net PB3      U2.PB3
net PB4      U2.PB4
net PB5      U2.PB5

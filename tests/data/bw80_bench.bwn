# BW-80 chips bench (P5u, docs/p5u-bw80-chips/BW80_CHIPS_DESIGN.md §6): the ZX80's CPU, ROM, RAM
# and data bus at their reference designators (Grant Searle's redrawn ZX80 circuit, issue 2),
# running roms/bw80_bench.asm. The CPU side of the data bus is D0-D7, the memory side MD0-MD7
# (the schematic's D0'-D7'), joined by R4-R11 (1k): the RAM shows a character code on MD while
# the 74LS05s force a NOP onto D.
#
# Left out: the video (IC6-IC9, IC11's VSYNC latch, IC19-IC21: P5v), so the ROM's address comes
# straight from A0-A11, not through the 74LS157s. Bench only: IC17's fourth OR gives ROM_CS_N =
# A14 + MREQ_N (on the ZX80 that select comes through IC6). The NOP gates' order over IC14 and
# IC15 is the bench's (P5v takes the schematic's). The 2114s are the 300 ns grade: with 450 ns
# the forced NOP comes after the Z80 samples its fetch (design §6.1). The keys have no diodes.

part J1   POWER
part X1   OSC freq=6.5MHz
part RST1 POR time=1ms      # the ZX80's R21/C10
part IC1  Z80
part IC2  2332 select=LL contents=../../roms/bw80_bench.rom
part IC3  2114 access=300ns
part IC4  2114 access=300ns
part IC5  74LS373           # RAM data latch
part IC10 74LS365           # keyboard and cassette onto D
part IC12 74LS00            # RAM select
part IC13 74LS04            # MREQ, LE, CH6_N
part IC14 74LS05            # NOPs onto D0-D5
part IC15 74LS05            # NOP enable, NOPs onto D6 and D7, the CPU clock
part IC16 74LS10            # latch enable, NOP condition
part IC17 74LS32            # I/O decoding, NOP, ROM select
part IC18 74LS74            # 6.5 MHz / 2
part R1   R value=1k        # EAR pull-down
part R3   R value=1k        # NOP_EN pull-up
part R4   R value=1k
part R5   R value=1k
part R6   R value=1k
part R7   R value=1k
part R8   R value=1k
part R9   R value=1k
part R10  R value=1k
part R11  R value=1k
part R12  R value=1k        # NMI_N pull-up
part R13  R value=47k       # keyboard pull-ups
part R14  R value=47k
part R15  R value=47k
part R16  R value=47k
part R17  R value=47k
part R19  R value=2k2       # RAM select, isolated
part R20  R value=330       # CPU clock pull-up
part R21  R value=220k      # RESET_N pull-up
part R22  R value=1k        # BUSRQ_N pull-up
part R23  R value=1k        # WAIT_N pull-up
part R28  R value=47k       # MD6 pull-up: D6 reads high on a keyboard read (UK, no D11)
part K1   KEY legend=1
part K2   KEY legend=2

# Clock: 6.5 MHz halved; two open-collector inverters in parallel drive the CPU's clock.
net DOT       X1.OUT IC18.2CLK
net CLK_Q     IC18.2Q
net CLK_Q_N   IC18.2Q_N IC18.2D IC15.5A IC15.6A IC16.1B
net CLK       IC15.5Y IC15.6Y R20.2 IC1.CLK
net VCC       R20.1 IC18.2PRE_N IC18.2CLR_N IC18.1PRE_N IC18.1CLR_N
net GND       IC18.1D IC18.1CLK

# CPU: reset, unused requests pulled up, INT_N on A6 (the ZX80's; the program runs with DI).
net RESET_N   IC1.RESET_N RST1.RST_N R21.2
net NMI_N     IC1.NMI_N R12.2
net BUSRQ_N   IC1.BUSRQ_N R22.2
net WAIT_N    IC1.WAIT_N R23.2
net VCC       R21.1 R12.1 R22.1 R23.1

# Address bus.
net A0        IC1.A0 IC2.A0 IC3.A0 IC4.A0 IC17.4B
net A1        IC1.A1 IC2.A1 IC3.A1 IC4.A1
net A2        IC1.A2 IC2.A2 IC3.A2 IC4.A2
net A3        IC1.A3 IC2.A3 IC3.A3 IC4.A3
net A4        IC1.A4 IC2.A4 IC3.A4 IC4.A4
net A5        IC1.A5 IC2.A5 IC3.A5 IC4.A5
net A6        IC1.A6 IC2.A6 IC3.A6 IC4.A6 IC1.INT_N
net A7        IC1.A7 IC2.A7 IC3.A7 IC4.A7
net A8        IC1.A8 IC2.A8 IC3.A8 IC4.A8 K1.1
net A9        IC1.A9 IC2.A9 IC3.A9 IC4.A9 K2.1
net A10       IC1.A10 IC2.A10
net A11       IC1.A11 IC2.A11
net A12       IC1.A12 IC2.CS2
net A13       IC1.A13
net A14       IC1.A14 IC12.3B IC17.2A
net A15       IC1.A15 IC16.2B

# Control.
net M1_N      IC1.M1_N IC17.3B
net MREQ_N    IC1.MREQ_N IC13.1A IC17.2B
net MREQ      IC13.1Y IC12.3A IC16.1C
net IORQ_N    IC1.IORQ_N IC17.1B
net RD_N      IC1.RD_N IC17.1A
net WR_N      IC1.WR_N IC3.WE_N IC4.WE_N
net RFSH_N    IC1.RFSH_N IC16.1A
net HALT_N    IC1.HALT_N IC16.2C

# CPU-side data bus: the CPU, the NOP gates, the keyboard buffer.
net D0        IC1.D0 IC14.1Y IC10.Y3 R10.2
net D1        IC1.D1 IC14.2Y IC10.Y4 R11.2
net D2        IC1.D2 IC14.3Y IC10.Y5 R8.2
net D3        IC1.D3 IC14.4Y IC10.Y2 R5.2
net D4        IC1.D4 IC14.5Y IC10.Y6 R4.2
net D5        IC1.D5 IC14.6Y R6.2
net D6        IC1.D6 IC15.2Y R7.2
net D7        IC1.D7 IC15.3Y IC10.Y1 R9.2

# Memory-side data bus (D0'-D7'): ROM, RAM (the ZX80's bit order on the 2114s), the latch.
net MD0       IC2.O0 IC3.IO3 IC5.3D R10.1
net MD1       IC2.O1 IC3.IO2 IC5.6D R11.1
net MD2       IC2.O2 IC3.IO4 IC5.7D R8.1
net MD3       IC2.O3 IC4.IO2 IC5.8D R5.1
net MD4       IC2.O4 IC4.IO1 IC5.1D R4.1
net MD5       IC2.O5 IC4.IO3 IC5.2D R6.1
net MD6       IC2.O6 IC4.IO4 IC5.4D R7.1 R28.2
net MD7       IC2.O7 IC3.IO1 IC5.5D R9.1
net VCC       R28.1

# Memory selects: the ROM at A14 low (CS2 on A12), the RAM at A14 high through R19.
net ROM_CS_N  IC17.2Y IC2.CS1
net RAM_SEL_N IC12.3Y R19.1
net RAM_CS_N  R19.2 IC3.CS_N IC4.CS_N

# The data latch: transparent while RFSH_N, CLK low and MREQ_N low; holds through refresh.
net LE_N      IC16.1Y IC13.2A
net LE        IC13.2Y IC5.LE
net GND       IC5.OE_N
net CH0       IC5.3Q
net CH1       IC5.6Q
net CH2       IC5.7Q
net CH3       IC5.8Q
net CH4       IC5.1Q
net CH5       IC5.2Q
net CH6       IC5.4Q IC13.3A
net CH7       IC5.5Q
net CH6_N     IC13.3Y IC16.2A

# The NOP: an M1 fetch with A15 high, not halted, of a code with bit 6 clear.
net NOP_COND_N IC16.2Y IC17.3A
net NOP_N     IC17.3Y IC15.1A
net NOP_EN    IC15.1Y R3.2 IC14.1A IC14.2A IC14.3A IC14.4A IC14.5A IC14.6A IC15.2A IC15.3A
net VCC       R3.1

# Keyboard: an IN from an even port; the rows on A8 and A9 through K1 and K2.
net IORD_N    IC17.1Y IC17.4A
net KBD_N     IC17.4Y IC10.G1_N IC10.G2_N
net EAR       IC10.A1 R1.2
net GND       R1.1
net KB0       IC10.A3 R13.2 K1.2
net KB1       IC10.A4 R14.2 K2.2
net KB2       IC10.A5 R15.2
net KB3       IC10.A2 R16.2
net KB4       IC10.A6 R17.2
net VCC       R13.1 R14.1 R15.1 R16.1 R17.1

# Unused gate inputs.
net GND       IC12.1A IC12.1B IC12.2A IC12.2B IC12.4A IC12.4B
net GND       IC13.4A IC13.5A IC13.6A IC15.4A
net GND       IC16.3A IC16.3B IC16.3C
